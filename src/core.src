// core — the pure, side-effect-free helpers of bilan, factored out so they can be
// unit-tested (a test file needs its own main(), which can't coexist with main.src's).
// Composed BEFORE the other src modules in build.sh, and with test/core_test.src under
// `machin test`. Keep this module free of db/network/exit — only string/arg/format logic.

// Bumped per release; the released binary reports it via `bilan version`. Keep in
// lockstep with the git tag.
func version_str() (v) { v = "0.2.0" }

// esc — JSON-escape a string for hand-built JSON output (stdout is the agent contract).
func esc(s) (o) {
    o = replace(s, "\\", "\\\\")
    o = replace(o, "\"", "\\\"")
    o = replace(o, "\n", "\\n")
    o = replace(o, "\r", "\\r")
    o = replace(o, "\t", "\\t")
}

// flagv — the value after "--name" in args, or dflt if absent.
func flagv(a, name, dflt) (v) {
    v = dflt
    i := 0
    for i < len(a) {
        if a[i] == name {
            if i + 1 < len(a) { v = a[i+1] }
        }
        i = i + 1
    }
}

// has_flag — 1 if "--name" is present in args, else 0.
func has_flag(a, name) (b) {
    b = 0
    i := 0
    for i < len(a) {
        if a[i] == name { b = 1 }
        i = i + 1
    }
}

// parse_cents — money text -> integer cents. Money is ALWAYS stored as integer cents:
// float math on currency is how tax numbers silently drift, and MFL has no implicit
// int->float promotion to paper over it. Accepts "1234.56", "1 234,56" (fr CSVs),
// "-12", "+3.005" (rounds half up on the 3rd decimal), "12.", ".5". Junk characters
// are skipped in the integer part; an unparseable string yields 0 — callers validate
// with parse_cents_ok when bad input must be rejected, not treated as zero.
func parse_cents(s) (c) {
    c = 0
    t := trim(s)
    t = replace(t, " ", "")
    t = replace(t, ",", ".")
    neg := 0
    if substr(t, 0, 1) == "-" { neg = 1  t = substr(t, 1, len(t)) }
    if substr(t, 0, 1) == "+" { t = substr(t, 1, len(t)) }
    ip := t
    fp := ""
    dot := index(t, ".")
    if dot >= 0 { ip = substr(t, 0, dot)  fp = substr(t, dot+1, len(t)) }
    i := 0
    for i < len(ip) {
        ch := substr(ip, i, i+1)
        if ch >= "0" && ch <= "9" { c = c * 10 + parse_int(ch) }
        i = i + 1
    }
    // fraction: first two digits are cents; a third digit >= 5 rounds up (carry folds
    // into c*100 + f naturally: f==100 means +1 to the units).
    f := 0
    if len(fp) >= 1 { f = f * 10 + digit_or_zero(substr(fp, 0, 1)) }
    if len(fp) >= 2 { f = f * 10 + digit_or_zero(substr(fp, 1, 2)) }
    if len(fp) == 1 { f = f * 10 }
    if len(fp) >= 3 {
        if substr(fp, 2, 3) >= "5" { f = f + 1 }
    }
    c = c * 100 + f
    if neg == 1 { c = 0 - c }
}

// digit_or_zero — the digit value of a 1-char string, 0 if it isn't a digit.
func digit_or_zero(ch) (d) {
    d = 0
    if ch >= "0" && ch <= "9" { d = parse_int(ch) }
}

// parse_cents_ok — 1 if s contains at least one digit (i.e. parse_cents saw a number).
func parse_cents_ok(s) (ok) {
    ok = 0
    t := trim(s)
    i := 0
    for i < len(t) {
        ch := substr(t, i, i+1)
        if ch >= "0" && ch <= "9" { ok = 1  return ok }
        i = i + 1
    }
}

// fmt_cents — integer cents -> "1234.56" (never floats on stdout; the cent is the unit).
func fmt_cents(c) (s) {
    neg := 0
    if c < 0 { neg = 1  c = 0 - c }
    ip := c / 100
    fp := c - ip * 100
    t := str(ip) + "."
    if fp < 10 { t = t + "0" }
    t = t + str(fp)
    if neg == 1 { t = "-" + t }
    s = t
}

// date_ok — "YYYY-MM-DD" shape check (month 01-12, day 01-31; not a calendar oracle —
// SQLite rejects impossible dates at insert time via a CHECK-free convention: we validate
// shape here and let the year/month math in stats be the semantic guard).
func date_ok(s) (ok) {
    ok = 0
    if len(s) != 10 { return ok }
    if substr(s, 4, 5) != "-" || substr(s, 7, 8) != "-" { return ok }
    y := substr(s, 0, 4)
    m := substr(s, 5, 7)
    d := substr(s, 8, 10)
    if digit4(y) == 0 { return ok }
    mi := parse_int(m)
    di := parse_int(d)
    if mi < 1 || mi > 12 { return ok }
    if di < 1 || di > 31 { return ok }
    ok = 1
}

// ! is not MFL — helper spelled as a function (see chatsnip gotchas: no `!` negation).
func digit4(s) (b) {
    b = 1
    if len(s) != 4 { b = 0  return }
    i := 0
    for i < 4 {
        ch := substr(s, i, i+1)
        if ch < "0" || ch > "9" { b = 0  return }
        i = i + 1
    }
}

// year_of — the year of a "YYYY-MM-DD" date, as an int (0 if malformed).
func year_of(date) (y) {
    y = 0
    if len(date) < 4 { return y }
    y = parse_int(substr(date, 0, 4))
}

// pct_str — decipercent tenths -> "31.4" (no floats; the tenths integer is the truth).
func pct_str(tenths) (s) {
    s = str(tenths / 10) + "." + str(tenths - (tenths / 10) * 10)
}

// csv_split — one CSV line -> fields, handling double-quoted fields ("a,b" is one
// field; "" inside quotes is a literal quote). sep is the delimiter ("," or ";" —
// fr Excel exports use semicolons). Real broker exports quote everything; a naive
// split on the delimiter corrupts labels containing it.
func csv_split(line, sep) (out) {
    out = []string{}
    cur := ""
    inq := 0
    i := 0
    n := len(line)
    for i < n {
        ch := substr(line, i, i+1)
        if inq == 1 {
            if ch == "\"" {
                if i + 1 < n && substr(line, i+1, i+2) == "\"" { cur = cur + "\""  i = i + 1 }
                else { inq = 0 }
            } else { cur = cur + ch }
        } else {
            if ch == "\"" { inq = 1 }
            else if ch == sep { out = append(out, cur)  cur = "" }
            else { cur = cur + ch }
        }
        i = i + 1
    }
    out = append(out, cur)
}

// col_find — case-insensitive, BOM-proof column index: the first header cell that
// contains needle (lowercased), or -1. Matching by substring, not equality, because
// broker headers drift ("Close Date", "Close Date ", "Clôture") and Excel prepends a
// BOM to the first cell.
func col_find(headers, needle) (ix) {
    ix = -1
    i := 0
    for i < len(headers) {
        if contains(to_lower(headers[i]), needle) { ix = i  return ix }
        i = i + 1
    }
}
