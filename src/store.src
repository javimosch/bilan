// store — db location, schema, and the seeded tax-rule rows. The tax rates are DATA
// (comptoir's config-row pattern), not code: a loi de finances change is an UPDATE on
// tax_rules, never a recompile. Seeding uses INSERT OR IGNORE so a rate the operator
// set by hand is never overwritten by a re-open.

func dbpath() (p) {
    p = env("BILAN_DB")
    if p == "" { p = env("HOME") + "/.bilan.db" }
}

// open_db_at — schema + pragmas, shared by the CLI path and serve's per-request handles.
// One short-lived handle per operation + WAL + busy_timeout is the concurrency story
// (machweb is goroutine-per-connection; long-held handles are how you get SQLITE_BUSY).
func open_db_at(path) (db) {
    db = sqlite_open(path)
    sqlite_exec(db, "PRAGMA busy_timeout=5000", []string{})
    sqlite_exec(db, "PRAGMA journal_mode=WAL", []string{})
    sqlite_exec(db, "CREATE TABLE IF NOT EXISTS streams(id TEXT PRIMARY KEY, name TEXT UNIQUE, kind TEXT, currency TEXT DEFAULT 'EUR', created INTEGER)", []string{})
    sqlite_exec(db, "CREATE TABLE IF NOT EXISTS txs(id TEXT PRIMARY KEY, stream_id TEXT, date TEXT, cents INTEGER, label TEXT, source TEXT, ext_id TEXT, created INTEGER, UNIQUE(stream_id, ext_id))", []string{})
    sqlite_exec(db, "CREATE TABLE IF NOT EXISTS imports(id TEXT PRIMARY KEY, source TEXT, file TEXT, rows INTEGER, skipped INTEGER, ts INTEGER)", []string{})
    sqlite_exec(db, "CREATE TABLE IF NOT EXISTS tax_rules(year INTEGER, regime TEXT, param TEXT, value TEXT, PRIMARY KEY(year, regime, param))", []string{})
    // moves — Brian's proposals (Action + Pourquoi + Impact), one row each; the human
    // approves via the dashboard or `bilan move done`. Henry's "Moves" as data.
    sqlite_exec(db, "CREATE TABLE IF NOT EXISTS moves(id TEXT PRIMARY KEY, kind TEXT, action TEXT, pourquoi TEXT, impact TEXT, horizon TEXT DEFAULT 'today', status TEXT DEFAULT 'proposed', created INTEGER, closed INTEGER DEFAULT 0)", []string{})
    // telemetry — usage + errors only (hosted mode). NO financial data, NO stream
    // names, NO amounts. event = endpoint/command name, code = exit/HTTP status.
    sqlite_exec(db, "CREATE TABLE IF NOT EXISTS telemetry_events(event TEXT, ts INTEGER, tenant TEXT, code INTEGER, duration_ms INTEGER)", []string{})
    seed_rules(db)
}

func opendb() (db) { db = open_db_at(dbpath()) }

// seed_rules — the default rate card, in DECIPERCENT tenths (340 = 34.0%) so every
// computation stays integer math. Sources: the operator's own filing knowledge
// (micro-BNC 34% abattement, crypto PFU 31.4%, 305 EUR exemption threshold). Every
// value is overridable per year; a future year with no rows falls back to these.
func seed_rules(db) {
    y := str(current_year())
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'micro_bnc', 'deduction_pct_tenths', '340')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'micro_bnc', 'social_pct_tenths', '246')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'micro_bic_services', 'deduction_pct_tenths', '500')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'micro_bic_services', 'social_pct_tenths', '212')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'micro_foncier', 'deduction_pct_tenths', '300')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'micro_foncier', 'social_pct_tenths', '172')", []string{y})
    // Déficit foncier imputable on revenu global (art. 156 CGI I.3° — régime réel,
    // not micro). Cap 10,700 EUR/year; the excess + intérêts d'emprunt carry 10y on
    // revenus fonciers. Source: BOFiP BOI-RFPI-BASE-30-20-20250916.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'micro_foncier', 'deficit_global_cap_cents', '1070000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'capital', 'pfu_pct_tenths', '314')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'capital', 'crypto_exempt_threshold_cents', '30500')", []string{y})
    // IR progressive barème (2025 barème on 2024 income — loi de finances 2025, art. 2;
    // revalorisation +1.8% vs 2024 barème. Source: BOFiP BOI-IR-LIQ-20-20-30,
    // legifiscal.fr/bareme-impot-revenu). 5 brackets, each a threshold_cents + rate_tenths.
    // parts = quotient familial (default 1 part). Operator overrides per year.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'bracket_1_threshold_cents', '0')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'bracket_1_rate_tenths', '0')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'bracket_2_threshold_cents', '1149700')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'bracket_2_rate_tenths', '110')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'bracket_3_threshold_cents', '2931500')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'bracket_3_rate_tenths', '300')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'bracket_4_threshold_cents', '8382300')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'bracket_4_rate_tenths', '410')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'bracket_5_threshold_cents', '18029400')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'bracket_5_rate_tenths', '450')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'parts', '1')", []string{y})
    // Demi-parts for fractional quotient familial (couple + 1 child = 2.5 parts = 5
    // demi-parts). If set, takes precedence over `parts` (which stays integer 1/2).
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'demi_parts', '0')", []string{y})
    // Plafonnement du quotient familial (art. 197 CGI I.2 — 2024 income). The tax
    // advantage from each demi-part beyond the base (1 part célibataire / 2 couple)
    // is capped at 1,791 EUR. base_parts = 1 (célibataire) or 2 (couple); the
    // operator sets it. Source: BOFiP BOI-IR-LIQ-20-20-20-20250414.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'base_parts', '1')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'qf_cap_per_demi_part_cents', '179100')", []string{y})
    // Décote (2024 income — art. 197 CGI 4°I). Plafond 889 € (célibataire, 1 part) /
    // 1470 € (couple, imposition commune). Coefficient 45.25%. Décote = plafond -
    // 45.25% × IR; applies when IR < plafond/0.4525 (≈1965 € single / 3249 € couple).
    // Source: BOFiP BOI-IR-LIQ-20-20-30-20250414. Operator sets plafond for couple.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'decote_plafond_cents', '88900')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'decote_coefficient_milliemes', '4525')", []string{y})
    // 10% frais abattement on salary (2024 income — art. 83 CGI). 10% of gross, min
    // 509 € / max 14,555 € per member of the foyer. Source: impots.gouv.fr/particulier/
    // questions/comment-puis-je-beneficier-de-la-deduction-forfaitaire-de-10.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'salary', 'frais_abattement_pct_tenths', '100')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'salary', 'frais_abattement_min_cents', '50900')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'salary', 'frais_abattement_max_cents', '1455500')", []string{y})
    // TVA franchise en base (art. 293 B CGI — seuils 2024-2025). Two thresholds:
    // vente/fourniture de logement vs prestations de services. The radar checks
    // whether the year's BNC/BIC gross falls under the franchise threshold (N-1
    // value); the seuil majoré (N) is informational. Source: BOFiP BOI-TVA-DECLA-40-10-10.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'tva', 'franchise_vente_cents', '9190000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'tva', 'franchise_vente_majore_cents', '10100000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'tva', 'franchise_services_cents', '3680000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'tva', 'franchise_services_majore_cents', '3910000')", []string{y})
    // Prélèvement à la source — taux neutre mensuel 2024 (art. 204 H CGI, métropole).
    // Used to estimate the monthly prepayment when the taxpayer opts for the taux
    // neutre (confidentiality). The radar projects the annual IR / 12 and applies
    // the grid. Source: BOFiP BOI-BAREME-000037-20240228, loi de finances 2024.
    // Grid stored as bracket pairs: pas_threshold_N_cents + pas_rate_N_tenths.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_1_threshold_cents', '0')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_1_rate_tenths', '0')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_2_threshold_cents', '159100')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_2_rate_tenths', '5')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_3_threshold_cents', '165300')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_3_rate_tenths', '13')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_4_threshold_cents', '175900')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_4_rate_tenths', '21')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_5_threshold_cents', '187700')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_5_rate_tenths', '29')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_6_threshold_cents', '200600')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_6_rate_tenths', '35')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_7_threshold_cents', '211300')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_7_rate_tenths', '41')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_8_threshold_cents', '225300')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_8_rate_tenths', '53')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_9_threshold_cents', '266600')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_9_rate_tenths', '75')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_10_threshold_cents', '305200')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_10_rate_tenths', '99')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_11_threshold_cents', '347600')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_11_rate_tenths', '119')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_12_threshold_cents', '391300')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_12_rate_tenths', '138')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_13_threshold_cents', '456600')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_13_rate_tenths', '158')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_14_threshold_cents', '547500')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_14_rate_tenths', '179')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_15_threshold_cents', '685100')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pas', 'bracket_15_rate_tenths', '200')", []string{y})
    // Réductions d'impôt — dons (art. 200 CGI). 75% up to 1000 EUR (aide aux
    // personnes en difficulté, plafond dérogatoire 2024-2026), then 66% up to 20%
    // of revenu imposable. Source: BOFiP BOI-IR-RICI-250-30, impots.gouv.fr.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'dons', 'rate_75_pct_tenths', '750')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'dons', 'rate_75_cap_cents', '100000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'dons', 'rate_66_pct_tenths', '660')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'dons', 'rate_66_cap_revenu_pct_tenths', '200')", []string{y})
    // QF special caps — plafonnement par situation (art. 197 CGI). The default cap
    // is 1,791 EUR per demi-part (seeded above). Special situations have different
    // caps, selected by the 'situation' rule on ir_bareme:
    //   default                -> 1791 per demi-part (the common case)
    //   parent_isole           -> 4,262 EUR total cap on the parent-isolé majoration
    //                             (the whole-part for the 1st child, art. 197 IV CGI)
    //   veuf                   -> 1,807 EUR per demi-part + 2,011 EUR complementary
    //                             reduction for the first 2 demi-parts (art. 197 V CGI)
    //   personne_seule_invalide-> 3,608 EUR for the single demi-part (1,807 + 1,801
    //                             complementary, anciens combattants/invalides)
    // Source: service-public.gouv.fr F35120, F35127, F2702; BOFiP BOI-IR-LIQ-20-20-20.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'situation', 'default')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'qf_parent_isole_cap_cents', '426200')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'qf_veuf_cap_per_demi_part_cents', '180700')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'qf_veuf_complementary_cents', '201100')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_bareme', 'qf_personne_seule_invalide_cap_cents', '360800')", []string{y})
    // Crédit d'impôt emploi à domicile (art. 199 sexdecies CGI). 50% of dépenses,
    // plafond 12,000 EUR (+1,500 EUR per child/aged member, max 15,000 EUR). This is
    // a CRÉDIT (refundable if it exceeds IR), not a réduction. Record dépenses as
    // negative txs in an 'emploi_domicile' stream. Source: impots.gouv.fr/particulier/
    // emploi-domicile, BOFiP BOI-IR-RICI-150.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'emploi_domicile', 'rate_pct_tenths', '500')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'emploi_domicile', 'cap_cents', '1200000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'emploi_domicile', 'majoration_per_personne_cents', '150000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'emploi_domicile', 'cap_total_cents', '1500000')", []string{y})
    // Réduction d'impôt PINEL (art. 199 novovicies CGI). Dispositif ended 31/12/2024
    // but existing engagements continue. Rates by engagement duration: 12% (6y),
    // 18% (9y), 21% (12y) on the investment, capped at 300,000 EUR / 5,500 EUR per m².
    // The reduction is spread over the duration (2% per year for 6y, etc.). Record
    // the investment amount as a positive tx in a 'pinel' stream; the engagement
    // duration is set via 'pinel_engagement_years' rule (default 9). Source:
    // service-public.gouv.fr F31151, BOFiP BOI-IR-RICI-360.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pinel', 'rate_6y_pct_tenths', '120')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pinel', 'rate_9y_pct_tenths', '180')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pinel', 'rate_12y_pct_tenths', '210')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pinel', 'cap_investment_cents', '30000000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pinel', 'engagement_years', '9')", []string{y})
    // Réduction d'impôt DENORMANDIE (art. 199 novovicies IV bis CGI). Same rates as
    // PINEL (12% 6y / 18% 9y / 21% 12y), cap 300,000 EUR, but for ANCien with works
    // (≥25% of total cost). Open until 31/12/2027. Record the operation cost as a
    // positive tx in a 'denormandie' stream. Source: service-public.gouv.fr F35011,
    // BOFiP BOI-IR-RICI-360.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'denormandie', 'rate_6y_pct_tenths', '120')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'denormandie', 'rate_9y_pct_tenths', '180')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'denormandie', 'rate_12y_pct_tenths', '210')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'denormandie', 'cap_investment_cents', '30000000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'denormandie', 'engagement_years', '9')", []string{y})
    // Réduction d'impôt MALRAUX (art. 199 tervicies CGI). Restoration of immeubles in
    // sites patrimoniaux remarquables. Rate: 30% (PSMV approved) or 22% (PVAP approved).
    // Cap: 400,000 EUR of dépenses over 4 years. The reduction is NOT subject to the
    // plafonnement niches fiscales (10,000 EUR). Record dépenses as positive txs in a
    // 'malraux' stream; set the zone via 'malraux_zone' rule (psmv -> 30%, pvap -> 22%).
    // Source: BOFiP BOI-IR-RICI-200-30, service-public.gouv.fr.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'malraux', 'zone', 'psmv')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'malraux', 'rate_psmv_pct_tenths', '300')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'malraux', 'rate_pvap_pct_tenths', '220')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'malraux', 'cap_depenses_cents', '40000000')", []string{y})
    // Régime réel foncier (art. 29-31 CGI). When a 'foncier_reel' stream exists, the
    // radar computes net = loyer (positive txs) - charges (negative txs: intérêts
    // d'emprunt, travaux, assurances, taxe foncière) with NO 30% abattement. The
    // deficit (net negative) is imputed on global income up to 10,700 EUR (already
    // seeded) and excess carried 10y on foncier. Source: BOFiP BOI-RFPI-BASE-20-80.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'foncier_reel', 'social_pct_tenths', '172')", []string{y})
    // LMNP micro-BIC meublé (art. 50 CGI + art. 293 B). Location meublée non
    // professionnelle: micro-BIC with 50% abattement, threshold 77,700 EUR (2024
    // income / 2025 barème). Different from the 36,800 services threshold. LMNP is
    // excluded from TVA franchise for location meublée (it's a "prestation de
    // services" with the 36,800 threshold for TVA, but micro-BIC uses 77,700).
    // Source: BOFiP BOI-BIC-DECLA-10, service-public.gouv.fr.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'lmnp', 'deduction_pct_tenths', '500')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'lmnp', 'social_pct_tenths', '172')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'lmnp', 'micro_threshold_cents', '7770000')", []string{y})
    // LMNP régime réel (art. 39 CGI). net = loyer (positive txs) - charges (negative
    // txs: intérêts d'emprunt, taxe foncière, frais de gestion, amortissement) with
    // NO 50% abattement. The deficit carries forward 6y (like BNC/BIC, NOT 10y like
    // foncier). Source: BOFiP BOI-BIC-DECLA-10, BOI-BIC-BASE-10.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'lmnp_reel', 'social_pct_tenths', '172')", []string{y})
    // Réduction d'impôt CENSI-BOUVARD (art. 199 sexvicies CGI). 11% of investment,
    // capped at 300,000 EUR, spread over 9 years. For LMNP in résidences de services
    // (EHPAD, étudiants). Dispositif ended 31/12/2022 but existing engagements
    // continue. Record the investment as a positive tx in a 'censi_bouvard' stream.
    // Source: BOFiP BOI-IR-RICI-220-10, service-public.gouv.fr.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'censi_bouvard', 'rate_pct_tenths', '110')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'censi_bouvard', 'cap_investment_cents', '30000000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'censi_bouvard', 'engagement_years', '9')", []string{y})
    // TVA régime simplifié (art. 302 septies A CGI / L. 162-1 CIBS). Eligibility:
    // CA HT between franchise threshold and RSI threshold, AND TVA due < 15,000 EUR.
    // Seuils 2023-2025: services 254,000 / 287,000 (majoré), vente 840,000 / 925,000.
    // Source: BOFiP BOI-BAREME-000036, service-public.gouv.fr F23566.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'tva_rsi', 'threshold_services_cents', '25400000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'tva_rsi', 'threshold_services_majore_cents', '28700000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'tva_rsi', 'threshold_vente_cents', '84000000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'tva_rsi', 'threshold_vente_majore_cents', '92500000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'tva_rsi', 'tva_due_cap_cents', '1500000')", []string{y})
    // TVA taux (art. 278-278 bis CGI). Normal 20%, réduit 10%, super réduit 5.5%,
    // particulier 2.1%. Used to compute TVA collectée / déductible from HT amounts.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'tva', 'rate_normal_pct_tenths', '200')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'tva', 'rate_reduit_pct_tenths', '100')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'tva', 'rate_super_reduit_pct_tenths', '55')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'tva', 'rate_particulier_pct_tenths', '21')", []string{y})
    // Crédit d'impôt frais de garde d'enfants (art. 200 quater B CGI). 50% of
    // dépenses, capped at 3,500 EUR per child under 6 (1,750 in garde alternée).
    // Credit max 1,750 EUR per child (875 in alterné). REFUNDABLE (crédit, not
    // réduction). Record dépenses as positive txs in a 'frais_garde' stream.
    // Source: BOFiP BOI-IR-RICI-300, service-public.gouv.fr F8.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'frais_garde', 'rate_pct_tenths', '500')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'frais_garde', 'cap_per_child_cents', '350000')", []string{y})
    // Réduction d'impôt frais de scolarité (art. 199 quater F CGI). Forfaitaire:
    // 61 EUR collège, 153 EUR lycée, 183 EUR supérieur (per child, half in garde
    // alternée). RÉDUCTION (non-refundable). The user records the TOTAL forfaitaire
    // reduction as a positive tx in a 'scolarite' stream; the radar passes it
    // through. Source: BOFiP BOI-IR-RICI-150, service-public.gouv.fr F9.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'scolarite', 'college_cents', '6100')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'scolarite', 'lycee_cents', '15300')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'scolarite', 'superieur_cents', '18300')", []string{y})
    // Pension alimentaire (art. 156 II.2° CGI). Deductible from revenu global
    // (reduces IR base, not IR directly). Capped at 6,794 EUR per child for 2024
    // income (declaration 2025). Record the pension versée as a positive tx in a
    // 'pension_alimentaire' stream; the radar subtracts it (capped) from ir_base.
    // Source: BOFiP BOI-IR-BASE-20-30-10, impots.gouv.fr.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'pension_alimentaire', 'cap_per_child_cents', '679400')", []string{y})
    // Réduction d'impôt IR-PME / Madelin (art. 199 terdecies-0 A CGI). 18% of
    // versements au capital de PME, capped at 50,000 EUR single / 100,000 EUR
    // couple. 25% for ESUS (until 30/09/2026). Subject to plafonnement global des
    // avantages fiscaux (10,000 EUR). RÉDUCTION (non-refundable). Record versements
    // as positive txs in an 'ir_pme' stream. Source: BOFiP BOI-IR-RICI-290.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_pme', 'rate_pct_tenths', '180')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_pme', 'cap_single_cents', '5000000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'ir_pme', 'cap_couple_cents', '10000000')", []string{y})
    // Plafonnement global des avantages fiscaux (art. 200-0 A CGI). Caps the
    // TOTAL niche tax advantage at 10,000 EUR per year (18,000 EUR with SOFICA
    // or outre-mer). Applies to: pinel, denormandie, censi_bouvard, ir_pme,
    // fcpi_fip, forest, sofica, emploi_domicile, frais_garde. Does NOT apply to:
    // dons, scolarite, pension_alimentaire, PER (deductions or non-niche).
    // Source: BOFiP BOI-IR-LIQ-20-20-10, service-public.gouv.fr F31179.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'plafonnement_global', 'cap_cents', '1000000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'plafonnement_global', 'cap_sofica_cents', '1800000')", []string{y})
    // PER — plan épargne retraite (art. 163 quatervicies CGI). Deduction from
    // revenu global (reduces IR base). 10% of revenus professionnels N-1, capped
    // at 8x PASS (35,194 EUR for 2024 income) or 10% PASS minimum (4,399 EUR).
    // Simplified: cap at 35,194 EUR. Record versements as positive txs in a
    // 'per' stream. Source: BOFiP BOI-IR-BASE-20-50.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'per', 'cap_cents', '3519400')", []string{y})
    // FCPI/FIP (art. 199 terdecies-0 A VI CGI). 18% reduction, capped at 12,000
    // EUR single / 24,000 EUR couple. 25% for FIP Corse/Outre-Mer (until 2026).
    // Subject to plafonnement global. Record versements as positive txs in a
    // 'fcpi_fip' stream. Source: BOFiP BOI-IR-RICI-90.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'fcpi_fip', 'rate_pct_tenths', '180')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'fcpi_fip', 'cap_single_cents', '1200000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'fcpi_fip', 'cap_couple_cents', '2400000')", []string{y})
    // SOFICA (art. 199 quater E CGI). 30% or 36% reduction, capped at 18,000 EUR
    // OR 25% of revenu net global (whichever is lower). Subject to plafonnement
    // global with 18,000 EUR cap (not 10,000). Record versements as positive txs
    // in a 'sofica' stream. Source: BOFiP BOI-IR-RICI-120.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'sofica', 'rate_pct_tenths', '300')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'sofica', 'cap_cents', '1800000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'sofica', 'revenu_pct_tenths', '250')", []string{y})
    // FOREST — investissement forestier (art. 199 decies HA CGI). 22% (or 18%
    // for groupements) reduction, capped at 5,700 EUR single / 6,250 EUR couple
    // (for 2024). 25% for contrats de plantation. Subject to plafonnement global.
    // Record versements as positive txs in a 'forest' stream. Source: BOFiP
    // BOI-IR-RICI-50.
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'forest', 'rate_pct_tenths', '220')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'forest', 'cap_single_cents', '570000')", []string{y})
    sqlite_exec(db, "INSERT OR IGNORE INTO tax_rules(year, regime, param, value) VALUES(?, 'forest', 'cap_couple_cents', '625000')", []string{y})
}

type Rulevalrow struct { value string }

// rule_int — one tax-rule value as an int; dflt when the row is absent (a future year
// with no seeded rules still computes with last-known rates instead of zeroes).
// year is bound as text, so CAST it — year=2026 (INTEGER) never equals '2026' (TEXT).
func rule_int(db, year, regime, param, dflt) (v) {
    v = dflt
    rows := sqlite_query(db, "SELECT value FROM tax_rules WHERE year=CAST(? AS INTEGER) AND regime=? AND param=?", []string{str(year), regime, param})
    if rows == "" || rows == "[]" { return v }
    parsed := parse(rows, []Rulevalrow{})
    if len(parsed) > 0 { v = parse_int(parsed[0].value) }
}

// rule_str — string-valued tax rule (e.g. situation = "parent_isole"). Same lookup
// as rule_int but returns the raw string. dflt when absent.
func rule_str(db, year, regime, param, dflt) (v) {
    v = dflt
    rows := sqlite_query(db, "SELECT value FROM tax_rules WHERE year=CAST(? AS INTEGER) AND regime=? AND param=?", []string{str(year), regime, param})
    if rows == "" || rows == "[]" { return v }
    parsed := parse(rows, []Rulevalrow{})
    if len(parsed) > 0 { v = parsed[0].value }
}

// current_year — the default tax year (local time; a French filer thinks in local years).
// time_fields takes SECONDS (a unix timestamp), now_ms() is millis — divide.
func current_year() (y) {
    f := time_fields(now_ms() / 1000)
    y = f[0]
}
