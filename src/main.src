// bilan — CLI entry point and command routing. stdout = data (JSON), stderr =
// context/errors, semantic exit codes (cli-output-spec). The cmd_* wrappers only
// parse argv and die() on errors; the domain logic lives in ledger.src's *_json cores.

// say — one JSON object + newline on stdout (the data stream).
func say(s) { write(1, s + "\n") }

// die — a typed error: JSON on stderr + a semantic exit code, nothing on stdout.
func die(code, msg) {
    write(2, "{\"ok\":false,\"error\":\"" + esc(msg) + "\"}\n")
    exit(code)
}

func main() {
    a := args()
    cmd := ""
    if len(a) >= 2 { cmd = a[1] }
    if cmd == "" || cmd == "help" { cmd_help(a); return }
    if cmd == "help-json" { say(help_json()); return }
    if cmd == "version" || cmd == "--version" || cmd == "-v" { cmd_version(); return }
    if cmd == "guide" { cmd_guide(); return }
    if cmd == "feedback" { cmd_feedback(a); return }
    if cmd == "update" || cmd == "selfupdate" { cmd_update(); return }
    if cmd == "serve" { cmd_serve(a); return }
    // hosted mode: BILAN_URL set => domain commands hit the hosted API instead of a
    // local ledger. A 402 carries the pay object — print it so the agent can hand
    // the top-up link to its human.
    if env("BILAN_URL") != "" {
        h := hosted_forward(cmd, a)
        if h == 1 { return }
    }
    db := opendb()
    if cmd == "stream" { cmd_stream(db, a); sqlite_close(db); return }
    if cmd == "tx" { cmd_tx(db, a); sqlite_close(db); return }
    if cmd == "import" { cmd_import(db, a); sqlite_close(db); return }
    if cmd == "stats" { cmd_stats(db, a); sqlite_close(db); return }
    if cmd == "tax" { cmd_tax(db, a); sqlite_close(db); return }
    if cmd == "rule" { cmd_rule(db, a); sqlite_close(db); return }
    if cmd == "move" { cmd_move(db, a); sqlite_close(db); return }
    if cmd == "brief" { cmd_brief(db, a); sqlite_close(db); return }
    if cmd == "brian" { cmd_brian(); return }
    sqlite_close(db)
    hint := " (try: bilan help, or bilan help-json for the machine catalog)"
    write(2, "{\"ok\":false,\"error\":\"unknown command: " + esc(cmd) + esc(hint) + "\"}\n")
    exit(80)
}

// ── cmd wrappers over the ledger cores ──────────────────────────────────────

func cmd_stream(db, a) {
    if has_flag(a, "--help") == 1 || has_flag(a, "-h") == 1 { say(help_for("stream")); return }
    sub := ""
    if len(a) >= 3 { sub = a[2] }
    if sub == "add" {
        if len(a) < 4 { die(80, "usage: bilan stream add <name> --kind salary|bnc|bic|rent|crypto|trading|dividends|other [--currency EUR]") }
        out, code, err := stream_add(db, a[3], flagv(a, "--kind", ""), flagv(a, "--currency", "EUR"))
        if err != "" { die(code, err) }
        say(out)
        return
    }
    if sub == "list" { say(stream_list_json(db)); return }
    die(80, "usage: bilan stream add <name> --kind <k> | bilan stream list")
}

func cmd_tx(db, a) {
    if has_flag(a, "--help") == 1 || has_flag(a, "-h") == 1 { say(help_for("tx")); return }
    sub := ""
    if len(a) >= 3 { sub = a[2] }
    if sub == "add" {
        if len(a) < 6 { die(80, "usage: bilan tx add <stream> <YYYY-MM-DD> <amount> [--label L] [--source S] [--ext-id X]") }
        out, code, err := tx_add(db, a[3], a[4], a[5], flagv(a, "--label", ""), flagv(a, "--source", "manual"), flagv(a, "--ext-id", ""))
        if err != "" { die(code, err) }
        say(out)
        return
    }
    if sub == "list" {
        out, code, err := tx_list_json(db, flagv(a, "--stream", ""), flagv(a, "--year", ""), flagv(a, "--limit", "50"))
        if err != "" { die(code, err) }
        say(out)
        return
    }
    die(80, "usage: bilan tx add <stream> <date> <amount> [--label L] | bilan tx list [--stream S] [--year Y] [--limit N]")
}

func cmd_import(db, a) {
    if has_flag(a, "--help") == 1 || has_flag(a, "-h") == 1 { say(help_for("import")); return }
    if len(a) < 5 { die(80, "usage: bilan import <etoro|revolut|generic> <file|-> --stream S") }
    body := ""
    if a[3] == "-" { body = read_stdin() } else { body = read_file(a[3]) }
    out, code, err := import_csv(db, a[2], body, flagv(a, "--stream", ""))
    if err != "" { die(code, err) }
    say(out)
}

func cmd_stats(db, a) {
    if has_flag(a, "--help") == 1 || has_flag(a, "-h") == 1 { say(help_for("stats")); return }
    year := flagv(a, "--year", str(current_year()))
    if parse_cents_ok(year) == 0 { die(80, "bad --year: " + year) }
    out, code, err := stats_json(db, year)
    if err != "" { die(code, err) }
    say(out)
}

func cmd_tax(db, a) {
    if has_flag(a, "--help") == 1 || has_flag(a, "-h") == 1 { say(help_for("tax")); return }
    year := flagv(a, "--year", str(current_year()))
    if parse_cents_ok(year) == 0 { die(80, "bad --year: " + year) }
    out, code, err := tax_json(db, year)
    if err != "" { die(code, err) }
    say(out)
}

func cmd_rule(db, a) {
    if has_flag(a, "--help") == 1 || has_flag(a, "-h") == 1 { say(help_for("rule")); return }
    sub := ""
    if len(a) >= 3 { sub = a[2] }
    if sub == "list" {
        out, code, err := rule_list_json(db, flagv(a, "--year", ""))
        if err != "" { die(code, err) }
        say(out)
        return
    }
    if sub == "set" {
        if len(a) < 7 { die(80, "usage: bilan rule set <year> <regime> <param> <value>") }
        out, code, err := rule_set(db, a[3], a[4], a[5], a[6])
        if err != "" { die(code, err) }
        say(out)
        return
    }
    die(80, "usage: bilan rule list [--year Y] | bilan rule set <year> <regime> <param> <value>")
}

// ── meta commands (cli-guide-spec / cli-feedback-spec / cli-update-spec) ────

func cmd_version() {
    say("{\"ok\":true,\"name\":\"bilan\",\"version\":\"" + version_str() + "\"}")
}

func cmd_help(a) {
    if len(a) >= 3 {
        say(help_for(a[2]))
        return
    }
    say(help_text())
}

// cmd_update — re-run the official installer (downloads the latest prebuilt release
// and swaps it in atomically). BILAN_UPDATE_URL overrides the source (useful before
// the public release exists).
func cmd_update() {
    url := env("BILAN_UPDATE_URL")
    if url == "" { url = "https://raw.githubusercontent.com/javimosch/bilan/master/install.sh" }
    say("{\"ok\":true,\"action\":\"update\",\"from\":\"" + version_str() + "\",\"note\":\"fetching the latest release…\"}")
    code := system("curl -fsSL " + url + " | sh")
    if code != 0 { die(100, "update failed (installer exit " + str(code) + ") — check network, or reinstall from bilan.intrane.fr") }
    say("{\"ok\":true,\"updated\":true,\"hint\":\"run: bilan version\"}")
}

// cmd_feedback — dual-write per cli-feedback-spec: the app endpoint AND the central
// relay, same idempotency key, best-effort, never fails the caller.
func cmd_feedback(a) {
    if len(a) < 3 { die(80, "usage: bilan feedback <message> [--kind bug|idea|praise] [--context <what you were doing>]") }
    msg := a[2]
    kind := flagv(a, "--kind", "note")
    ctx := flagv(a, "--context", "")
    rep := env("USER")
    if rep == "" { rep = "agent" }
    id := to_hex(rand_bytes(8))
    payload := "{\"app\":\"bilan\",\"version\":\"" + version_str() + "\",\"kind\":\"" + esc(kind) + "\",\"message\":\"" + esc(msg) + "\",\"context\":\"" + esc(ctx) + "\",\"reporter\":\"" + esc(rep) + "\",\"id\":\"" + id + "\"}"
    app := env("BILAN_URL")
    if app == "" { app = "https://bilan.intrane.fr" }
    stored := post_fb(app + "/v1/feedback", payload)
    relay := env("FEEDBACK_RELAY")
    if relay == "" { relay = "https://feedback.intrane.fr" }
    relayed := 0
    if relay != "off" { relayed = post_fb(relay + "/v1/feedback", payload) }
    st := "false"
    if stored == 1 { st = "true" }
    rl := "false"
    if relayed == 1 { rl = "true" }
    note := ""
    if stored == 0 && relayed == 1 { note = ",\"note\":\"the app endpoint is not configured yet — your feedback reached the central relay (feedback.intrane.fr), the operator reads it there\"" }
    say("{\"ok\":true,\"id\":\"" + id + "\",\"stored\":" + st + ",\"relayed\":" + rl + note + "}")
}

// ── Brian: moves + the daily brief ──────────────────────────────────────────

// bilan move add --kind controle|securite|construction|patrimoine --action '...'
//   --pourquoi '...' --impact '...' [--horizon today|week|month]
// bilan move list [--status proposed|done|dismissed]
// bilan move done <id> | bilan move dismiss <id>
func cmd_move(db, a) {
    if has_flag(a, "--help") == 1 || has_flag(a, "-h") == 1 { say(help_for("move")); return }
    sub := ""
    if len(a) >= 3 { sub = a[2] }
    if sub == "add" {
        out, code, err := move_add(db, flagv(a, "--kind", ""), flagv(a, "--action", ""), flagv(a, "--pourquoi", ""), flagv(a, "--impact", ""), flagv(a, "--horizon", "today"))
        if err != "" { die(code, err) }
        say(out)
        return
    }
    if sub == "list" { say(move_list_json(db, flagv(a, "--status", ""))); return }
    if sub == "done" || sub == "dismiss" {
        if len(a) < 4 { die(80, "usage: bilan move done <id>") }
        out, code, err := move_close(db, a[3], sub)
        if err != "" { die(code, err) }
        say(out)
        return
    }
    die(80, "usage: bilan move add --kind <k> --action '...' --pourquoi '...' --impact '...' | bilan move list [--status S] | bilan move done <id>")
}

func cmd_brief(db, a) {
    if has_flag(a, "--help") == 1 || has_flag(a, "-h") == 1 { say(help_for("brief")); return }
    year := flagv(a, "--year", str(current_year()))
    if parse_cents_ok(year) == 0 { die(80, "bad --year: " + year) }
    out, code, err := brief_json(db, year)
    if err != "" { die(code, err) }
    say(out)
}

// post_fb — best-effort feedback POST; 1 on 200. Never blocks the caller on failure.
func post_fb(url, payload) (ok) {
    status, resp, err := http_request("POST", url, []string{"content-type: application/json"}, payload)
    if err == "" { if status == 200 { ok = 1 } }
}

// hosted_forward — proxy one domain command to the hosted API (BILAN_URL + bearer
// BILAN_TOKEN). Returns 1 when it handled the command (the process is done either way:
// success prints the body on stdout, failures print JSON on stderr + exit 100).
func hosted_forward(cmd, a) (handled) {
    handled = 0
    base := env("BILAN_URL")
    tok := env("BILAN_TOKEN")
    hd := []string{"authorization: Bearer " + tok, "content-type: application/json"}
    method := ""
    path := ""
    body := ""
    if cmd == "stream" {
        sub := ""
        if len(a) >= 3 { sub = a[2] }
        if sub == "add" {
            if len(a) < 4 { die(80, "usage: bilan stream add <name> --kind <k>") }
            method = "POST"  path = "/v1/streams"
            body = "{\"name\":" + json(a[3]) + ",\"kind\":" + json(flagv(a, "--kind", "")) + ",\"currency\":" + json(flagv(a, "--currency", "EUR")) + "}"
        } else { method = "GET"  path = "/v1/streams" }
    }
    if cmd == "tx" {
        sub := ""
        if len(a) >= 3 { sub = a[2] }
        if sub == "add" {
            if len(a) < 6 { die(80, "usage: bilan tx add <stream> <YYYY-MM-DD> <amount> [--label L]") }
            method = "POST"  path = "/v1/tx"
            body = "{\"stream\":" + json(a[3]) + ",\"date\":" + json(a[4]) + ",\"amount\":" + json(a[5]) + ",\"label\":" + json(flagv(a, "--label", "")) + "}"
        } else {
            method = "GET"
            path = "/v1/tx?stream=" + url_encode(flagv(a, "--stream", "")) + "&year=" + url_encode(flagv(a, "--year", "")) + "&limit=" + url_encode(flagv(a, "--limit", "50"))
        }
    }
    if cmd == "import" {
        if len(a) < 5 { die(80, "usage: bilan import <source> <file|-> --stream S") }
        fbody := ""
        if a[3] == "-" { fbody = read_stdin() } else { fbody = read_file(a[3]) }
        method = "POST"  path = "/v1/import"
        body = "{\"source\":" + json(a[2]) + ",\"csv\":" + json(fbody) + ",\"stream\":" + json(flagv(a, "--stream", "")) + "}"
    }
    if cmd == "stats" { method = "GET"  path = "/v1/stats?year=" + url_encode(flagv(a, "--year", "")) }
    if cmd == "tax" { method = "GET"  path = "/v1/tax?year=" + url_encode(flagv(a, "--year", "")) }
    if cmd == "rule" {
        sub := ""
        if len(a) >= 3 { sub = a[2] }
        if sub == "set" {
            if len(a) < 7 { die(80, "usage: bilan rule set <year> <regime> <param> <value>") }
            method = "POST"  path = "/v1/rules"
            body = "{\"year\":" + json(a[3]) + ",\"regime\":" + json(a[4]) + ",\"param\":" + json(a[5]) + ",\"value\":" + json(a[6]) + "}"
        } else { method = "GET"  path = "/v1/rules?year=" + url_encode(flagv(a, "--year", "")) }
    }
    if cmd == "move" {
        sub := ""
        if len(a) >= 3 { sub = a[2] }
        if sub == "add" {
            method = "POST"  path = "/v1/moves"
            body = "{\"kind\":" + json(flagv(a, "--kind", "")) + ",\"action\":" + json(flagv(a, "--action", "")) + ",\"pourquoi\":" + json(flagv(a, "--pourquoi", "")) + ",\"impact\":" + json(flagv(a, "--impact", "")) + ",\"horizon\":" + json(flagv(a, "--horizon", "today")) + "}"
        } else if sub == "done" || sub == "dismiss" {
            if len(a) < 4 { die(80, "usage: bilan move done <id>") }
            method = "POST"  path = "/v1/moves"
            body = "{\"close_id\":" + json(a[3]) + ",\"close_status\":\"" + sub + "\"}"
        } else { method = "GET"  path = "/v1/moves?status=" + url_encode(flagv(a, "--status", "")) }
    }
    if cmd == "brief" { method = "GET"  path = "/v1/brief?year=" + url_encode(flagv(a, "--year", "")) }
    if method == "" { return handled }
    st, pbody, herr := http_request(method, base + path, hd, body)
    if herr != "" { write(2, "{\"ok\":false,\"error\":\"hosted unreachable: " + esc(herr) + "\"}\n")  exit(100) }
    if st == 402 { write(2, pbody + "\n")  exit(100) }
    if st >= 400 { write(2, pbody + "\n")  exit(100) }
    say(pbody)
    handled = 1
}

// ── help surfaces ───────────────────────────────────────────────────────────

func help_text() (t) {
    t = "{\"ok\":true,\"name\":\"bilan\",\"version\":\"" + version_str() + "\",\"tagline\":\"the deterministic financial ledger + tax radar for professionnels pluri-actifs — no LLM inside, your agent drives\",\"db\":\"$BILAN_DB (default ~/.bilan.db)\",\"commands\":{\"stream\":\"stream add <name> --kind salary|bnc|bic|rent|crypto|trading|dividends|other [--currency EUR] | stream list\",\"tx\":\"tx add <stream> <YYYY-MM-DD> <amount> [--label L --source S --ext-id X] | tx list [--stream S] [--year Y] [--limit N]\",\"import\":\"import <etoro|revolut|generic> <file|-> --stream S (idempotent; - = stdin)\",\"stats\":\"stats [--year Y] (per-kind signed totals + net)\",\"tax\":\"tax [--year Y] (the radar: abattements, PFU, crypto exemption)\",\"rule\":\"rule list [--year Y] | rule set <year> <regime> <param> <value> (rates are DATA)\",\"move\":\"move add --kind controle|securite|construction|patrimoine --action X --pourquoi X --impact X [--horizon H] | move list [--status S] | move done <id>\",\"brief\":\"brief [--year Y] — the morning digest: provision, stream momentum, moves (deterministic; the agent narrates)\",\"brian\":\"print the Brian persona — install into claude-code/pi/opencode and the agent becomes the copilote\",\"guide\":\"the complete operator reference (agents: read this first)\",\"feedback\":\"feedback <message> [--kind bug|idea|praise]\",\"serve\":\"serve [--port N] — HTTP JSON API (Bearer-gated /v1/*)\",\"version\":\"release version\",\"update\":\"self-update via the official installer\"},\"learn_more\":\"bilan guide | bilan help-json\"}"
}

func help_json() (t) {
    t = "{\"ok\":true,\"name\":\"bilan\",\"version\":\"" + version_str() + "\",\"commands\":[{\"name\":\"stream add\",\"usage\":\"bilan stream add <name> --kind <k> [--currency EUR]\",\"description\":\"create an activity stream (kind: salary|bnc|bic|rent|crypto|trading|dividends|other)\"},{\"name\":\"stream list\",\"usage\":\"bilan stream list\",\"description\":\"all streams\"},{\"name\":\"tx add\",\"usage\":\"bilan tx add <stream> <YYYY-MM-DD> <amount> [--label L] [--source S] [--ext-id X]\",\"description\":\"record one signed money event (positive income, negative expense/loss)\"},{\"name\":\"tx list\",\"usage\":\"bilan tx list [--stream S] [--year Y] [--limit N]\",\"description\":\"transactions, latest first\"},{\"name\":\"import\",\"usage\":\"bilan import <etoro|revolut|generic> <file|-> --stream S\",\"description\":\"import a broker/bank CSV (idempotent; - reads stdin)\"},{\"name\":\"stats\",\"usage\":\"bilan stats [--year Y]\",\"description\":\"per-kind signed totals, income/expense/net\"},{\"name\":\"tax\",\"usage\":\"bilan tax [--year Y]\",\"description\":\"the tax radar: abattements, social, PFU, crypto 2086 exemption\"},{\"name\":\"rule list\",\"usage\":\"bilan rule list [--year Y]\",\"description\":\"the rate card (tax rules as data)\"},{\"name\":\"rule set\",\"usage\":\"bilan rule set <year> <regime> <param> <value>\",\"description\":\"override a rate for a year (decipercent tenths: 340 = 34.0%)\"},{\"name\":\"move\",\"usage\":\"bilan move add --kind controle|securite|construction|patrimoine --action A --pourquoi P --impact I [--horizon H] | move list [--status S] | move done <id>\",\"description\":\"Brian moves: propose (agent) / approve (human, dashboard /app) — Action + Pourquoi + Impact\"},{\"name\":\"brief\",\"usage\":\"bilan brief [--year Y]\",\"description\":\"the morning digest: tax provision, stream momentum, moves en attente (deterministic)\"},{\"name\":\"brian\",\"usage\":\"bilan brian\",\"description\":\"print the Brian persona to install into any agent harness (the cheap copilote)\"},{\"name\":\"guide\",\"usage\":\"bilan guide\",\"description\":\"the complete operator reference\"},{\"name\":\"feedback\",\"usage\":\"bilan feedback <message> [--kind bug|idea|praise]\",\"description\":\"send feedback (dual-write, never fails)\"},{\"name\":\"serve\",\"usage\":\"bilan serve [--port N]\",\"description\":\"HTTP JSON API; /v1/* Bearer-gated, /_health + /guide + /llms.txt open\"},{\"name\":\"version\",\"usage\":\"bilan version\",\"description\":\"the release version\"},{\"name\":\"update\",\"usage\":\"bilan update\",\"description\":\"self-update via the official installer\"}],\"exit_codes\":{\"0\":\"ok\",\"80\":\"bad input\",\"93\":\"conflict\",\"94\":\"not found\",\"100\":\"upstream\",\"110\":\"internal\"},\"guide\":\"run bilan guide for the full operator reference\"}"
}

// help_for — per-command help (JSON). `bilan help <cmd>` and `bilan <cmd> --help`
// both route here so an agent exploring one command gets its usage, not the whole
// catalog (and not the command's data output by accident — a cold agent typing
// `bilan tax --help` used to get tax DATA because --year defaulted to the current year).
func help_for(cmd) (t) {
    u := cmd_usage(cmd)
    if u == "" { t = "{\"ok\":false,\"error\":\"no such command: " + esc(cmd) + " (try: bilan help)\"}"  return t }
    t = "{\"ok\":true,\"name\":\"bilan\",\"version\":\"" + version_str() + "\",\"command\":\"" + esc(cmd) + "\",\"usage\":\"" + esc(u) + "\",\"description\":\"" + esc(cmd_desc(cmd)) + "\",\"see_also\":\"bilan guide | bilan help-json\"}"
}

func cmd_usage(cmd) (u) {
    u = ""
    if cmd == "stream" { u = "bilan stream add <name> --kind salary|bnc|bic|rent|crypto|trading|dividends|other [--currency EUR] | bilan stream list" }
    if cmd == "tx" { u = "bilan tx add <stream> <YYYY-MM-DD> <amount> [--label L --source S --ext-id X] | bilan tx list [--stream S] [--year Y] [--limit N]" }
    if cmd == "import" { u = "bilan import <etoro|revolut|generic> <file|-> --stream S (idempotent; - reads stdin)" }
    if cmd == "stats" { u = "bilan stats [--year Y]" }
    if cmd == "tax" { u = "bilan tax [--year Y] — the radar: abattements, social, PFU, crypto 2086 exemption" }
    if cmd == "rule" { u = "bilan rule list [--year Y] | bilan rule set <year> <regime> <param> <value> (rates are DATA)" }
    if cmd == "move" { u = "bilan move add --kind controle|securite|construction|patrimoine --action A --pourquoi P --impact I [--horizon H] | move list [--status S] | move done <id>" }
    if cmd == "brief" { u = "bilan brief [--year Y] — the morning digest: provision, stream momentum, pending moves" }
    if cmd == "brian" { u = "bilan brian — print the persona to install into your agent harness" }
    if cmd == "guide" { u = "bilan guide — the complete operator reference" }
    if cmd == "feedback" { u = "bilan feedback <message> [--kind bug|idea|praise] [--context C]" }
    if cmd == "serve" { u = "bilan serve [--port N] — HTTP JSON API (Bearer-gated /v1/*)" }
    if cmd == "version" { u = "bilan version" }
    if cmd == "update" { u = "bilan update — self-update via the official installer" }
}

func cmd_desc(cmd) (d) {
    d = ""
    if cmd == "stream" { d = "create or list activity streams (one income source each)" }
    if cmd == "tx" { d = "record one signed money event (positive income, negative expense/loss), or list transactions" }
    if cmd == "import" { d = "import a broker/bank CSV (idempotent; etoro/revolut/generic)" }
    if cmd == "stats" { d = "per-kind signed totals + net for a year" }
    if cmd == "tax" { d = "the tax radar: abattements, social, PFU, crypto 2086 exemption" }
    if cmd == "rule" { d = "the rate card (tax rules as data): list or set" }
    if cmd == "move" { d = "Brian moves: propose (agent) / approve (human) — Action + Pourquoi + Impact" }
    if cmd == "brief" { d = "the morning digest: provision, stream momentum, pending moves (deterministic)" }
    if cmd == "brian" { d = "print the Brian persona to install into your agent harness (claude-code/pi/opencode)" }
    if cmd == "guide" { d = "the complete operator reference (agents: read this first)" }
    if cmd == "feedback" { d = "report a bug/idea/praise (dual-write, never fails the caller)" }
    if cmd == "serve" { d = "HTTP JSON API (Bearer-gated /v1/*; /_health, /guide, /llms.txt open)" }
    if cmd == "version" { d = "the release version" }
    if cmd == "update" { d = "self-update via the official installer" }
}
