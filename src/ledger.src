    out = out + ",\"per_cumul\":{\"revenus_n1_cents\":" + str(pc_revenus_n1) + ",\"pass_n_cents\":" + str(pc_pass_n) + ",\"pass_n1_cents\":" + str(pc_pass_n1) + ",\"plafond_154_bis_cents\":" + str(per_tns_plafond) + ",\"plafond_163_quatervicies_cents\":" + str(pc_163_cap) + ",\"combined_ceiling_cents\":" + str(pc_combined_ceiling) + ",\"combined_ceiling_eur\":\"" + fmt_cents(pc_combined_ceiling) + "\",\"note\":\"cumul art. 154 bis + 163 quatervicies CGI — TNS can cumulate both ceilings (same cotisation not deducted twice); 154 bis: 10% bénéfice N + 15% 1-8 PASS, plancher 10% PASS N; 163 quatervicies: 10% revenus N-1, plancher 10% PASS N-1; set: bilan rule set 2026 per_cumul revenus_n1_cents <val>\"}"
    out = out + ",\"pv_pro\":{\"plus_value_cents\":" + str(pvp_pv) + ",\"plus_value_eur\":\"" + fmt_cents(pvp_pv) + "\",\"duree_activite_years\":" + str(pvp_duree) + ",\"recettes_cents\":" + str(pvp_recettes) + ",\"activite_type\":\"" + pvp_activite + "\",\"eligible_151_septies\":" + json(pvp_eligible_151_septies == 1) + ",\"exoneration_pct\":" + pct_str(pvp_exoneration_pct) + ",\"pv_exoneree_cents\":" + str(pvp_pv_exoneree) + ",\"pv_imposable_cents\":" + str(pvp_pv_imposable) + ",\"bien_immo_affecte\":" + json(pvp_bien_immo == 1) + ",\"duree_detention_years\":" + str(pvp_detention) + ",\"abattement_151_septies_B_pct\":" + pct_str(pvp_abattement_151b_pct) + ",\"pv_apres_abattement_cents\":" + str(pvp_pv_apres_abattement) + ",\"note\":\"art. 151 septies CGI — exonération totale PV cession petites entreprises (activité ≥5 ans, recettes < seuils: commerce 250000, artisanat 90000, libéral/agricole 350000); art. 151 septies B — abattement 10%/an >5y sur biens immo affectés (plafond 10y = exonération 15y); set: bilan rule set 2026 pv_pro plus_value_cents <val> + duree_activite_years <val> + recettes_cents <val> + activite_type <commerce|artisanat|liberal|agricole>\"}"
    out = out + ",\"dmtg_donation\":{\"actif_taxable_cents\":" + str(dd_actif) + ",\"actif_taxable_eur\":\"" + fmt_cents(dd_actif) + "\",\"degre_parente\":\"" + dd_degre + "\",\"abattement_cents\":" + str(dd_abattement) + ",\"abattement_eur\":\"" + fmt_cents(dd_abattement) + "\",\"abattement_789_bis_cents\":" + str(dd_789_bis) + ",\"abattement_789_bis_eur\":\"" + fmt_cents(dd_789_bis) + "\",\"tax_cents\":" + str(dd_tax) + ",\"tax_eur\":\"" + fmt_cents(dd_tax) + "\",\"note\":\"art. 777 CGI — DMTG donation: same barème as succession for ligne directe/frère-sœur/4e degré/tiers, but conjoint/PACS follows Tableau II (NOT exoneré for donations, abattement 80724); art. 789 bis: abattement 500000 sur donation fonds commerce/entreprise individuelle; abattements renouvelables 15 ans (art. 779); set: bilan rule set 2026 dmtg_donation actif_taxable_cents <val> + degre_parente <ligne_directe|conjoint|frere_soeur|quatrieme_degre|tiers> + abattement_789_bis_eligible <0|1>\"}"
    out = out + ",\"pv_mobiliere\":{\"prix_acquisition_cents\":" + str(pvmob_acq) + ",\"prix_cession_cents\":" + str(pvmob_cession) + ",\"duree_detention_years\":" + str(pvmob_detention) + ",\"is_pme\":" + json(pvmob_is_pme == 1) + ",\"gain_net_cents\":" + str(pvmob_gain) + ",\"gain_net_eur\":\"" + fmt_cents(pvmob_gain) + "\",\"abattement_pct\":" + pct_str(pvmob_abattement_pct) + ",\"gain_apres_abattement_cents\":" + str(pvmob_gain_apres_abattement) + ",\"gain_apres_abattement_eur\":\"" + fmt_cents(pvmob_gain_apres_abattement) + "\",\"note\":\"art. 150-0 A CGI — gain net = prix cession - prix acquisition; art. 150-0 D 1 ter: abattement 50% >2 ans, 65% >8 ans (sociétés non-PME); art. 150-0 D 1 quater: abattement 50% >1 an, 75% >5 ans (PME); set: bilan rule set 2026 pv_mobiliere prix_acquisition_cents <val> + prix_cession_cents <val> + duree_detention_years <val> + is_pme <0|1>\"}"
    out = out + ",\"dmtg_handicap\":{\"eligible\":" + json(dmtg_handicap_eligible == 1) + ",\"abattement_cents\":" + str(dmtg_handicap_abattement) + ",\"abattement_eur\":\"" + fmt_cents(dmtg_handicap_abattement) + "\",\"note\":\"art. 779 II CGI — abattement 159325 EUR pour héritier/légataire/donataire handicapé (incapable de travailler), cumulable avec les autres abattements; set: bilan rule set 2026 dmtg handicap_eligible 1\"}"
    out = out + ",\"dmtg_dutreil\":{\"eligible\":" + json(dmtg_dutreil_eligible == 1) + ",\"abattement_pct\":" + pct_str(dmtg_dutreil_abattement_pct) + ",\"reduction_pct\":" + pct_str(dmtg_dutreil_reduction_pct) + ",\"tax_cents\":" + str(dmtg_dutreil_tax) + ",\"tax_eur\":\"" + fmt_cents(dmtg_dutreil_tax) + "\",\"note\":\"art. 787 B CGI (Pacte Dutreil) — abattement 75% sur valeur entreprise transmise (engagement collectif 2y + individuel 4y); art. 790: réduction 50% sur droits restants si donateur <70 ans et pleine propriété; set: bilan rule set 2026 dmtg dutreil_eligible 1 + dutreil_donateur_age <val> + dutreil_pleine_propriete 1\"}"
    out = out + ",\"totals\":{\"ir_cents\":" + str(ir_after_credit) + ",\"ir_eur\":\"" + fmt_cents(ir_after_credit) + "\",\"flat_tax_cents\":" + str(cap_tax+div_tax) + ",\"flat_tax_eur\":\"" + fmt_cents(cap_tax+div_tax) + "\",\"social_cents\":" + str(soc_bnc+soc_bic+soc_fon+soc_lmnp+soc_lmnp_reel) + ",\"social_eur\":\"" + fmt_cents(soc_bnc+soc_bic+soc_fon+soc_lmnp+soc_lmnp_reel) + "\",\"tva_cents\":" + str(tva_a_payer) + ",\"tva_eur\":\"" + fmt_cents(tva_a_payer) + "\",\"pv_immo_cents\":" + str(pv_immo_total) + ",\"pv_immo_eur\":\"" + fmt_cents(pv_immo_total) + "\",\"ifi_cents\":" + str(ifi_cents) + ",\"ifi_eur\":\"" + fmt_cents(ifi_cents) + "\",\"cfe_cents\":" + str(cfe_cents) + ",\"cfe_eur\":\"" + fmt_cents(cfe_cents) + "\",\"cvae_cents\":" + str(cvae_cents) + ",\"cvae_eur\":\"" + fmt_cents(cvae_cents) + "\",\"pvm_cents\":" + str(pvm_total_tax) + ",\"pvm_eur\":\"" + fmt_cents(pvm_total_tax) + "\",\"pv_immo_surtaxe_cents\":" + str(pv_surtaxe_cents) + ",\"pv_immo_surtaxe_eur\":\"" + fmt_cents(pv_surtaxe_cents) + "\",\"metaux_precieux_cents\":" + str(mp_effective_total) + ",\"metaux_precieux_eur\":\"" + fmt_cents(mp_effective_total) + "\",\"total_tax_cents\":" + str(ir_after_credit+cap_tax+div_tax+soc_bnc+soc_bic+soc_fon+soc_lmnp+soc_lmnp_reel+tva_a_payer+pv_immo_total+pv_surtaxe_cents+ifi_cents+cfe_cents+cvae_cents+mp_effective_total) + ",\"total_tax_eur\":\"" + fmt_cents(ir_after_credit+cap_tax+div_tax+soc_bnc+soc_bic+soc_fon+soc_lmnp+soc_lmnp_reel+tva_a_payer+pv_immo_total+pv_surtaxe_cents+ifi_cents+cfe_cents+cvae_cents+mp_effective_total) + "\"}"
    out = out + ",\"notes\":[\"estimates on the seeded rate card (2025 barème on 2024 income) — override with bilan rule set\",\"IR = progressive barème + plafonnement QF (situation-aware: default 1791/demi-part, parent_isole 4262 total, veuf 1807/demi-part+2011, personne_seule_invalide 3608) + décote; 10% frais per salary stream; BNC/BIC/LMNP deficits 6y; foncier deficit 10700 EUR on global + 10y on foncier (micro + réel)\",\"pension alimentaire (art. 156 II.2°): deductible from revenu global, cap 6794 EUR/child (2024 income)\",\"dons reduction (art. 200 CGI): 75% to 1000 EUR, 66% to 20% of revenu imposable — reduces IR\",\"pinel/denormandie reduction (art. 199 novovicies): 12/18/21% by engagement, cap 300000 EUR, spread over years — reduces IR\",\"malraux reduction (art. 199 tervicies): 30% PSMV / 22% PVAP, cap 400000 EUR, hors plafonnement niches — reduces IR\",\"censi-bouvard reduction (art. 199 sexvicies): 11% LMNP résidences de services, cap 300000 EUR, spread over 9y — reduces IR\",\"scolarité reduction (art. 199 quater F): forfait 61 collège / 153 lycée / 183 supérieur per child — reduces IR\",\"ir-pme reduction (art. 199 terdecies-0 A): 18% PME, cap 50000 single / 100000 couple — reduces IR (plafonnement niches NOT modeled)\",\"emploi à domicile (art. 199 sexdecies): 50% crédit, cap 12000 EUR — refundable (crédit, not réduction)\",\"frais de garde (art. 200 quater B): 50% crédit, cap 3500 EUR/child — refundable (crédit, not réduction)\",\"TVA franchise (art. 293 B): services 36800 / vente 91900 EUR — informational\",\"TVA régime simplifié (art. 302 septies A): services 254000 / vente 840000 EUR, TVA due < 15000 EUR\",\"TVA collectée/déductible (art. 271): TVA à payer = collectée - déductible (négatif = crédit reportable/remboursable)\",\"PAS taux neutre + personnalisé (art. 204 H): monthly estimate for provisioning — v1 simplification of the BOFiP formula\",\"régime réel foncier (art. 29-31): net = loyer - charges (intérêts d'emprunt, travaux), no abattement — combined with micro-foncier\",\"LMNP micro-BIC meublé (art. 50): 50% abattement, threshold 77700 EUR\",\"LMNP régime réel (art. 39): net = loyer - charges - amortissement, no abattement, deficit carry 6y\",\"micro-BNC/BIC/foncier cannot legally generate deficits (forfaitaire) — deficit carry-forward is a régime-réel feature applied to the micro base as a v1 simplification\",\"crypto exemption per form 2086: net gains under the threshold are not declarable\"]}"
    code = 0
    err = ""
}

// rule_list / rule_set — the rate card is data. list [--year Y]; set <year> <regime> <param> <value>.
func rule_list_json(db, year) (out, code, err) {
    where := ""
    params := []string{}
    if year != "" { where = "year=CAST(? AS INTEGER)"  params = append(params, year) }
    sql := "SELECT year, regime, param, value FROM tax_rules"
    if where != "" { sql = sql + " WHERE " + where }
    sql = sql + " ORDER BY year, regime, param"
    rows := sqlite_query(db, sql, params)
    out = "{\"ok\":true,\"rules\":" + rows + "}"
    code = 0
    err = ""
}

func rule_set(db, year, regime, param, value) (out, code, err) {
    if parse_cents_ok(year) == 0 { return "", 80, "bad year: " + year }
    sqlite_exec(db, "INSERT INTO tax_rules(year,regime,param,value) VALUES(?,?,?,?) ON CONFLICT(year,regime,param) DO UPDATE SET value=excluded.value", []string{year, regime, param, value})
    out = "{\"ok\":true,\"year\":" + year + ",\"regime\":\"" + esc(regime) + "\",\"param\":\"" + esc(param) + "\",\"value\":\"" + esc(value) + "\"}"
    code = 0
    err = ""
}
