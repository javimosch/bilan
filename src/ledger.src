// ledger — the domain logic. Each operation has a *_json core returning (out, code, err)
// so BOTH the CLI commands and the HTTP handlers render the exact same JSON; the cmd_*
// wrappers only parse argv and die() on errors. All money is integer cents.

type Idrow struct { id string }
type Kindrow struct { kind string  total int  n int }
type Nrow struct { n int }

// changes_n — rows touched by the last statement on db (INSERT OR IGNORE writes 0
// when the UNIQUE key collides — sqlite_exec's own return value does NOT tell you).
func changes_n(db) (n) {
    n = 0
    rows := sqlite_query(db, "SELECT changes() AS n", []string{})
    parsed := parse(rows, []Nrow{})
    if len(parsed) > 0 { n = parsed[0].n }
}

// stream_ref — resolve a stream by exact name or exact id; "" when unknown (callers die 94).
func stream_ref(db, q) (id) {
    id = ""
    rows := sqlite_query(db, "SELECT id FROM streams WHERE name=?", []string{q})
    if rows != "[]" && rows != "" {
        parsed := parse(rows, []Idrow{})
        if len(parsed) > 0 { id = parsed[0].id  return id }
    }
    rows = sqlite_query(db, "SELECT id FROM streams WHERE id=?", []string{q})
    if rows != "[]" && rows != "" {
        parsed := parse(rows, []Idrow{})
        if len(parsed) > 0 { id = parsed[0].id }
    }
}

// kind_ok — the closed v0 set of stream kinds. The tax compute switches on these, so
// an unknown kind is rejected at the door instead of silently skipped by the radar.
func kind_ok(k) (ok) {
    ok = 0
    if k == "salary" { ok = 1  return ok }
    if k == "bnc" { ok = 1  return ok }
    if k == "bic" { ok = 1  return ok }
    if k == "rent" { ok = 1  return ok }
    if k == "crypto" { ok = 1  return ok }
    if k == "trading" { ok = 1  return ok }
    if k == "dividends" { ok = 1  return ok }
    if k == "dons" { ok = 1  return ok }
    if k == "emploi_domicile" { ok = 1  return ok }
    if k == "pinel" { ok = 1  return ok }
    if k == "denormandie" { ok = 1  return ok }
    if k == "malraux" { ok = 1  return ok }
    if k == "foncier_reel" { ok = 1  return ok }
    if k == "lmnp" { ok = 1  return ok }
    if k == "lmnp_reel" { ok = 1  return ok }
    if k == "censi_bouvard" { ok = 1  return ok }
    if k == "tva_collectee" { ok = 1  return ok }
    if k == "tva_deductible" { ok = 1  return ok }
    if k == "frais_garde" { ok = 1  return ok }
    if k == "scolarite" { ok = 1  return ok }
    if k == "pension_alimentaire" { ok = 1  return ok }
    if k == "ir_pme" { ok = 1  return ok }
    if k == "per" { ok = 1  return ok }
    if k == "fcpi_fip" { ok = 1  return ok }
    if k == "sofica" { ok = 1  return ok }
    if k == "forest" { ok = 1  return ok }
    if k == "plus_value_immo" { ok = 1  return ok }
    if k == "ifi_patrimoine" { ok = 1  return ok }
    if k == "heures_sup" { ok = 1  return ok }
    if k == "metaux" { ok = 1  return ok }
    if k == "objets_art" { ok = 1  return ok }
    if k == "monument_historique" { ok = 1  return ok }
    if k == "other" { ok = 1  return ok }
}

// ── stream ──────────────────────────────────────────────────────────────────

func stream_add(db, name, kind, cur) (out, code, err) {
    if name == "" || kind == "" { return "", 80, "usage: bilan stream add <name> --kind salary|bnc|bic|rent|crypto|trading|dividends|dons|emploi_domicile|pinel|denormandie|malraux|foncier_reel|lmnp|lmnp_reel|censi_bouvard|tva_collectee|tva_deductible|frais_garde|scolarite|pension_alimentaire|ir_pme|per|fcpi_fip|sofica|forest|plus_value_immo|ifi_patrimoine|heures_sup|metaux|objets_art|monument_historique|other [--currency EUR]" }
    if kind_ok(kind) == 0 { return "", 80, "unknown kind: " + kind + " (salary|bnc|bic|rent|crypto|trading|dividends|dons|emploi_domicile|pinel|denormandie|malraux|foncier_reel|lmnp|lmnp_reel|censi_bouvard|tva_collectee|tva_deductible|frais_garde|scolarite|pension_alimentaire|ir_pme|per|fcpi_fip|sofica|forest|plus_value_immo|ifi_patrimoine|heures_sup|metaux|objets_art|monument_historique|other)" }
    if stream_ref(db, name) != "" { return "", 93, "stream already exists: " + name }
    id := to_hex(rand_bytes(8))
    sqlite_exec(db, "INSERT INTO streams(id,name,kind,currency,created) VALUES(?,?,?,?,?)", []string{id, name, kind, cur, str(now_ms())})
    out = "{\"ok\":true,\"stream\":\"" + esc(name) + "\",\"id\":\"" + id + "\",\"kind\":\"" + esc(kind) + "\",\"currency\":\"" + esc(cur) + "\"}"
    code = 0
    err = ""
}

func stream_list_json(db) (out) {
    rows := sqlite_query(db, "SELECT id, name, kind, currency FROM streams ORDER BY name", []string{})
    out = "{\"ok\":true,\"streams\":" + rows + "}"
}

// ── tx ──────────────────────────────────────────────────────────────────────

// tx_add — one manual transaction. ext_id defaults to a content key of
// (date,cents,label) so re-adding the same line is a no-op, not a dupe.
func tx_add(db, stream_q, date, amount, label, source, ext_in) (out, code, err) {
    sid := stream_ref(db, stream_q)
    if sid == "" { return "", 94, "no such stream: " + stream_q + " (create it: bilan stream add " + stream_q + " --kind ...)" }
    if date_ok(date) == 0 { return "", 80, "bad date \"" + date + "\" — want YYYY-MM-DD" }
    if parse_cents_ok(amount) == 0 { return "", 80, "bad amount \"" + amount + "\" — want a number, e.g. 1234.56 or -12" }
    cents := parse_cents(amount)
    if cents == 0 { return "", 80, "zero-amount tx — a 0.00 line carries no information; skip it in the source export" }
    if date > today_str() { return "", 80, "future-dated tx (" + date + " > today " + today_str() + ") — the ledger records realized events, not plans" }
    if source == "" { source = "manual" }
    ext := ext_in
    if ext == "" { ext = "manual:" + date + ":" + str(cents) + ":" + label }
    id := to_hex(rand_bytes(8))
    sqlite_exec(db, "INSERT OR IGNORE INTO txs(id,stream_id,date,cents,label,source,ext_id,created) VALUES(?,?,?,?,?,?,?,?)", []string{id, sid, date, str(cents), label, source, ext, str(now_ms())})
    if changes_n(db) == 0 { out = "{\"ok\":true,\"duplicate\":true,\"id\":null,\"hint\":\"identical (stream,date,amount,label) already imported — nothing written\"}"  code = 0  err = ""  return out, code, err }
    out = "{\"ok\":true,\"id\":\"" + id + "\",\"stream\":\"" + esc(stream_q) + "\",\"date\":\"" + date + "\",\"cents\":" + str(cents) + "}"
    code = 0
    err = ""
}

func tx_list_json(db, stream_q, year, limit) (out, code, err) {
    where := ""
    params := []string{}
    if stream_q != "" {
        sid := stream_ref(db, stream_q)
        if sid == "" { return "", 94, "no such stream: " + stream_q }
        where = "t.stream_id=?"
        params = append(params, sid)
    }
    if year != "" {
        if parse_cents_ok(year) == 0 { return "", 80, "bad --year: " + year }
        if where != "" { where = where + " AND " }
        where = where + "t.date>=? AND t.date<=?"
        params = append(params, year+"-01-01")
        params = append(params, year+"-12-31")
    }
    if limit == "" { limit = "50" }
    sql := "SELECT t.id, t.date, t.cents, t.label, t.source, s.name AS stream FROM txs t JOIN streams s ON s.id=t.stream_id"
    if where != "" { sql = sql + " WHERE " + where }
    sql = sql + " ORDER BY t.date DESC, t.rowid DESC LIMIT ?"
    params = append(params, limit)
    rows := sqlite_query(db, sql, params)
    out = "{\"ok\":true,\"txs\":" + rows + "}"
    code = 0
    err = ""
}

// ── import ──────────────────────────────────────────────────────────────────

// import_csv — map a broker/bank CSV's header to (date, amount, label) columns and
// insert every parseable row. source: etoro | revolut | generic. Idempotent: the
// (stream, ext_id) UNIQUE key is derived from row content, so re-importing the same
// file inserts nothing new.
func import_csv(db, source, body, stream_q) (out, code, err) {
    sid := stream_ref(db, stream_q)
    if sid == "" { return "", 94, "no such stream: " + stream_q }
    lines := split(body, "\n")
    if len(lines) < 2 { return "", 80, "no data rows (need a header line + at least one row)" }
    // sniff the delimiter from the header: fr Excel exports use ";" (more of them
    // than commas), anglo exports use ",". Wrong delimiter = every row one cell.
    sep := ","
    hline := trim_cr(lines[0])
    sc := 0
    cc := 0
    j := 0
    for j < len(hline) {
        c := substr(hline, j, j+1)
        if c == ";" { sc = sc + 1 }
        if c == "," { cc = cc + 1 }
        j = j + 1
    }
    if sc > cc { sep = ";" }
    head := csv_split(trim_cr(lines[0]), sep)
    lower_head := to_lower(trim_cr(lines[0]))
    datecol := -1
    amtcol := -1
    labcol := -1
    if source == "etoro" || contains(lower_head, "profit") {
        datecol = col_find(head, "close date")
        if datecol < 0 { datecol = col_find(head, "date") }
        amtcol = col_find(head, "profit")
        if amtcol < 0 { amtcol = col_find(head, "amount") }
        labcol = col_find(head, "details")
        if labcol < 0 { labcol = col_find(head, "action") }
    } else if source == "revolut" || contains(lower_head, "completed date") {
        datecol = col_find(head, "completed date")
        if datecol < 0 { datecol = col_find(head, "date") }
        amtcol = col_find(head, "amount")
        labcol = col_find(head, "description")
    } else {
        datecol = col_find(head, "date")
        amtcol = col_find(head, "amount")
        if amtcol < 0 { amtcol = col_find(head, "montant") }
        labcol = col_find(head, "label")
        if labcol < 0 { labcol = col_find(head, "description") }
        if labcol < 0 { labcol = col_find(head, "details") }
    }
    if datecol < 0 || amtcol < 0 { return "", 80, "could not find date/amount columns in the header (source=" + source + ") — rename the columns to date/amount/label, or pick the right source" }
    inserted := 0
    skipped := 0
    i := 1
    for i < len(lines) {
        line := trim_cr(lines[i])
        if trim(line) == "" { i = i + 1  continue }
        cells := csv_split(line, sep)
        d := ""
        if datecol < len(cells) { d = norm_date(cells[datecol]) }
        amtc := ""
        if amtcol < len(cells) { amtc = trim(cells[amtcol]) }
        if d == "" || parse_cents_ok(amtc) == 0 { skipped = skipped + 1  i = i + 1  continue }
        cents := parse_cents(amtc)
        if cents == 0 || d > today_str() { skipped = skipped + 1  i = i + 1  continue }
        label := ""
        if labcol >= 0 && labcol < len(cells) { label = trim(cells[labcol]) }
        ext := source + ":" + d + ":" + str(cents) + ":" + label
        sqlite_exec(db, "INSERT OR IGNORE INTO txs(id,stream_id,date,cents,label,source,ext_id,created) VALUES(?,?,?,?,?,?,?,?)", []string{to_hex(rand_bytes(8)), sid, d, str(cents), label, source, ext, str(now_ms())})
        if changes_n(db) > 0 { inserted = inserted + 1 } else { skipped = skipped + 1 }
        i = i + 1
    }
    sqlite_exec(db, "INSERT INTO imports(id,source,file,rows,skipped,ts) VALUES(?,?,?,?,?,?)", []string{to_hex(rand_bytes(8)), source, "stdin", str(inserted), str(skipped), str(now_ms())})
    out = "{\"ok\":true,\"source\":\"" + esc(source) + "\",\"stream\":\"" + esc(stream_q) + "\",\"inserted\":" + str(inserted) + ",\"skipped\":" + str(skipped) + "}"
    code = 0
    err = ""
}

func trim_cr(s) (o) {
    o = s
    if len(o) > 0 && substr(o, len(o)-1, len(o)) == "\r" { o = substr(o, 0, len(o)-1) }
}

// norm_date — accept "YYYY-MM-DD…" (first 10 chars) or "DD/MM/YYYY…" (fr exports);
// anything else is "" (the row is skipped and counted, never guessed).
func norm_date(s) (d) {
    d = ""
    t := trim(s)
    if len(t) >= 10 && substr(t, 4, 5) == "-" { d = substr(t, 0, 10)  return d }
    if len(t) >= 10 && substr(t, 2, 3) == "/" && substr(t, 5, 6) == "/" {
        d = substr(t, 6, 10) + "-" + substr(t, 3, 5) + "-" + substr(t, 0, 2)
        return d
    }
}

// ── stats + tax radar ───────────────────────────────────────────────────────

// kind_sums — signed per-kind totals for a date range (the one query both stats and
// tax build on). Kinds with no txs are absent from the result.
func kind_sums(db, dfrom, dto) (kinds) {
    rows := sqlite_query(db, "SELECT s.kind AS kind, SUM(t.cents) AS total, COUNT(*) AS n FROM txs t JOIN streams s ON s.id=t.stream_id WHERE t.date>=? AND t.date<=? GROUP BY s.kind ORDER BY s.kind", []string{dfrom, dto})
    kinds = parse(rows, []Kindrow{})
}

// kind_get — the sum for one kind, 0 when absent.
func kind_get(kinds, k) (v) {
    v = 0
    i := 0
    for i < len(kinds) {
        if kinds[i].kind == k { v = kinds[i].total  return v }
        i = i + 1
    }
}

// kind_n — the tx count for one kind, 0 when absent.
func kind_n(kinds, k) (v) {
    v = 0
    i := 0
    for i < len(kinds) {
        if kinds[i].kind == k { v = kinds[i].n  return v }
        i = i + 1
    }
}

type Streamsumrow struct { name string  total int }

// stream_sums_by_kind — per-stream signed totals for one kind in a date range. Used
// to apply the 10% frais abattement per salary stream (each member of the foyer gets
// their own abattement, art. 83 CGI). Returns []Streamsumrow.
func stream_sums_by_kind(db, dfrom, dto, kind) (rows) {
    r := sqlite_query(db, "SELECT s.name AS name, SUM(t.cents) AS total FROM txs t JOIN streams s ON s.id=t.stream_id WHERE t.date>=? AND t.date<=? AND s.kind=? GROUP BY s.id ORDER BY s.name", []string{dfrom, dto, kind})
    rows = parse(r, []Streamsumrow{})
}

// cmd_stats — per-kind signed totals for a year (the human-readable radar input).
func stats_json(db, year) (out, code, err) {
    kinds := kind_sums(db, year+"-01-01", year+"-12-31")
    out = "{\"ok\":true,\"year\":" + year + ",\"by_kind\":{"
    first := 1
    income := 0
    expense := 0
    count := 0
    i := 0
    for i < len(kinds) {
        k := kinds[i]
        if first == 0 { out = out + "," }
        out = out + "\"" + esc(k.kind) + "\":{\"cents\":" + str(k.total) + ",\"eur\":\"" + fmt_cents(k.total) + "\",\"tx\":" + str(k.n) + "}"
        first = 0
        if k.total > 0 { income = income + k.total } else { expense = expense + k.total }
        count = count + k.n
        i = i + 1
    }
    out = out + "},\"income_cents\":" + str(income) + ",\"expense_cents\":" + str(expense) + ",\"net_cents\":" + str(income+expense) + ",\"net_eur\":\"" + fmt_cents(income+expense) + "\",\"tx_count\":" + str(count) + "}"
    code = 0
    err = ""
}

// deficit_carried — the BNC/BIC deficit carried forward into `year`. Scans the prior
// 6 years (the legal carry-forward window for IR-regime deficits), tracks a running
// pool: a negative net adds to the pool, a positive net uses it up (FIFO, oldest
// first). Returns the available deficit in cents (0 if none). Computed, not stored.
// NOTE: micro-BNC/BIC cannot legally generate deficits (forfaitaire abattement) — this
// is a régime-réel feature exposed for agents who track both; the radar applies it to
// the gross before the abattement as a v1 simplification.
func deficit_carried(db, year, kind) (deficit) {
    deficit = 0
    yi := parse_int(year)
    i := 6
    for i > 0 {
        py := yi - i
        pys := str(py)
        sums := kind_sums(db, pys+"-01-01", pys+"-12-31")
        net := kind_get(sums, kind)
        if net < 0 { deficit = deficit + (-net) }
        if net > 0 { deficit = deficit - net  if deficit < 0 { deficit = 0 } }
        i = i - 1
    }
    if deficit < 0 { deficit = 0 }
}

// ard_stock — LMNP amortissements réputés différés (art. 39 C II.2 CGI). The
// ARD stock is the cumulative amortissement that exceeded the plafond in prior
// years, reportable sans limite de durée. Unlike deficit_carried (6y), ARD has
// no time limit. The radar computes the stock by walking prior years: each
// year, if the loyer net (g_lmnp_reel) was positive, the dotation was capped at
// it and the excess was added to the stock; if the loyer net was negative, the
// full dotation brute was deferred. The stock is consumed when a future year's
// plafond exceeds the dotation brute (the surplus consumes ARD). Returns the
// available ARD stock in cents (0 if none). Source: BOFiP BOI-BIC-AMT-20-40-10.
func ard_stock(db, year) (stock) {
    stock = 0
    yi := parse_int(year)
    i := 10
    for i > 0 {
        py := yi - i
        pys := str(py)
        sums := kind_sums(db, pys+"-01-01", pys+"-12-31")
        g_reel := kind_get(sums, "lmnp_reel")
        // Compute the dotation brute for that year (same component formula)
        pv := rule_int(db, pys, "lmnp_amortissement", "property_value_cents", 0)
        if pv == 0 { i = i - 1  continue }
        tp := rule_int(db, pys, "lmnp_amortissement", "terrain_pct_tenths", 150)
        mv := rule_int(db, pys, "lmnp_amortissement", "mobilier_value_cents", 0)
        md := rule_int(db, pys, "lmnp_amortissement", "mobilier_duration_years", 7)
        gp := rule_int(db, pys, "lmnp_amortissement", "gros_oeuvre_pct_tenths", 550)
        gd := rule_int(db, pys, "lmnp_amortissement", "gros_oeuvre_duration_years", 50)
        top := rule_int(db, pys, "lmnp_amortissement", "toiture_pct_tenths", 120)
        tod := rule_int(db, pys, "lmnp_amortissement", "toiture_duration_years", 30)
        rep := rule_int(db, pys, "lmnp_amortissement", "reseaux_pct_tenths", 130)
        red := rule_int(db, pys, "lmnp_amortissement", "reseaux_duration_years", 25)
        agp := rule_int(db, pys, "lmnp_amortissement", "agencements_pct_tenths", 200)
        agd := rule_int(db, pys, "lmnp_amortissement", "agencements_duration_years", 12)
        building := pv * (1000 - tp) / 1000
        dotation := 0
        if gd > 0 { dotation = dotation + building * gp / 1000 / gd }
        if tod > 0 { dotation = dotation + building * top / 1000 / tod }
        if red > 0 { dotation = dotation + building * rep / 1000 / red }
        if agd > 0 { dotation = dotation + building * agp / 1000 / agd }
        if md > 0 { dotation = dotation + mv / md }
        plafond := 0
        if g_reel > 0 { plafond = g_reel }
        if dotation > plafond {
            stock = stock + (dotation - plafond)
        } else {
            // Surplus plafond consumes prior ARD stock
            consume := plafond - dotation
            if consume > stock { consume = stock }
            stock = stock - consume
        }
        i = i - 1
    }
    if stock < 0 { stock = 0 }
}

// bareme_on_quotient — the 5-bracket progressive scale applied to one quotient (the
// net imposable divided by parts). Returns the IR for ONE part at that quotient, plus
// the marginal rate tenths. The caller multiplies by parts. Brackets are DATA.
func bareme_on_quotient(db, year, q) (ir, marginal) {
    ir = 0
    marginal = 0
    t2 := rule_int(db, year, "ir_bareme", "bracket_2_threshold_cents", 1149700)
    r2 := rule_int(db, year, "ir_bareme", "bracket_2_rate_tenths", 110)
    t3 := rule_int(db, year, "ir_bareme", "bracket_3_threshold_cents", 2931500)
    r3 := rule_int(db, year, "ir_bareme", "bracket_3_rate_tenths", 300)
    t4 := rule_int(db, year, "ir_bareme", "bracket_4_threshold_cents", 8382300)
    r4 := rule_int(db, year, "ir_bareme", "bracket_4_rate_tenths", 410)
    t5 := rule_int(db, year, "ir_bareme", "bracket_5_threshold_cents", 18029400)
    r5 := rule_int(db, year, "ir_bareme", "bracket_5_rate_tenths", 450)
    hi := t3
    if q < hi { hi = q }
    if hi > t2 { ir = ir + (hi - t2) * r2 / 1000  marginal = r2 }
    hi = t4
    if q < hi { hi = q }
    if hi > t3 { ir = ir + (hi - t3) * r3 / 1000  marginal = r3 }
    hi = t5
    if q < hi { hi = q }
    if hi > t4 { ir = ir + (hi - t4) * r4 / 1000  marginal = r4 }
    if q > t5 { ir = ir + (q - t5) * r5 / 1000  marginal = r5 }
}

// ifi_bareme — progressive IFI barème (art. 977 CGI). 6 brackets from 800k to
// 10M+. Rates are in hundredths of a percent (0.5% = 50). Returns IFI in cents
// (before décote).
func ifi_bareme(p, b1t, b1r, b2t, b2r, b3t, b3r, b4t, b4r, b5t, b5r) (ifi) {
    ifi = 0
    if p > b1t { ifi = ifi + (p_min(p, b2t) - b1t) * b1r / 10000 }
    if p > b2t { ifi = ifi + (p_min(p, b3t) - b2t) * b2r / 10000 }
    if p > b3t { ifi = ifi + (p_min(p, b4t) - b3t) * b3r / 10000 }
    if p > b4t { ifi = ifi + (p_min(p, b5t) - b4t) * b4r / 10000 }
    if p > b5t { ifi = ifi + (p - b5t) * b5r / 10000 }
}

// p_min — min helper for the IFI barème.
func p_min(a, b) (m) {
    m = a
    if b < a { m = b }
}

// ir_compute — progressive IR barème + plafonnement du quotient familial + décote.
// Quotient familial uses demi-parts (integer): 1 part = 2 demi-parts, couple + 1 child
// = 5 demi-parts. Falls back to `parts`×2 when `demi_parts` is unset (0). Plafonnement
// (art. 197 CGI I.2): the tax advantage from demi-parts beyond the base (1 part
// célibataire / 2 couple) is capped at 1,791 EUR per demi-part (2024 income). Then the
// décote (art. 197 CGI 4°I). Returns (ir_after_decote, marginal, demi_parts, decote, qf_cap_applied).
func ir_compute(db, year, base) (ir, marginal, demi_parts, decote, qf_capped) {
    demi_parts = rule_int(db, year, "ir_bareme", "demi_parts", 0)
    if demi_parts == 0 {
        p := rule_int(db, year, "ir_bareme", "parts", 1)
        if p < 1 { p = 1 }
        demi_parts = p * 2
    }
    if demi_parts < 2 { demi_parts = 2 }
    base_parts := rule_int(db, year, "ir_bareme", "base_parts", 1)
    if base_parts < 1 { base_parts = 1 }
    base_demi := base_parts * 2
    // IR with QF: barème on (base × 2 / demi_parts), multiplied back by demi_parts / 2.
    q := base * 2 / demi_parts
    ir_on_q, m := bareme_on_quotient(db, year, q)
    ir = ir_on_q * demi_parts / 2
    marginal = m
    decote = 0
    qf_capped = 0
    // Plafonnement du quotient familial (art. 197 CGI I.2): compare IR with QF vs IR
    // at the base parts; if the advantage exceeds the cap, recompute IR = IR_base - cap.
    // The cap depends on the 'situation' rule (art. 197 IV/V CGI — special caps for
    // parent isolé, veuf, personne-seule invalide/ancien combattant).
    extra_demi := demi_parts - base_demi
    if extra_demi > 0 {
        q_base := base * 2 / base_demi
        ir_base_on_q, _ := bareme_on_quotient(db, year, q_base)
        ir_base := ir_base_on_q * base_demi / 2
        advantage := ir_base - ir
        situation := rule_str(db, year, "ir_bareme", "situation", "default")
        cap := 0
        if situation == "parent_isole" {
            // art. 197 IV CGI: fixed total cap on the parent-isolé majoration.
            cap = rule_int(db, year, "ir_bareme", "qf_parent_isole_cap_cents", 426200)
        } else if situation == "veuf" {
            // art. 197 V CGI: per-demi-part cap + complementary reduction.
            cap_per := rule_int(db, year, "ir_bareme", "qf_veuf_cap_per_demi_part_cents", 180700)
            complementary := rule_int(db, year, "ir_bareme", "qf_veuf_complementary_cents", 201100)
            cap = extra_demi * cap_per + complementary
        } else if situation == "personne_seule_invalide" {
            // anciens combattants / invalides: single demi-part, 1807 + 1801 = 3608.
            cap = rule_int(db, year, "ir_bareme", "qf_personne_seule_invalide_cap_cents", 360800)
        } else {
            cap_per := rule_int(db, year, "ir_bareme", "qf_cap_per_demi_part_cents", 179100)
            cap = extra_demi * cap_per
        }
        if advantage > cap {
            ir = ir_base - cap
            if ir < 0 { ir = 0 }
            qf_capped = 1
        }
    }
    // décote (art. 197 CGI 4°I): plafond - coeff × IR, when the result is positive.
    plafond := rule_int(db, year, "ir_bareme", "decote_plafond_cents", 88900)
    coeff := rule_int(db, year, "ir_bareme", "decote_coefficient_milliemes", 4525)
    if ir > 0 && coeff > 0 {
        decote = plafond - ir * coeff / 10000
        if decote > 0 {
            ir = ir - decote
            if ir < 0 { ir = 0 }
        } else {
            decote = 0
        }
    }
}

// tax_json — the tax radar: deterministic regime math over the year's sums. Every rate
// comes from tax_rules (rule_int), never from code, so a loi de finances change is an
// UPDATE, not a release. Estimates only — the décote and the 10% frais abattement on
// salary are v1; the progressive IR barème IS computed here (net imposable -> brackets).
func tax_json(db, year) (out, code, err) {
    // a deterministic tool must never answer with the wrong year's rates: if no
    // rate card exists for the requested year, error instead of silently falling
    // back to the seeded defaults (a cold agent would trust the plausible JSON).
    nrows := sqlite_query(db, "SELECT COUNT(*) AS n FROM tax_rules WHERE year=CAST(? AS INTEGER)", []string{year})
    nr := parse(nrows, []Countrow{})
    if len(nr) == 0 || nr[0].n == 0 {
        return "", 94, "no rate card for year " + year + " (seeded: " + str(current_year()) + ") — add one first: bilan rule set " + year + " micro_bnc deduction_pct_tenths 340"
    }
    kinds := kind_sums(db, year+"-01-01", year+"-12-31")
    g_bnc := kind_get(kinds, "bnc")
    g_bic := kind_get(kinds, "bic")
    g_rent := kind_get(kinds, "rent")
    g_rent_reel := kind_get(kinds, "foncier_reel")
    g_lmnp := kind_get(kinds, "lmnp")
    g_lmnp_reel := kind_get(kinds, "lmnp_reel")
    g_frais_garde := kind_get(kinds, "frais_garde")
    g_scolarite := kind_get(kinds, "scolarite")
    g_pension := kind_get(kinds, "pension_alimentaire")
    g_ir_pme := kind_get(kinds, "ir_pme")
    g_per := kind_get(kinds, "per")
    g_fcpi_fip := kind_get(kinds, "fcpi_fip")
    g_sofica := kind_get(kinds, "sofica")
    g_forest := kind_get(kinds, "forest")
    g_pv_immo := kind_get(kinds, "plus_value_immo")
    g_ifi := kind_get(kinds, "ifi_patrimoine")
    g_heures_sup := kind_get(kinds, "heures_sup")
    g_monument_historique := kind_get(kinds, "monument_historique")
    g_crypto := kind_get(kinds, "crypto")
    g_trade := kind_get(kinds, "trading")
    g_div := kind_get(kinds, "dividends")
    g_salary := kind_get(kinds, "salary")
    rate_ded_bnc := rule_int(db, year, "micro_bnc", "deduction_pct_tenths", 340)
    rate_soc_bnc := rule_int(db, year, "micro_bnc", "social_pct_tenths", 246)
    rate_ded_bic := rule_int(db, year, "micro_bic_services", "deduction_pct_tenths", 500)
    rate_soc_bic := rule_int(db, year, "micro_bic_services", "social_pct_tenths", 212)
    rate_ded_fon := rule_int(db, year, "micro_foncier", "deduction_pct_tenths", 300)
    rate_soc_fon := rule_int(db, year, "micro_foncier", "social_pct_tenths", 172)
    rate_pfu := rule_int(db, year, "capital", "pfu_pct_tenths", 314)
    thr := rule_int(db, year, "capital", "crypto_exempt_threshold_cents", 30500)
    // deficits carried forward (BNC/BIC, 6-year window, computed from history)
    def_bnc := deficit_carried(db, year, "bnc")
    def_bic := deficit_carried(db, year, "bic")
    adj_bnc := g_bnc - def_bnc
    if adj_bnc < 0 { adj_bnc = 0 }
    adj_bic := g_bic - def_bic
    if adj_bic < 0 { adj_bic = 0 }
    ab_bnc := adj_bnc * rate_ded_bnc / 1000
    soc_bnc := adj_bnc * rate_soc_bnc / 1000
    net_bnc := adj_bnc - ab_bnc
    ab_bic := adj_bic * rate_ded_bic / 1000
    soc_bic := adj_bic * rate_soc_bic / 1000
    net_bic := adj_bic - ab_bic
    // LMNP micro-BIC meublé (art. 50 CGI). Same 50% abattement as BIC services, but
    // a different threshold (77,700 EUR for 2024 income). The deficit carry-forward
    // uses the same 6y window as BNC/BIC. Source: BOFiP BOI-BIC-DECLA-10.
    def_lmnp := deficit_carried(db, year, "lmnp")
    adj_lmnp := g_lmnp - def_lmnp
    if adj_lmnp < 0 { adj_lmnp = 0 }
    rate_ded_lmnp := rule_int(db, year, "lmnp", "deduction_pct_tenths", 500)
    rate_soc_lmnp := rule_int(db, year, "lmnp", "social_pct_tenths", 172)
    ab_lmnp := adj_lmnp * rate_ded_lmnp / 1000
    soc_lmnp := adj_lmnp * rate_soc_lmnp / 1000
    net_lmnp := adj_lmnp - ab_lmnp
    // LMNP régime réel (art. 39 CGI). net = loyer (positive txs) - charges (negative
    // txs: intérêts d'emprunt, taxe foncière, frais de gestion, amortissement) with
    // NO 50% abattement. The deficit carries forward 6y (like BNC/BIC, NOT 10y like
    // foncier). Source: BOFiP BOI-BIC-DECLA-10, BOI-BIC-BASE-10.
    def_lmnp_reel := deficit_carried(db, year, "lmnp_reel")
    adj_lmnp_reel := g_lmnp_reel - def_lmnp_reel
    if adj_lmnp_reel < 0 { adj_lmnp_reel = 0 }
    rate_soc_lmnp_reel := rule_int(db, year, "lmnp_reel", "social_pct_tenths", 172)
    // Régime réel: net = signed sum (positive loyer - negative charges). No
    // abattement. Social 17.2% on net if positive. If negative, deficit carries 6y
    // (handled by deficit_carried on future years — no global imputation like foncier).
    net_lmnp_reel := 0
    soc_lmnp_reel := 0
    lmnp_reel_note := ""
    if g_lmnp_reel >= 0 {
        net_lmnp_reel = g_lmnp_reel
        soc_lmnp_reel = g_lmnp_reel * rate_soc_lmnp_reel / 1000
        lmnp_reel_note = "régime réel LMNP (art. 39 CGI): net = loyer - charges - amortissement, no abattement"
    } else {
        // Deficit: carried 6y via deficit_carried (no 10700 global imputation — that's
        // foncier-only). Current-year deficit reduces this year's net to 0.
        net_lmnp_reel = 0
        lmnp_reel_note = "régime réel LMNP (art. 39 CGI): déficit — carry 6y (no global imputation, foncier-only)"
    }
    // foncier: micro-foncier abattement when positive; déficit foncier imputation on
    // revenu global (art. 156 CGI I.3°) when negative — up to 10,700 EUR/year reduces
    // the IR base, the excess carries 10y on revenus fonciers. Régime réel feature
    // applied to the micro base as a v1 simplification.
    // RÉGIME RÉEL FONCIER (art. 29-31 CGI): if a 'foncier_reel' stream exists, the
    // radar combines micro + réel: micro-foncier (rent stream) with 30% abattement,
    // PLUS réel (foncier_reel stream) = loyer - charges (intérêts d'emprunt, travaux,
    // etc.) with NO abattement. The net réel can be negative (deficit) — same 10,700
    // imputation + 10y carry. Source: BOFiP BOI-RFPI-BASE-20-80.
    foncier_global_imputation := 0
    foncier_carry_excess := 0
    ab_fon := 0
    net_fon := 0
    soc_fon := 0
    foncier_reel_net := 0
    foncier_reel_note := ""
    if g_rent_reel != 0 {
        // Régime réel: net = signed sum (positive loyer - negative charges). No
        // abattement. Social 17.2% on net if positive.
        foncier_reel_net = g_rent_reel
        rate_soc_fon_reel := rule_int(db, year, "foncier_reel", "social_pct_tenths", 172)
        if foncier_reel_net >= 0 {
            soc_fon = soc_fon + foncier_reel_net * rate_soc_fon_reel / 1000
            net_fon = net_fon + foncier_reel_net
            foncier_reel_note = "régime réel foncier (art. 29-31 CGI): net = loyer - charges, no abattement"
        } else {
            // Déficit foncier réel: same 10,700 imputation + 10y carry as micro.
            deficit_reel := -foncier_reel_net
            foncier_cap := rule_int(db, year, "micro_foncier", "deficit_global_cap_cents", 1070000)
            imputation_reel := deficit_reel
            if imputation_reel > foncier_cap { imputation_reel = foncier_cap }
            foncier_global_imputation = foncier_global_imputation + imputation_reel
            foncier_carry_excess = foncier_carry_excess + (deficit_reel - imputation_reel)
            foncier_reel_note = "régime réel foncier (art. 29-31 CGI): déficit — 10700 on global + 10y carry"
        }
    }
    if g_rent >= 0 {
        ab_fon = g_rent * rate_ded_fon / 1000
        net_fon = net_fon + g_rent - ab_fon
        soc_fon = soc_fon + (g_rent - ab_fon) * rate_soc_fon / 1000
    } else {
        deficit_fon := -g_rent
        foncier_cap := rule_int(db, year, "micro_foncier", "deficit_global_cap_cents", 1070000)
        foncier_global_imputation = foncier_global_imputation + deficit_fon
        if foncier_global_imputation > foncier_cap { foncier_global_imputation = foncier_cap }
        foncier_carry_excess = foncier_carry_excess + (deficit_fon - foncier_cap)
    }
    crypto_exempt := 0
    if g_crypto >= 0 && g_crypto < thr { crypto_exempt = 1 }
    taxable := g_crypto + g_trade
    if taxable < 0 { taxable = 0 }
    cap_tax := taxable * rate_pfu / 1000
    div_tax := 0
    if g_div > 0 { div_tax = g_div * rate_pfu / 1000 }
    // Plus-values mobilières (art. 200 A CGI). PFU flat tax by default; option
    // for barème progressif (case 2OP). For titres acquired before 2018 with
    // the barème option, abattement durée de détention: 50% (2-8y), 65% (>8y).
    // The radar computes BOTH PFU and barème option and reports the lower.
    pvm_pfu_ir_rate := rule_int(db, year, "pvm", "pfu_ir_rate_pct_tenths", 128)
    pvm_pfu_social_rate := rule_int(db, year, "pvm", "pfu_social_rate_pct_tenths", 172)
    pvm_detention := rule_int(db, year, "pvm", "detention_years", 0)
    pvm_abat_2_8 := rule_int(db, year, "pvm", "abattement_2_8y_pct_tenths", 500)
    pvm_abat_8 := rule_int(db, year, "pvm", "abattement_8y_pct_tenths", 650)
    pvm_base := taxable + g_div
    if pvm_base < 0 { pvm_base = 0 }
    // Abattement fixe pour départ à la retraite des dirigeants (art. 150-0 D
    // ter CGI). Abattement de 500000 EUR sur les gains nets de cession de
    // titres de PME. Conditions: cession intégralité titres (ou >50% droits de
    // vote), détention ≥ 1 an, fonctions de direction 5 ans, détention ≥ 25%
    // droits. Prélèvements sociaux dus avant abattement (social on full gain,
    // IR on gain after abattement). Set: bilan rule set 2026 pvm_depart_retraite
    // eligible 1. Source: BOFiP BOI-RPPM-PVBMI-20-40-10.
    pvm_dr_eligible := rule_int(db, year, "pvm_depart_retraite", "eligible", 0)
    pvm_dr_abattement := rule_int(db, year, "pvm_depart_retraite", "abattement_fixe_cents", 50000000)
    pvm_dr_ir_base := pvm_base
    if pvm_dr_eligible == 1 {
        if pvm_dr_ir_base > pvm_dr_abattement { pvm_dr_ir_base = pvm_dr_ir_base - pvm_dr_abattement } else { pvm_dr_ir_base = 0 }
    }
    // PFU path: flat 12.8% IR + 17.2% social. Social on full gain (before
    // abattement); IR on gain after abattement if départ retraite eligible.
    pvm_pfu_ir := pvm_dr_ir_base * pvm_pfu_ir_rate / 1000
    pvm_pfu_social := pvm_base * pvm_pfu_social_rate / 1000
    pvm_pfu_total := pvm_pfu_ir + pvm_pfu_social
    // Barème option path: abattement on IR base only (not social). Apply
    // départ retraite abattement first, then détention abattement.
    pvm_abat_pct := 0
    if pvm_detention >= 2 && pvm_detention < 8 { pvm_abat_pct = pvm_abat_2_8 }
    if pvm_detention >= 8 { pvm_abat_pct = pvm_abat_8 }
    pvm_bareme_ir_base := pvm_dr_ir_base * (1000 - pvm_abat_pct) / 1000
    // Barème option: IR at marginal rate (simplified — use 30% as default TMI)
    pvm_bareme_ir_rate := rule_int(db, year, "pvm", "bareme_tmi_pct_tenths", 300)
    pvm_bareme_ir := pvm_bareme_ir_base * pvm_bareme_ir_rate / 1000
    pvm_bareme_social := pvm_base * pvm_pfu_social_rate / 1000
    pvm_bareme_total := pvm_bareme_ir + pvm_bareme_social
    // Choose the lower (optimal)
    pvm_optimal := "pfu"
    pvm_ir_tax := pvm_pfu_ir
    pvm_social_tax := pvm_pfu_social
    pvm_total_tax := pvm_pfu_total
    if pvm_bareme_total < pvm_pfu_total {
        pvm_optimal = "bareme"
        pvm_ir_tax = pvm_bareme_ir
        pvm_social_tax = pvm_bareme_social
        pvm_total_tax = pvm_bareme_total
    }
    // 10% frais abattement on salary (art. 83 CGI), applied PER STREAM (each member
    // of the foyer gets their own abattement: 10% of gross, min 509 / max 14555).
    frais_pct := rule_int(db, year, "salary", "frais_abattement_pct_tenths", 100)
    frais_min := rule_int(db, year, "salary", "frais_abattement_min_cents", 50900)
    frais_max := rule_int(db, year, "salary", "frais_abattement_max_cents", 1455500)
    salary_streams := stream_sums_by_kind(db, year+"-01-01", year+"-12-31", "salary")
    salary_frais := 0
    net_salary := 0
    si := 0
    for si < len(salary_streams) {
        sg := salary_streams[si].total
        sf := sg * frais_pct / 1000
        if sf < frais_min { sf = frais_min }
        if sf > frais_max { sf = frais_max }
        if sf > sg { sf = sg }
        salary_frais = salary_frais + sf
        net_salary = net_salary + sg - sf
        si = si + 1
    }
    // Heures supplémentaires (art. 81 quater CGI). Exonération d'IR up to 7,500
    // EUR/year (rémunération nette imposable). Record the net imposable amount
    // as a positive tx in a 'heures_sup' stream. The radar subtracts the exempt
    // amount (capped) from net_salary before ir_base. Source: BOFiP
    // BOI-RSA-CHAMP-20-50-20.
    hs_cap := rule_int(db, year, "heures_sup", "cap_cents", 750000)
    g_hs_pos := g_heures_sup
    if g_hs_pos < 0 { g_hs_pos = 0 }
    heures_sup_exemption := g_hs_pos
    if heures_sup_exemption > hs_cap { heures_sup_exemption = hs_cap }
    // heures sup are remuneration (added to net_salary) but exempt from IR up to
    // the cap. net_salary += heures_sup - exemption (excess above cap stays taxable).
    net_salary = net_salary + g_hs_pos - heures_sup_exemption
    // Pension alimentaire (art. 156 II.2° CGI). Deductible from revenu global
    // (reduces IR base, not IR directly). Capped at 6,794 EUR per child for 2024
    // income. The radar subtracts the capped pension from ir_base. Source: BOFiP
    // BOI-IR-BASE-20-30-10.
    pension_cap := rule_int(db, year, "pension_alimentaire", "cap_per_child_cents", 679400)
    g_pension_pos := g_pension
    if g_pension_pos < 0 { g_pension_pos = 0 }
    pension_deduction := g_pension_pos
    if pension_deduction > pension_cap { pension_deduction = pension_cap }
    // PER — plan épargne retraite. Two plafonds:
    // 1. art. 163 quatervicies (revenu global): 10% revenus N-1, capped at 8x
    //    PASS (35,194 EUR for 2024 income). Simplified: cap at the seeded value.
    // 2. art. 154 bis (TNS — revenu catégoriel BIC/BNC): 10% du bénéfice (limité
    //    à 8 PASS) + 15% de la fraction entre 1 et 8 PASS. Plancher 10% PASS.
    //    A single cotisation can't be deducted on both — the radar uses 154 bis
    //    when there is TNS income (net_bnc + net_bic > 0), else 163 quatervicies.
    //    Source: BOFiP BOI-IR-BASE-20-50.
    per_cap := rule_int(db, year, "per", "cap_cents", 3519400)
    g_per_pos := g_per
    if g_per_pos < 0 { g_per_pos = 0 }
    per_tns_rate := rule_int(db, year, "per_tns", "rate_pct_tenths", 100)
    per_tns_rate_sup := rule_int(db, year, "per_tns", "rate_sup_pct_tenths", 150)
    per_tns_pass_mult := rule_int(db, year, "per_tns", "pass_max_multiplier", 8)
    per_tns_plancher_rate := rule_int(db, year, "per_tns", "plancher_rate_pct_tenths", 100)
    pass_cents := rule_int(db, year, "global", "pass_cents", 439900)
    tns_benefice := net_bnc + net_bic
    if tns_benefice < 0 { tns_benefice = 0 }
    per_tns_plafond := 0
    per_tns_plancher := pass_cents * per_tns_plancher_rate / 1000
    if tns_benefice > 0 {
        benefice_capped := tns_benefice
        pass8 := pass_cents * per_tns_pass_mult
        if benefice_capped > pass8 { benefice_capped = pass8 }
        per_tns_plafond = benefice_capped * per_tns_rate / 1000
        if benefice_capped > pass_cents {
            per_tns_plafond = per_tns_plafond + (benefice_capped - pass_cents) * per_tns_rate_sup / 1000
        }
        if per_tns_plafond < per_tns_plancher { per_tns_plafond = per_tns_plancher }
    }
    per_effective_cap := per_cap
    per_regime := "163_quatervicies"
    if tns_benefice > 0 {
        per_effective_cap = per_tns_plafond
        per_regime = "154_bis"
    }
    per_deduction := g_per_pos
    if per_deduction > per_effective_cap { per_deduction = per_effective_cap }
    // PER TNS cumul — articles 154 bis + 163 quatervicies CGI. A TNS can
    // cumulate both ceilings for the same year (if no prior versements). The
    // same cotisation can't be deducted twice. The radar computes the combined
    // ceiling = 154 bis plafond + 163 quatervicies cap (on revenus N-1).
    // Source: BOFiP BOI-RPPM-RCM-20-20.
    pc_revenus_n1 := rule_int(db, year, "per_cumul", "revenus_n1_cents", 0)
    pc_pass_n := rule_int(db, year, "per_cumul", "pass_n_cents", 4636700)
    pc_pass_n1 := rule_int(db, year, "per_cumul", "pass_n1_cents", 4399200)
    // 163 quatervicies cap on revenus N-1: 10% of revenus N-1, capped at 8 PASS
    // N-1, plancher 10% PASS N-1
    pc_163_cap := 0
    if pc_revenus_n1 > 0 {
        rev_capped := pc_revenus_n1
        pass8_n1 := pc_pass_n1 * 8
        if rev_capped > pass8_n1 { rev_capped = pass8_n1 }
        pc_163_cap = rev_capped / 10
        pc_163_plancher := pc_pass_n1 / 10
        if pc_163_cap < pc_163_plancher { pc_163_cap = pc_163_plancher }
    } else {
        pc_163_cap = pc_pass_n1 / 10
    }
    // Combined ceiling = 154 bis plafond + 163 quatervicies cap
    pc_combined_ceiling := per_tns_plafond + pc_163_cap
    // Monuments historiques (art. 156 I-3° et II-1° ter CGI). Déduction des
    // charges foncières du revenu global — 100% if open to public, 50%
    // otherwise. No cap (hors plafonnement global des niches). 15-year
    // conservation engagement. Record charges as negative txs in a
    // 'monument_historique' stream. Source: BOFiP BOI-IR-BASE-20-40.
    mh_ouvert := rule_int(db, year, "monuments_historiques", "ouvert_public", 0)
    mh_taux := rule_int(db, year, "monuments_historiques", "taux_ferme_pct_tenths", 500)
    if mh_ouvert == 1 { mh_taux = rule_int(db, year, "monuments_historiques", "taux_ouvert_public_pct_tenths", 1000) }
    mh_charges := -g_monument_historique
    if mh_charges < 0 { mh_charges = 0 }
    mh_deduction := mh_charges * mh_taux / 1000
    // Démembrement — barème de l'usufruit viager (art. 669 CGI). Valeur de
    // l'usufruit selon l'âge de l'usufruitier. La nue-propriété vaut le
    // complément à 100%. The radar reports the valuation for a given age and
    // pleine-propriété value (informational — for DMTG/IFI planning).
    dem_age := rule_int(db, year, "demembrement", "usufruitier_age", 0)
    dem_usufruit_pct := 0
    if dem_age < 21 { dem_usufruit_pct = rule_int(db, year, "demembrement", "age_max_21_usufruit_pct_tenths", 900) }
    if dem_age >= 21 && dem_age < 31 { dem_usufruit_pct = rule_int(db, year, "demembrement", "age_21_30_usufruit_pct_tenths", 800) }
    if dem_age >= 31 && dem_age < 41 { dem_usufruit_pct = rule_int(db, year, "demembrement", "age_31_40_usufruit_pct_tenths", 700) }
    if dem_age >= 41 && dem_age < 51 { dem_usufruit_pct = rule_int(db, year, "demembrement", "age_41_50_usufruit_pct_tenths", 600) }
    if dem_age >= 51 && dem_age < 61 { dem_usufruit_pct = rule_int(db, year, "demembrement", "age_51_60_usufruit_pct_tenths", 500) }
    if dem_age >= 61 && dem_age < 71 { dem_usufruit_pct = rule_int(db, year, "demembrement", "age_61_70_usufruit_pct_tenths", 400) }
    if dem_age >= 71 && dem_age < 81 { dem_usufruit_pct = rule_int(db, year, "demembrement", "age_71_80_usufruit_pct_tenths", 300) }
    if dem_age >= 81 && dem_age < 91 { dem_usufruit_pct = rule_int(db, year, "demembrement", "age_81_90_usufruit_pct_tenths", 200) }
    if dem_age >= 91 { dem_usufruit_pct = rule_int(db, year, "demembrement", "age_91_plus_usufruit_pct_tenths", 100) }
    dem_nue_propriete_pct := 1000 - dem_usufruit_pct
    // Quasi-usufruit — article 774 bis CGI (loi de finances 2024). Dettes de
    // restitution on sums of money whose deceased reserved the usufruit are
    // NOT deductible from the actif successoral, with exceptions: (1) dettes
    // on cession price of a bien (if not principally tax-motivated), (2)
    // usufruits légaux art. 757/1094-1 C. civ. (conjoint survivant). The radar
    // computes the deductible portion of the créance de restitution. Source:
    // BOFiP BOI-ENR-DMTG-10-40-20-20.
    qu_creance := rule_int(db, year, "quasi_usufruit", "creance_restitution_cents", 0)
    qu_exc_cession := rule_int(db, year, "quasi_usufruit", "exception_cession_non_fiscal", 0)
    qu_exc_conjoint := rule_int(db, year, "quasi_usufruit", "exception_usufruit_legal_conjoint", 0)
    qu_deductible := qu_creance
    qu_note := "déductible (no exception triggered)"
    if qu_exc_cession == 1 || qu_exc_conjoint == 1 {
        qu_deductible = qu_creance
        qu_note = "déductible (exception art. 774 bis I: cession non-fiscal OR usufruit légal conjoint)"
    } else {
        qu_deductible = 0
        qu_note = "non-déductible (art. 774 bis I — quasi-usufruit de sommes)"
    }
    // DMTG — droits de mutation à titre gratuit (art. 777 CGI). Barème by
    // degree of parenté. The radar computes DMTG on the actif taxable (after
    // abattement) for the configured degré. For the non-deductible quasi-usufruit
    // créance (art. 774 bis II), DMTG is calculated by degree of parenté between
    // nu-propriétaire and usufruitier. Source: BOFiP BOI-ENR-DMTG-20-30.
    dmtg_actif := rule_int(db, year, "dmtg", "actif_taxable_cents", 0)
    dmtg_degre := rule_str(db, year, "dmtg", "degre_parente", "ligne_directe")
    dmtg_abattement := 0
    dmtg_tax := 0
    if dmtg_degre == "ligne_directe" {
        dmtg_abattement = rule_int(db, year, "dmtg", "ligne_directe_abattement_cents", 10000000)
        dmtg_base := dmtg_actif - dmtg_abattement
        if dmtg_base < 0 { dmtg_base = 0 }
        // Progressive brackets: 5/10/15/20/30/40/45%
        dmtg_tax = 0
        bi := 7
        prev_thresh := 0
        for bi >= 1 {
            thresh := rule_int(db, year, "dmtg", "ligne_directe_bracket_" + str(bi) + "_threshold_cents", 0)
            rate := rule_int(db, year, "dmtg", "ligne_directe_bracket_" + str(bi) + "_rate_pct_tenths", 0)
            hi := dmtg_base
            if hi > thresh { hi = thresh }
            if hi > prev_thresh { dmtg_tax = dmtg_tax + (hi - prev_thresh) * rate / 1000 }
            prev_thresh = thresh
            if dmtg_base <= thresh { bi = 0 } else { bi = bi - 1 }
        }
    } else if dmtg_degre == "conjoint" {
        dmtg_abattement = rule_int(db, year, "dmtg", "conjoint_abattement_cents", 8000000)
        // Conjoint: exonération totale (successions depuis 22/08/2007)
        dmtg_tax = 0
    } else if dmtg_degre == "frere_soeur" {
        dmtg_abattement = rule_int(db, year, "dmtg", "frere_soeur_abattement_cents", 1593200)
        dmtg_base := dmtg_actif - dmtg_abattement
        if dmtg_base < 0 { dmtg_base = 0 }
        // 35% < 24430, 45% >
        t1 := rule_int(db, year, "dmtg", "frere_soeur_bracket_1_threshold_cents", 0)
        r1 := rule_int(db, year, "dmtg", "frere_soeur_bracket_1_rate_pct_tenths", 350)
        t2 := rule_int(db, year, "dmtg", "frere_soeur_bracket_2_threshold_cents", 2443000)
        r2 := rule_int(db, year, "dmtg", "frere_soeur_bracket_2_rate_pct_tenths", 450)
        hi := dmtg_base
        if hi > t2 { hi = t2 }
        if hi > t1 { dmtg_tax = dmtg_tax + (hi - t1) * r1 / 1000 }
        if dmtg_base > t2 { dmtg_tax = dmtg_tax + (dmtg_base - t2) * r2 / 1000 }
    } else if dmtg_degre == "quatrieme_degre" {
        dmtg_abattement = rule_int(db, year, "dmtg", "frere_soeur_abattement_cents", 1593200)
        dmtg_base := dmtg_actif - dmtg_abattement
        if dmtg_base < 0 { dmtg_base = 0 }
        rate := rule_int(db, year, "dmtg", "quatrieme_degre_rate_pct_tenths", 550)
        dmtg_tax = dmtg_base * rate / 1000
    } else if dmtg_degre == "tiers" {
        dmtg_abattement = rule_int(db, year, "dmtg", "tiers_abattement_cents", 159400)
        dmtg_base := dmtg_actif - dmtg_abattement
        if dmtg_base < 0 { dmtg_base = 0 }
        rate := rule_int(db, year, "dmtg", "tiers_rate_pct_tenths", 600)
        dmtg_tax = dmtg_base * rate / 1000
    }
    // DMTG on non-deductible quasi-usufruit créance (art. 774 bis II)
    dmtg_qu_non_deductible := qu_creance - qu_deductible
    dmtg_qu_tax := 0
    if dmtg_qu_non_deductible > 0 {
        // Use the same degré/barème as the main DMTG
        dmtg_qu_base := dmtg_qu_non_deductible
        if dmtg_degre == "ligne_directe" {
            dmtg_qu_tax = 0
            bi := 7
            prev_thresh := 0
            for bi >= 1 {
                thresh := rule_int(db, year, "dmtg", "ligne_directe_bracket_" + str(bi) + "_threshold_cents", 0)
                rate := rule_int(db, year, "dmtg", "ligne_directe_bracket_" + str(bi) + "_rate_pct_tenths", 0)
                hi := dmtg_qu_base
                if hi > thresh { hi = thresh }
                if hi > prev_thresh { dmtg_qu_tax = dmtg_qu_tax + (hi - prev_thresh) * rate / 1000 }
                prev_thresh = thresh
                if dmtg_qu_base <= thresh { bi = 0 } else { bi = bi - 1 }
            }
        } else if dmtg_degre == "conjoint" {
            dmtg_qu_tax = 0
        } else if dmtg_degre == "frere_soeur" {
            t1 := rule_int(db, year, "dmtg", "frere_soeur_bracket_1_threshold_cents", 0)
            r1 := rule_int(db, year, "dmtg", "frere_soeur_bracket_1_rate_pct_tenths", 350)
            t2 := rule_int(db, year, "dmtg", "frere_soeur_bracket_2_threshold_cents", 2443000)
            r2 := rule_int(db, year, "dmtg", "frere_soeur_bracket_2_rate_pct_tenths", 450)
            hi := dmtg_qu_base
            if hi > t2 { hi = t2 }
            if hi > t1 { dmtg_qu_tax = dmtg_qu_tax + (hi - t1) * r1 / 1000 }
            if dmtg_qu_base > t2 { dmtg_qu_tax = dmtg_qu_tax + (dmtg_qu_base - t2) * r2 / 1000 }
        } else if dmtg_degre == "quatrieme_degre" {
            rate := rule_int(db, year, "dmtg", "quatrieme_degre_rate_pct_tenths", 550)
            dmtg_qu_tax = dmtg_qu_base * rate / 1000
        } else if dmtg_degre == "tiers" {
            rate := rule_int(db, year, "dmtg", "tiers_rate_pct_tenths", 600)
            dmtg_qu_tax = dmtg_qu_base * rate / 1000
        }
    }
    // Assurance-vie succession — article 990 I CGI (primes versées avant 70
    // ans). Prélèvement per bénéficiaire: abattement fixe 152500 EUR, puis 20%
    // on fraction ≤ 700000 EUR, 31.25% >. Independent of degree of parenté.
    // Source: BOFiP BOI-ENR-ASSUR-10.
    av_capital_avant_70 := rule_int(db, year, "assurance_vie", "capital_avant_70_cents", 0)
    av_abattement_990i := rule_int(db, year, "assurance_vie", "abattement_990i_cents", 15250000)
    av_base_990i := av_capital_avant_70 - av_abattement_990i
    if av_base_990i < 0 { av_base_990i = 0 }
    av_taux_1 := rule_int(db, year, "assurance_vie", "taux_990i_bracket_1_pct_hundredths", 2000)
    av_thresh_1 := rule_int(db, year, "assurance_vie", "taux_990i_bracket_1_threshold_cents", 0)
    av_taux_2 := rule_int(db, year, "assurance_vie", "taux_990i_bracket_2_pct_hundredths", 3125)
    av_thresh_2 := rule_int(db, year, "assurance_vie", "taux_990i_bracket_2_threshold_cents", 70000000)
    av_tax_990i := 0
    if av_base_990i > av_thresh_1 {
        hi := av_base_990i
        if hi > av_thresh_2 { hi = av_thresh_2 }
        av_tax_990i = av_tax_990i + (hi - av_thresh_1) * av_taux_1 / 10000
    }
    if av_base_990i > av_thresh_2 {
        av_tax_990i = av_tax_990i + (av_base_990i - av_thresh_2) * av_taux_2 / 10000
    }
    // Assurance-vie succession — article 757 B CGI (primes versées après 70
    // ans). Primes enter the succession and follow the DMTG barème (art. 777),
    // after a global abattement of 30500 EUR (shared among all beneficiaries).
    // Source: BOFiP BOI-ENR-ASSUR-20.
    av_primes_apres_70 := rule_int(db, year, "assurance_vie", "primes_apres_70_cents", 0)
    av_abattement_757b := rule_int(db, year, "assurance_vie", "abattement_757b_cents", 3050000)
    av_base_757b := av_primes_apres_70 - av_abattement_757b
    if av_base_757b < 0 { av_base_757b = 0 }
    // Apply the DMTG barème (same degré as configured for dmtg)
    av_tax_757b := 0
    if av_base_757b > 0 {
        if dmtg_degre == "ligne_directe" {
            bi := 7
            prev_thresh := 0
            for bi >= 1 {
                thresh := rule_int(db, year, "dmtg", "ligne_directe_bracket_" + str(bi) + "_threshold_cents", 0)
                rate := rule_int(db, year, "dmtg", "ligne_directe_bracket_" + str(bi) + "_rate_pct_tenths", 0)
                hi := av_base_757b
                if hi > thresh { hi = thresh }
                if hi > prev_thresh { av_tax_757b = av_tax_757b + (hi - prev_thresh) * rate / 1000 }
                prev_thresh = thresh
                if av_base_757b <= thresh { bi = 0 } else { bi = bi - 1 }
            }
        } else if dmtg_degre == "conjoint" {
            av_tax_757b = 0
        } else if dmtg_degre == "frere_soeur" {
            t1 := rule_int(db, year, "dmtg", "frere_soeur_bracket_1_threshold_cents", 0)
            r1 := rule_int(db, year, "dmtg", "frere_soeur_bracket_1_rate_pct_tenths", 350)
            t2 := rule_int(db, year, "dmtg", "frere_soeur_bracket_2_threshold_cents", 2443000)
            r2 := rule_int(db, year, "dmtg", "frere_soeur_bracket_2_rate_pct_tenths", 450)
            hi := av_base_757b
            if hi > t2 { hi = t2 }
            if hi > t1 { av_tax_757b = av_tax_757b + (hi - t1) * r1 / 1000 }
            if av_base_757b > t2 { av_tax_757b = av_tax_757b + (av_base_757b - t2) * r2 / 1000 }
        } else if dmtg_degre == "quatrieme_degre" {
            rate := rule_int(db, year, "dmtg", "quatrieme_degre_rate_pct_tenths", 550)
            av_tax_757b = av_base_757b * rate / 1000
        } else if dmtg_degre == "tiers" {
            rate := rule_int(db, year, "dmtg", "tiers_rate_pct_tenths", 600)
            av_tax_757b = av_base_757b * rate / 1000
        }
    }
    av_total_tax := av_tax_990i + av_tax_757b
    // Assurance-vie démembrement clause bénéficiaire — article 669 CGI
    // prorata. When the clause is démembrée (usufruitier + nus-propriétaires),
    // the abattement 990 I (152500) is réparti between usufruitier and NP
    // according to the art. 669 barème by age of usufruitier. The usufruitier
    // (conjoint) is exoneré, so only the NP share is taxed. Source: BOFiP
    // BOI-TCAS-AUT-60 §310.
    avd_eligible := rule_int(db, year, "assurance_vie", "demembrement_eligible", 0)
    avd_age := rule_int(db, year, "assurance_vie", "demembrement_usufruitier_age", 0)
    avd_np_count := rule_int(db, year, "assurance_vie", "demembrement_np_count", 0)
    avd_usufruit_pct := 0
    avd_nue_propriete_pct := 0
    if avd_eligible == 1 {
        // Reuse the existing demembrement art. 669 barème (stored as tenths)
        if avd_age <= 20 {
            avd_usufruit_pct = 900; avd_nue_propriete_pct = 100
        } else if avd_age <= 30 {
            avd_usufruit_pct = 800; avd_nue_propriete_pct = 200
        } else if avd_age <= 40 {
            avd_usufruit_pct = 700; avd_nue_propriete_pct = 300
        } else if avd_age <= 50 {
            avd_usufruit_pct = 600; avd_nue_propriete_pct = 400
        } else if avd_age <= 60 {
            avd_usufruit_pct = 500; avd_nue_propriete_pct = 500
        } else if avd_age <= 70 {
            avd_usufruit_pct = 400; avd_nue_propriete_pct = 600
        } else if avd_age <= 80 {
            avd_usufruit_pct = 300; avd_nue_propriete_pct = 700
        } else if avd_age <= 90 {
            avd_usufruit_pct = 200; avd_nue_propriete_pct = 800
        } else {
            avd_usufruit_pct = 100; avd_nue_propriete_pct = 900
        }
    }
    // NP share of capital (per NP): capital * NP% / np_count
    avd_np_share_cents := 0
    avd_np_abattement_cents := 0
    avd_np_taxable_cents := 0
    avd_np_tax_cents := 0
    if avd_eligible == 1 && avd_np_count > 0 {
        avd_np_share_cents = av_capital_avant_70 * avd_nue_propriete_pct / 1000 / avd_np_count
        // Abattement 990 I réparti by NP% (usufruitier exoneré, so full
        // abattement goes to NP share, divided by np_count)
        avd_np_abattement_cents = av_abattement_990i * avd_nue_propriete_pct / 1000 / avd_np_count
        avd_np_taxable_cents = avd_np_share_cents - avd_np_abattement_cents
        if avd_np_taxable_cents < 0 { avd_np_taxable_cents = 0 }
        // Apply 990 I brackets (20% < 700000, 31.25% >)
        if avd_np_taxable_cents > av_thresh_1 {
            hi := avd_np_taxable_cents
            if hi > av_thresh_2 { hi = av_thresh_2 }
            avd_np_tax_cents = avd_np_tax_cents + (hi - av_thresh_1) * av_taux_1 / 10000
        }
        if avd_np_taxable_cents > av_thresh_2 {
            avd_np_tax_cents = avd_np_tax_cents + (avd_np_taxable_cents - av_thresh_2) * av_taux_2 / 10000
        }
    }
    avd_total_np_tax_cents := avd_np_tax_cents * avd_np_count
    // Plus-values professionnelles de cession — article 151 septies CGI.
    // Exonération totale/partielle des PV de cession pour petites entreprises
    // (activité ≥ 5 ans, recettes < seuils). Source: BOFiP BOI-BIC-PVMV-40-10-10.
    pvp_pv := rule_int(db, year, "pv_pro", "plus_value_cents", 0)
    pvp_duree := rule_int(db, year, "pv_pro", "duree_activite_years", 0)
    pvp_recettes := rule_int(db, year, "pv_pro", "recettes_cents", 0)
    pvp_activite := rule_str(db, year, "pv_pro", "activite_type", "commerce")
    pvp_duree_min := rule_int(db, year, "pv_pro", "duree_minimum_years", 5)
    pvp_seuil_total := rule_int(db, year, "pv_pro", "seuil_exoneration_total_commerce_cents", 25000000)
    if pvp_activite == "artisanat" {
        pvp_seuil_total = rule_int(db, year, "pv_pro", "seuil_exoneration_total_artisanat_cents", 9000000)
    } else if pvp_activite == "liberal" {
        pvp_seuil_total = rule_int(db, year, "pv_pro", "seuil_exoneration_total_liberal_cents", 35000000)
    } else if pvp_activite == "agricole" {
        pvp_seuil_total = rule_int(db, year, "pv_pro", "seuil_exoneration_total_agricole_cents", 35000000)
    }
    pvp_eligible_151_septies := 0
    pvp_exoneration_pct := 0
    pvp_pv_exoneree := 0
    pvp_pv_imposable := pvp_pv
    if pvp_duree >= pvp_duree_min && pvp_recettes <= pvp_seuil_total {
        pvp_eligible_151_septies = 1
        pvp_exoneration_pct = 100
        pvp_pv_exoneree = pvp_pv
        pvp_pv_imposable = 0
    }
    // Note: exonération partielle (seuil_total < recettes <= seuil_partiel) not
    // modeled in v1 — radar reports eligibility for exonération totale only.
    // Plus-values professionnelles — article 151 septies B CGI. Abattement
    // de 10% par année de détention au-delà de la 5ème année, sur biens
    // immobiliers bâtis/non bâtis affectés à l'exploitation. Source: BOFiP
    // BOI-BIC-PVMV-40-10-20.
    pvp_bien_immo := rule_int(db, year, "pv_pro", "bien_immo_affecte", 0)
    pvp_detention := rule_int(db, year, "pv_pro", "duree_detention_years", 0)
    pvp_abat_pct := rule_int(db, year, "pv_pro", "abattement_151_septies_B_pct_tenths", 100)
    pvp_abat_plafond := rule_int(db, year, "pv_pro", "abattement_151_septies_B_duree_plafond_years", 10)
    pvp_abattement_151b_pct := 0
    pvp_pv_apres_abattement := pvp_pv_imposable
    if pvp_bien_immo == 1 && pvp_detention > 5 {
        annees_abat := pvp_detention - 5
        if annees_abat > pvp_abat_plafond { annees_abat = pvp_abat_plafond }
        // abat_pct is in tenths (100 = 10%), annees_abat * abat_pct = tenths of pct
        pvp_abattement_151b_pct = annees_abat * pvp_abat_pct
        pvp_pv_apres_abattement = pvp_pv_imposable * (1000 - pvp_abattement_151b_pct) / 1000
    }
    // DMTG donation — article 777 CGI. Same barème as succession for ligne
    // directe/frère-sœur/4e degré/tiers, but conjoint/PACS follows Tableau II
    // (NOT exoneré for donations). Abattement 789 bis: 500000 EUR sur donation
    // de fonds de commerce/entreprise individuelle. Source: BOFiP
    // BOI-ENR-DMTG-20-30.
    dd_actif := rule_int(db, year, "dmtg_donation", "actif_taxable_cents", 0)
    dd_degre := rule_str(db, year, "dmtg_donation", "degre_parente", "ligne_directe")
    dd_abattement := 0
    dd_tax := 0
    dd_789_bis_eligible := rule_int(db, year, "dmtg_donation", "abattement_789_bis_eligible", 0)
    dd_789_bis := 0
    if dd_789_bis_eligible == 1 {
        dd_789_bis = rule_int(db, year, "dmtg_donation", "abattement_789_bis_cents", 50000000)
    }
    dd_base := dd_actif - dd_789_bis
    if dd_base < 0 { dd_base = 0 }
    if dd_degre == "ligne_directe" {
        dd_abattement = rule_int(db, year, "dmtg", "ligne_directe_abattement_cents", 10000000)
        dd_base = dd_base - dd_abattement
        if dd_base < 0 { dd_base = 0 }
        bi := 7
        prev := 0
        for bi >= 1 {
            thresh := rule_int(db, year, "dmtg", "ligne_directe_bracket_" + str(bi) + "_threshold_cents", 0)
            rate := rule_int(db, year, "dmtg", "ligne_directe_bracket_" + str(bi) + "_rate_pct_tenths", 0)
            hi := dd_base
            if hi > thresh { hi = thresh }
            if hi > prev { dd_tax = dd_tax + (hi - prev) * rate / 1000 }
            prev = thresh
            if dd_base <= thresh { bi = 0 } else { bi = bi - 1 }
        }
    } else if dd_degre == "conjoint" {
        // Tableau II — conjoint NOT exoneré for donations
        dd_abattement = rule_int(db, year, "dmtg_donation", "conjoint_abattement_cents", 8072400)
        dd_base = dd_base - dd_abattement
        if dd_base < 0 { dd_base = 0 }
        bi := 7
        prev := 0
        for bi >= 1 {
            thresh := rule_int(db, year, "dmtg_donation", "conjoint_bracket_" + str(bi) + "_threshold_cents", 0)
            rate := rule_int(db, year, "dmtg_donation", "conjoint_bracket_" + str(bi) + "_rate_pct_tenths", 0)
            hi := dd_base
            if hi > thresh { hi = thresh }
            if hi > prev { dd_tax = dd_tax + (hi - prev) * rate / 1000 }
            prev = thresh
            if dd_base <= thresh { bi = 0 } else { bi = bi - 1 }
        }
    } else if dd_degre == "frere_soeur" {
        dd_abattement = rule_int(db, year, "dmtg", "frere_soeur_abattement_cents", 1593200)
        dd_base = dd_base - dd_abattement
        if dd_base < 0 { dd_base = 0 }
        t1 := rule_int(db, year, "dmtg", "frere_soeur_bracket_1_threshold_cents", 0)
        r1 := rule_int(db, year, "dmtg", "frere_soeur_bracket_1_rate_pct_tenths", 350)
        t2 := rule_int(db, year, "dmtg", "frere_soeur_bracket_2_threshold_cents", 2443000)
        r2 := rule_int(db, year, "dmtg", "frere_soeur_bracket_2_rate_pct_tenths", 450)
        hi := dd_base
        if hi > t2 { hi = t2 }
        if hi > t1 { dd_tax = dd_tax + (hi - t1) * r1 / 1000 }
        if dd_base > t2 { dd_tax = dd_tax + (dd_base - t2) * r2 / 1000 }
    } else if dd_degre == "quatrieme_degre" {
        dd_abattement = rule_int(db, year, "dmtg", "frere_soeur_abattement_cents", 1593200)
        dd_base = dd_base - dd_abattement
        if dd_base < 0 { dd_base = 0 }
        rate := rule_int(db, year, "dmtg", "quatrieme_degre_rate_pct_tenths", 550)
        dd_tax = dd_base * rate / 1000
    } else if dd_degre == "tiers" {
        dd_abattement = rule_int(db, year, "dmtg", "tiers_abattement_cents", 159400)
        dd_base = dd_base - dd_abattement
        if dd_base < 0 { dd_base = 0 }
        rate := rule_int(db, year, "dmtg", "tiers_rate_pct_tenths", 600)
        dd_tax = dd_base * rate / 1000
    }
    // Plus-values sur valeurs mobilières — articles 150-0 A et 150-0 D CGI.
    // Art. 150-0 A: gain net = prix cession - prix acquisition.
    // Art. 150-0 D 1 ter: abattement 50% >2 ans, 65% >8 ans (sociétés non-PME).
    // Art. 150-0 D 1 quater: abattement 50% >1 an, 75% >5 ans (PME).
    // Source: BOFiP BOI-RPPM-PVMC-20.
    pvmob_acq := rule_int(db, year, "pv_mobiliere", "prix_acquisition_cents", 0)
    pvmob_cession := rule_int(db, year, "pv_mobiliere", "prix_cession_cents", 0)
    pvmob_detention := rule_int(db, year, "pv_mobiliere", "duree_detention_years", 0)
    pvmob_is_pme := rule_int(db, year, "pv_mobiliere", "is_pme", 0)
    pvmob_gain := pvmob_cession - pvmob_acq
    if pvmob_gain < 0 { pvmob_gain = 0 }
    pvmob_abattement_pct := 0
    pvmob_gain_apres_abattement := pvmob_gain
    if pvmob_is_pme == 1 {
        // Art. 150-0 D 1 quater: 50% >1 an, 75% >5 ans
        if pvmob_detention >= 5 {
            pvmob_abattement_pct = rule_int(db, year, "pv_mobiliere", "abattement_1quater_5y_pct_tenths", 750)
        } else if pvmob_detention >= 1 {
            pvmob_abattement_pct = rule_int(db, year, "pv_mobiliere", "abattement_1quater_1y_pct_tenths", 500)
        }
    } else {
        // Art. 150-0 D 1 ter: 50% >2 ans, 65% >8 ans
        if pvmob_detention >= 8 {
            pvmob_abattement_pct = rule_int(db, year, "pv_mobiliere", "abattement_1ter_8y_pct_tenths", 650)
        } else if pvmob_detention >= 2 {
            pvmob_abattement_pct = rule_int(db, year, "pv_mobiliere", "abattement_1ter_2y_pct_tenths", 500)
        }
    }
    if pvmob_abattement_pct > 0 {
        pvmob_gain_apres_abattement = pvmob_gain * (1000 - pvmob_abattement_pct) / 1000
    }
    // DMTG handicap — article 779 II CGI. Abattement 159325 EUR cumulable
    // avec les autres abattements. Applies to both dmtg (succession) and
    // dmtg_donation. Source: BOFiP BOI-ENR-DMTG-10-50-20.
    dmtg_handicap_eligible := rule_int(db, year, "dmtg", "handicap_eligible", 0)
    dmtg_handicap_abattement := 0
    if dmtg_handicap_eligible == 1 {
        dmtg_handicap_abattement = rule_int(db, year, "dmtg", "handicap_abattement_cents", 15932500)
        // Recompute DMTG with handicap abattement added to the regular one
        dmtg_base_h := dmtg_actif - dmtg_abattement - dmtg_handicap_abattement
        if dmtg_base_h < 0 { dmtg_base_h = 0 }
        if dmtg_degre == "ligne_directe" {
            dmtg_tax = 0
            bi := 7
            prev := 0
            for bi >= 1 {
                thresh := rule_int(db, year, "dmtg", "ligne_directe_bracket_" + str(bi) + "_threshold_cents", 0)
                rate := rule_int(db, year, "dmtg", "ligne_directe_bracket_" + str(bi) + "_rate_pct_tenths", 0)
                hi := dmtg_base_h
                if hi > thresh { hi = thresh }
                if hi > prev { dmtg_tax = dmtg_tax + (hi - prev) * rate / 1000 }
                prev = thresh
                if dmtg_base_h <= thresh { bi = 0 } else { bi = bi - 1 }
            }
        } else if dmtg_degre == "frere_soeur" {
            dmtg_base_h = dmtg_actif - dmtg_abattement - dmtg_handicap_abattement
            if dmtg_base_h < 0 { dmtg_base_h = 0 }
            t1 := rule_int(db, year, "dmtg", "frere_soeur_bracket_1_threshold_cents", 0)
            r1 := rule_int(db, year, "dmtg", "frere_soeur_bracket_1_rate_pct_tenths", 350)
            t2 := rule_int(db, year, "dmtg", "frere_soeur_bracket_2_threshold_cents", 2443000)
            r2 := rule_int(db, year, "dmtg", "frere_soeur_bracket_2_rate_pct_tenths", 450)
            dmtg_tax = 0
            hi := dmtg_base_h
            if hi > t2 { hi = t2 }
            if hi > t1 { dmtg_tax = dmtg_tax + (hi - t1) * r1 / 1000 }
            if dmtg_base_h > t2 { dmtg_tax = dmtg_tax + (dmtg_base_h - t2) * r2 / 1000 }
        }
    }
    // Pacte Dutreil — article 787 B CGI. Abattement 75% sur la valeur de
    // l'entreprise transmise. Réduction 50% sur les droits restants si donateur
    // < 70 ans et donation en pleine propriété (art. 790). Source: BOFiP
    // BOI-ENR-DMTG-20-30-50.
    dmtg_dutreil_eligible := rule_int(db, year, "dmtg", "dutreil_eligible", 0)
    dmtg_dutreil_abattement_pct := 0
    dmtg_dutreil_reduction_pct := 0
    dmtg_dutreil_tax := dmtg_tax
    if dmtg_dutreil_eligible == 1 {
        dmtg_dutreil_abattement_pct = rule_int(db, year, "dmtg", "dutreil_abattement_pct_tenths", 750)
        // Recompute DMTG with 75% abattement on the actif
        dmtg_base_d := dmtg_actif * (1000 - dmtg_dutreil_abattement_pct) / 1000
        dmtg_base_d = dmtg_base_d - dmtg_abattement
        if dmtg_base_d < 0 { dmtg_base_d = 0 }
        dmtg_dutreil_tax = 0
        if dmtg_degre == "ligne_directe" {
            bi := 7
            prev := 0
            for bi >= 1 {
                thresh := rule_int(db, year, "dmtg", "ligne_directe_bracket_" + str(bi) + "_threshold_cents", 0)
                rate := rule_int(db, year, "dmtg", "ligne_directe_bracket_" + str(bi) + "_rate_pct_tenths", 0)
                hi := dmtg_base_d
                if hi > thresh { hi = thresh }
                if hi > prev { dmtg_dutreil_tax = dmtg_dutreil_tax + (hi - prev) * rate / 1000 }
                prev = thresh
                if dmtg_base_d <= thresh { bi = 0 } else { bi = bi - 1 }
            }
        } else if dmtg_degre == "conjoint" {
            dmtg_base_d = dmtg_actif * (1000 - dmtg_dutreil_abattement_pct) / 1000
            dmtg_base_d = dmtg_base_d - rule_int(db, year, "dmtg_donation", "conjoint_abattement_cents", 8072400)
            if dmtg_base_d < 0 { dmtg_base_d = 0 }
            bi := 7
            prev := 0
            for bi >= 1 {
                thresh := rule_int(db, year, "dmtg_donation", "conjoint_bracket_" + str(bi) + "_threshold_cents", 0)
                rate := rule_int(db, year, "dmtg_donation", "conjoint_bracket_" + str(bi) + "_rate_pct_tenths", 0)
                hi := dmtg_base_d
                if hi > thresh { hi = thresh }
                if hi > prev { dmtg_dutreil_tax = dmtg_dutreil_tax + (hi - prev) * rate / 1000 }
                prev = thresh
                if dmtg_base_d <= thresh { bi = 0 } else { bi = bi - 1 }
            }
        }
        // Réduction 50% si donateur < 70 ans et pleine propriété
        dmtg_dutreil_donateur_age := rule_int(db, year, "dmtg", "dutreil_donateur_age", 0)
        dmtg_dutreil_pp := rule_int(db, year, "dmtg", "dutreil_pleine_propriete", 0)
        if dmtg_dutreil_donateur_age > 0 && dmtg_dutreil_donateur_age < 70 && dmtg_dutreil_pp == 1 {
            dmtg_dutreil_reduction_pct = rule_int(db, year, "dmtg", "dutreil_reduction_pct_tenths", 500)
            dmtg_dutreil_tax = dmtg_dutreil_tax * (1000 - dmtg_dutreil_reduction_pct) / 1000
        }
    }
    // Démembrement temporaire — article 669 II CGI: usufruit temporaire = 23%
    // per 10-year period, capped at the viager value for the same usufruitier
    // age. Article 13-5 1° CGI: the cession price of a temporary usufruit on
    // a bien producteur de revenus is taxed as revenu catégoriel (foncier,
    // BIC), not as plus-value. The radar reports the fiscal valuation
    // (informational). Source: BOFiP BOI-RPPM-PVMC-20-20.
    dt_duree := rule_int(db, year, "demembrement_temporaire", "duree_years", 0)
    dt_bien_valeur := rule_int(db, year, "demembrement_temporaire", "bien_valeur_cents", 0)
    dt_age := rule_int(db, year, "demembrement_temporaire", "usufruitier_age", 0)
    dt_taux_periode := rule_int(db, year, "demembrement_temporaire", "taux_par_periode_pct_tenths", 230)
    dt_periode := rule_int(db, year, "demembrement_temporaire", "periode_years", 10)
    // Compute the viager cap (reuse the demembrement age brackets)
    dt_viager_pct := 0
    if dt_age < 21 { dt_viager_pct = rule_int(db, year, "demembrement", "age_max_21_usufruit_pct_tenths", 900) }
    if dt_age >= 21 && dt_age < 31 { dt_viager_pct = rule_int(db, year, "demembrement", "age_21_30_usufruit_pct_tenths", 800) }
    if dt_age >= 31 && dt_age < 41 { dt_viager_pct = rule_int(db, year, "demembrement", "age_31_40_usufruit_pct_tenths", 700) }
    if dt_age >= 41 && dt_age < 51 { dt_viager_pct = rule_int(db, year, "demembrement", "age_41_50_usufruit_pct_tenths", 600) }
    if dt_age >= 51 && dt_age < 61 { dt_viager_pct = rule_int(db, year, "demembrement", "age_51_60_usufruit_pct_tenths", 500) }
    if dt_age >= 61 && dt_age < 71 { dt_viager_pct = rule_int(db, year, "demembrement", "age_61_70_usufruit_pct_tenths", 400) }
    if dt_age >= 71 && dt_age < 81 { dt_viager_pct = rule_int(db, year, "demembrement", "age_71_80_usufruit_pct_tenths", 300) }
    if dt_age >= 81 && dt_age < 91 { dt_viager_pct = rule_int(db, year, "demembrement", "age_81_90_usufruit_pct_tenths", 200) }
    if dt_age >= 91 { dt_viager_pct = rule_int(db, year, "demembrement", "age_91_plus_usufruit_pct_tenths", 100) }
    // 23% per 10-year period (pro rata), capped at viager
    dt_temporaire_pct := 0
    if dt_periode > 0 && dt_duree > 0 {
        dt_temporaire_pct = dt_duree * dt_taux_periode / dt_periode
        if dt_temporaire_pct > dt_viager_pct { dt_temporaire_pct = dt_viager_pct }
    }
    dt_usufruit_valeur := dt_bien_valeur * dt_temporaire_pct / 1000
    dt_nue_propriete_pct := 1000 - dt_temporaire_pct
    dt_nue_propriete_valeur := dt_bien_valeur * dt_nue_propriete_pct / 1000
    // progressive IR barème + plafonnement QF + décote on the net imposable.
    // The foncier global imputation reduces the base (art. 156 CGI I.3°).
    ir_base := net_bnc + net_bic + net_fon + net_lmnp + net_lmnp_reel + net_salary - foncier_global_imputation - pension_deduction - per_deduction - mh_deduction
    if ir_base < 0 { ir_base = 0 }
    ir_cents, ir_marginal, ir_demi_parts, ir_decote, ir_qf_capped := ir_compute(db, year, ir_base)
    // Réductions d'impôt — dons (art. 200 CGI). Dons are recorded as negative txs in
    // a "dons" stream; the radar takes the absolute sum. 75% up to 1000 EUR (aide aux
    // personnes en difficulté), then 66% up to 20% of revenu imposable.
    g_dons := -kind_get(kinds, "dons")
    if g_dons < 0 { g_dons = 0 }
    dons_75_rate := rule_int(db, year, "dons", "rate_75_pct_tenths", 750)
    dons_75_cap := rule_int(db, year, "dons", "rate_75_cap_cents", 100000)
    dons_66_rate := rule_int(db, year, "dons", "rate_66_pct_tenths", 660)
    dons_66_cap_pct := rule_int(db, year, "dons", "rate_66_cap_revenu_pct_tenths", 200)
    dons_75_base := g_dons
    if dons_75_base > dons_75_cap { dons_75_base = dons_75_cap }
    dons_66_base := g_dons - dons_75_base
    dons_66_cap := ir_base * dons_66_cap_pct / 1000
    if dons_66_base > dons_66_cap { dons_66_base = dons_66_cap }
    dons_reduction := dons_75_base * dons_75_rate / 1000 + dons_66_base * dons_66_rate / 1000
    // Crédit d'impôt emploi à domicile (art. 199 sexdecies CGI). Dépenses recorded as
    // negative txs in an 'emploi_domicile' stream. 50% of dépenses, capped at 12,000 EUR
    // (+1,500 EUR per personne à charge, max 15,000 EUR). This is a CRÉDIT (refundable
    // if it exceeds IR) — the radar reports it separately from réduction dons.
    g_emploi := -kind_get(kinds, "emploi_domicile")
    if g_emploi < 0 { g_emploi = 0 }
    ed_rate := rule_int(db, year, "emploi_domicile", "rate_pct_tenths", 500)
    ed_cap := rule_int(db, year, "emploi_domicile", "cap_cents", 1200000)
    ed_cap_total := rule_int(db, year, "emploi_domicile", "cap_total_cents", 1500000)
    ed_base := g_emploi
    if ed_base > ed_cap { ed_base = ed_cap }
    if ed_base > ed_cap_total { ed_base = ed_cap_total }
    emploi_credit := ed_base * ed_rate / 1000
    // Réduction d'impôt PINEL (art. 199 novovicies CGI). Investment recorded as a
    // positive tx in a 'pinel' stream. Rate by engagement duration (12% 6y / 18% 9y /
    // 21% 12y), capped at 300,000 EUR. The annual reduction = investment × rate / years.
    g_pinel := kind_get(kinds, "pinel")
    if g_pinel < 0 { g_pinel = 0 }
    pinel_cap := rule_int(db, year, "pinel", "cap_investment_cents", 30000000)
    pinel_years := rule_int(db, year, "pinel", "engagement_years", 9)
    if pinel_years < 1 { pinel_years = 1 }
    pinel_base := g_pinel
    if pinel_base > pinel_cap { pinel_base = pinel_cap }
    pinel_rate := 0
    if pinel_years <= 6 {
        pinel_rate = rule_int(db, year, "pinel", "rate_6y_pct_tenths", 120)
    } else if pinel_years <= 9 {
        pinel_rate = rule_int(db, year, "pinel", "rate_9y_pct_tenths", 180)
    } else {
        pinel_rate = rule_int(db, year, "pinel", "rate_12y_pct_tenths", 210)
    }
    pinel_reduction := pinel_base * pinel_rate / 1000 / pinel_years
    // Réduction d'impôt DENORMANDIE (art. 199 novovicies IV bis CGI). Same structure
    // as PINEL (12/18/21% by engagement, cap 300,000 EUR) but for ancien with works.
    g_denorm := kind_get(kinds, "denormandie")
    if g_denorm < 0 { g_denorm = 0 }
    denorm_cap := rule_int(db, year, "denormandie", "cap_investment_cents", 30000000)
    denorm_years := rule_int(db, year, "denormandie", "engagement_years", 9)
    if denorm_years < 1 { denorm_years = 1 }
    denorm_base := g_denorm
    if denorm_base > denorm_cap { denorm_base = denorm_cap }
    denorm_rate := 0
    if denorm_years <= 6 {
        denorm_rate = rule_int(db, year, "denormandie", "rate_6y_pct_tenths", 120)
    } else if denorm_years <= 9 {
        denorm_rate = rule_int(db, year, "denormandie", "rate_9y_pct_tenths", 180)
    } else {
        denorm_rate = rule_int(db, year, "denormandie", "rate_12y_pct_tenths", 210)
    }
    denorm_reduction := denorm_base * denorm_rate / 1000 / denorm_years
    // Réduction d'impôt MALRAUX (art. 199 tervicies CGI). Restoration of immeubles in
    // sites patrimoniaux remarquables. Rate: 30% (PSMV) or 22% (PVAP), cap 400,000 EUR
    // of dépenses. NOT subject to plafonnement niches fiscales. Record dépenses as
    // positive txs in a 'malraux' stream.
    g_malraux := kind_get(kinds, "malraux")
    if g_malraux < 0 { g_malraux = 0 }
    malraux_cap := rule_int(db, year, "malraux", "cap_depenses_cents", 40000000)
    malraux_zone := rule_str(db, year, "malraux", "zone", "psmv")
    malraux_rate := rule_int(db, year, "malraux", "rate_psmv_pct_tenths", 300)
    if malraux_zone == "pvap" {
        malraux_rate = rule_int(db, year, "malraux", "rate_pvap_pct_tenths", 220)
    }
    malraux_base := g_malraux
    if malraux_base > malraux_cap { malraux_base = malraux_cap }
    malraux_reduction := malraux_base * malraux_rate / 1000
    // Réduction d'impôt CENSI-BOUVARD (art. 199 sexvicies CGI). 11% of investment,
    // capped at 300,000 EUR, spread over 9 years. For LMNP in résidences de services
    // (EHPAD, étudiants). Dispositif ended 31/12/2022 but existing engagements
    // continue. Record the investment as a positive tx in a 'censi_bouvard' stream.
    g_censi := kind_get(kinds, "censi_bouvard")
    if g_censi < 0 { g_censi = 0 }
    censi_cap := rule_int(db, year, "censi_bouvard", "cap_investment_cents", 30000000)
    censi_years := rule_int(db, year, "censi_bouvard", "engagement_years", 9)
    if censi_years < 1 { censi_years = 1 }
    censi_rate := rule_int(db, year, "censi_bouvard", "rate_pct_tenths", 110)
    censi_base := g_censi
    if censi_base > censi_cap { censi_base = censi_cap }
    censi_reduction := censi_base * censi_rate / 1000 / censi_years
    // Réduction d'impôt frais de scolarité (art. 199 quater F CGI). Forfaitaire:
    // the user records the TOTAL forfaitaire reduction as a positive tx in a
    // 'scolarite' stream (61 EUR collège + 153 EUR lycée + 183 EUR supérieur per
    // child, half in garde alternée). The radar passes it through as a reduction.
    g_scol_pos := g_scolarite
    if g_scol_pos < 0 { g_scol_pos = 0 }
    scolarite_reduction := g_scol_pos
    // Réduction d'impôt IR-PME / Madelin (art. 199 terdecies-0 A CGI). 18% of
    // versements, capped at 50,000 EUR single / 100,000 EUR couple. Subject to
    // plafonnement global des avantages fiscaux (10,000 EUR) — NOT modeled in v1.
    g_pme_pos := g_ir_pme
    if g_pme_pos < 0 { g_pme_pos = 0 }
    pme_cap := rule_int(db, year, "ir_pme", "cap_single_cents", 5000000)
    pme_rate := rule_int(db, year, "ir_pme", "rate_pct_tenths", 180)
    pme_base := g_pme_pos
    if pme_base > pme_cap { pme_base = pme_cap }
    ir_pme_reduction := pme_base * pme_rate / 1000
    // FCPI/FIP (art. 199 terdecies-0 A VI CGI). 18% reduction, cap 12,000 EUR
    // single / 24,000 EUR couple. Subject to plafonnement global. Record
    // versements as positive txs in a 'fcpi_fip' stream.
    g_ff_pos := g_fcpi_fip
    if g_ff_pos < 0 { g_ff_pos = 0 }
    ff_cap := rule_int(db, year, "fcpi_fip", "cap_single_cents", 1200000)
    ff_rate := rule_int(db, year, "fcpi_fip", "rate_pct_tenths", 180)
    ff_base := g_ff_pos
    if ff_base > ff_cap { ff_base = ff_cap }
    fcpi_fip_reduction := ff_base * ff_rate / 1000
    // SOFICA (art. 199 quater E CGI). 30% reduction, capped at 18,000 EUR OR 25%
    // of revenu net global (whichever is lower). Subject to plafonnement global
    // with 18,000 EUR cap (not 10,000). Record versements as positive txs.
    g_so_pos := g_sofica
    if g_so_pos < 0 { g_so_pos = 0 }
    so_cap := rule_int(db, year, "sofica", "cap_cents", 1800000)
    so_rate := rule_int(db, year, "sofica", "rate_pct_tenths", 300)
    so_revenu_pct := rule_int(db, year, "sofica", "revenu_pct_tenths", 250)
    so_revenu_cap := ir_base * so_revenu_pct / 1000
    so_base := g_so_pos
    if so_base > so_cap { so_base = so_cap }
    if so_base > so_revenu_cap { so_base = so_revenu_cap }
    sofica_reduction := so_base * so_rate / 1000
    // FOREST — investissement forestier (art. 199 decies HA CGI). 22% reduction,
    // capped at 5,700 EUR single / 6,250 EUR couple. Subject to plafonnement
    // global. Record versements as positive txs in a 'forest' stream.
    g_fo_pos := g_forest
    if g_fo_pos < 0 { g_fo_pos = 0 }
    fo_cap := rule_int(db, year, "forest", "cap_single_cents", 570000)
    fo_rate := rule_int(db, year, "forest", "rate_pct_tenths", 220)
    fo_base := g_fo_pos
    if fo_base > fo_cap { fo_base = fo_cap }
    forest_reduction := fo_base * fo_rate / 1000
    ir_after_reductions := ir_cents - dons_reduction - pinel_reduction - denorm_reduction - malraux_reduction - censi_reduction - scolarite_reduction - ir_pme_reduction - fcpi_fip_reduction - sofica_reduction - forest_reduction
    if ir_after_reductions < 0 { ir_after_reductions = 0 }
    // Emploi à domicile is a CRÉDIT (refundable) — it reduces the final tax even below
    // zero. The radar reports it in totals as a negative tax (credit to receive).
    ir_after_credit := ir_after_reductions - emploi_credit
    // Crédit d'impôt frais de garde d'enfants (art. 200 quater B CGI). 50% of
    // dépenses, capped at 3,500 EUR per child under 6 (1,750 in alterné). REFUNDABLE
    // (crédit, like emploi à domicile). Record dépenses as positive txs in a
    // 'frais_garde' stream. Source: BOFiP BOI-IR-RICI-300.
    g_fg_pos := g_frais_garde
    if g_fg_pos < 0 { g_fg_pos = 0 }
    fg_cap := rule_int(db, year, "frais_garde", "cap_per_child_cents", 350000)
    fg_rate := rule_int(db, year, "frais_garde", "rate_pct_tenths", 500)
    fg_base := g_fg_pos
    if fg_base > fg_cap { fg_base = fg_cap }
    frais_garde_credit := fg_base * fg_rate / 1000
    ir_after_credit = ir_after_credit - frais_garde_credit
    // Plafonnement global des avantages fiscaux (art. 200-0 A CGI). Caps the
    // TOTAL niche tax advantage at 10,000 EUR (18,000 EUR with SOFICA). Applies
    // to: pinel, denormandie, censi_bouvard, ir_pme, fcpi_fip, forest, sofica,
    // emploi_domicile, frais_garde. Does NOT apply to: dons, scolarite, pension,
    // PER (deductions or non-niche). If niche_total > cap, the excess is added
    // back to ir_after_credit (the advantage is capped).
    pg_cap := rule_int(db, year, "plafonnement_global", "cap_cents", 1000000)
    pg_cap_sofica := rule_int(db, year, "plafonnement_global", "cap_sofica_cents", 1800000)
    niche_reductions := pinel_reduction + denorm_reduction + censi_reduction + ir_pme_reduction + fcpi_fip_reduction + forest_reduction + sofica_reduction
    niche_credits := emploi_credit + frais_garde_credit
    niche_total := niche_reductions + niche_credits
    pg_cap_effective := pg_cap
    if sofica_reduction > 0 { pg_cap_effective = pg_cap_sofica }
    pg_excess := 0
    if niche_total > pg_cap_effective {
        pg_excess = niche_total - pg_cap_effective
        ir_after_credit = ir_after_credit + pg_excess
    }
    // TVA franchise en base (art. 293 B CGI). Checks whether the year's BNC+BIC gross
    // falls under the services threshold (36,800 EUR) or the vente threshold (91,900).
    // BNC is always services; BIC can be vente or services — we use the lower (services)
    // threshold as the conservative check. The operator overrides if they sell goods.
    tva_ca := g_bnc + g_bic
    if tva_ca < 0 { tva_ca = 0 }
    tva_franchise_services := rule_int(db, year, "tva", "franchise_services_cents", 3680000)
    tva_franchise_vente := rule_int(db, year, "tva", "franchise_vente_cents", 9190000)
    tva_franchise_services_maj := rule_int(db, year, "tva", "franchise_services_majore_cents", 3910000)
    tva_franchise_vente_maj := rule_int(db, year, "tva", "franchise_vente_majore_cents", 10100000)
    tva_eligible := 0
    tva_threshold := tva_franchise_services
    tva_threshold_maj := tva_franchise_services_maj
    if tva_ca <= tva_franchise_services { tva_eligible = 1 }
    // TVA régime simplifié (art. 302 septies A CGI / L. 162-1 CIBS). Eligibility:
    // CA HT between franchise threshold and RSI threshold, AND TVA due < 15,000 EUR.
    // Seuils 2023-2025: services 254,000 / 287,000 (majoré), vente 840,000 / 925,000.
    // The radar uses the services threshold (conservative). Source: BOFiP
    // BOI-BAREME-000036, service-public.gouv.fr F23566.
    tva_rsi_services := rule_int(db, year, "tva_rsi", "threshold_services_cents", 25400000)
    tva_rsi_services_maj := rule_int(db, year, "tva_rsi", "threshold_services_majore_cents", 28700000)
    tva_rsi_vente := rule_int(db, year, "tva_rsi", "threshold_vente_cents", 84000000)
    tva_rsi_vente_maj := rule_int(db, year, "tva_rsi", "threshold_vente_majore_cents", 92500000)
    tva_rsi_due_cap := rule_int(db, year, "tva_rsi", "tva_due_cap_cents", 1500000)
    // TVA collectée / déductible (art. 271 CGI). The user records the TVA amounts
    // directly as positive txs: 'tva_collectee' (TVA facturée aux clients) and
    // 'tva_deductible' (TVA payée aux fournisseurs). TVA à payer = collectée -
    // déductible. If negative, crédit de TVA (reportable ou remboursable).
    tva_collectee := kind_get(kinds, "tva_collectee")
    if tva_collectee < 0 { tva_collectee = 0 }
    tva_deductible := kind_get(kinds, "tva_deductible")
    if tva_deductible < 0 { tva_deductible = 0 }
    tva_solde := tva_collectee - tva_deductible
    tva_credit := 0
    tva_a_payer := 0
    if tva_solde >= 0 {
        tva_a_payer = tva_solde
    } else {
        tva_credit = -tva_solde
    }
    // RSI eligibility: CA HT > franchise AND <= RSI threshold AND TVA due < 15,000.
    tva_rsi_eligible := 0
    if tva_ca > tva_franchise_services && tva_ca <= tva_rsi_services && tva_a_payer < tva_rsi_due_cap {
        tva_rsi_eligible = 1
    }
    // Régime normal eligibility (art. 287 CGI): CA > RSI upper threshold. CA3
    // mensuel (or trimestriel if TVA < 4,000 EUR/year). The TVA math is the
    // same; only the declaration frequency changes.
    tva_rn_services := rule_int(db, year, "tva", "rn_threshold_services_cents", 25400000)
    tva_rn_vente := rule_int(db, year, "tva", "rn_threshold_vente_cents", 84000000)
    tva_rn_eligible := 0
    if tva_ca > tva_rn_services { tva_rn_eligible = 1 }
    // Plus-values immobilières (art. 150 U à 150 VH CGI). Flat tax 19% IR +
    // 17.2% prélèvements sociaux. Abattement for durée de détention:
    // IR: 6%/year years 6-21, 4% year 22 → 100% after 22y.
    // Social: 1.65%/year years 6-21, 1.6% year 22, 9%/year years 23-30 → 100% after 30y.
    // Record the plus-value BRUTE as a positive tx in a 'plus_value_immo'
    // stream. Set detention years via: bilan rule set 2026 plus_value_immo
    // detention_years 10. Source: BOFiP BOI-RFPI-PVI-20.
    pv_immo_brute := g_pv_immo
    if pv_immo_brute < 0 { pv_immo_brute = 0 }
    pv_detention := rule_int(db, year, "plus_value_immo", "detention_years", 0)
    if pv_detention < 0 { pv_detention = 0 }
    pv_ir_rate := rule_int(db, year, "plus_value_immo", "ir_rate_pct_tenths", 190)
    pv_social_rate := rule_int(db, year, "plus_value_immo", "social_rate_pct_tenths", 172)
    // IR abattement: 6%/year from year 6 to 21 (16 years × 6% = 96%), 4% year 22 → 100%.
    pv_ir_abattement_pct := 0
    if pv_detention > 5 {
        ir_years := pv_detention - 5
        if ir_years > 16 { ir_years = 16 }
        pv_ir_abattement_pct = ir_years * 60  // 6% = 60 tenths
        if pv_detention >= 22 { pv_ir_abattement_pct = 1000 }
    }
    // Social abattement: 1.65%/year years 6-21 (16 × 1.65% = 26.4%), 1.6% year
    // 22 (28%), 9%/year years 23-30 (72%) → 100% after 30y.
    pv_social_abattement_pct := 0
    if pv_detention > 5 {
        soc_years := pv_detention - 5
        if soc_years > 16 { soc_years = 16 }
        pv_social_abattement_pct = soc_years * 165 / 10  // 1.65% = 16.5 tenths
        if pv_detention >= 22 {
            pv_social_abattement_pct = 280  // 28% after year 22
            extra := pv_detention - 22
            if extra > 8 { extra = 8 }
            pv_social_abattement_pct = pv_social_abattement_pct + extra * 90  // 9% = 90 tenths
        }
        if pv_detention >= 30 { pv_social_abattement_pct = 1000 }
    }
    pv_ir_base := pv_immo_brute * (1000 - pv_ir_abattement_pct) / 1000
    pv_social_base := pv_immo_brute * (1000 - pv_social_abattement_pct) / 1000
    pv_ir_tax := pv_ir_base * pv_ir_rate / 1000
    pv_social_tax := pv_social_base * pv_social_rate / 1000
    pv_immo_total := pv_ir_tax + pv_social_tax
    // Surtaxe sur plus-values immobilières élevées (art. 1609 nonies G CGI).
    // Progressive surtaxe on PV nette imposable > 50,000 EUR. Applies to
    // immeubles bâtis only (not terrains à bâtir). Brackets:
    //   50k-60k: 2%, 60k-100k: 3%, 100k-150k: 4%, 150k-200k: 5%,
    //   200k-250k: 6%, > 250k: 6%
    // The surtaxe is computed on pv_ir_base (the net imposable after abattement).
    // Source: BOFiP BOI-RFPI-TPVIE-20.
    pv_surtaxe_threshold := rule_int(db, year, "pv_immo_surtaxe", "threshold_cents", 5000000)
    pv_surtaxe_cents := 0
    if pv_ir_base > pv_surtaxe_threshold {
        // Progressive by brackets — each bracket taxes the portion within it
        b1_max := rule_int(db, year, "pv_immo_surtaxe", "bracket1_max_cents", 6000000)
        b1_rate := rule_int(db, year, "pv_immo_surtaxe", "bracket1_rate_pct_tenths", 20)
        b2_max := rule_int(db, year, "pv_immo_surtaxe", "bracket2_max_cents", 10000000)
        b2_rate := rule_int(db, year, "pv_immo_surtaxe", "bracket2_rate_pct_tenths", 30)
        b3_max := rule_int(db, year, "pv_immo_surtaxe", "bracket3_max_cents", 15000000)
        b3_rate := rule_int(db, year, "pv_immo_surtaxe", "bracket3_rate_pct_tenths", 40)
        b4_max := rule_int(db, year, "pv_immo_surtaxe", "bracket4_max_cents", 20000000)
        b4_rate := rule_int(db, year, "pv_immo_surtaxe", "bracket4_rate_pct_tenths", 50)
        b5_max := rule_int(db, year, "pv_immo_surtaxe", "bracket5_max_cents", 25000000)
        b5_rate := rule_int(db, year, "pv_immo_surtaxe", "bracket5_rate_pct_tenths", 60)
        b6_rate := rule_int(db, year, "pv_immo_surtaxe", "bracket6_rate_pct_tenths", 60)
        // Bracket 1: 50k-60k at 2%
        b1_portion := pv_ir_base - pv_surtaxe_threshold
        if b1_portion > (b1_max - pv_surtaxe_threshold) { b1_portion = b1_max - pv_surtaxe_threshold }
        pv_surtaxe_cents = pv_surtaxe_cents + b1_portion * b1_rate / 1000
        // Bracket 2: 60k-100k at 3%
        if pv_ir_base > b1_max {
            b2_portion := pv_ir_base - b1_max
            if b2_portion > (b2_max - b1_max) { b2_portion = b2_max - b1_max }
            pv_surtaxe_cents = pv_surtaxe_cents + b2_portion * b2_rate / 1000
        }
        // Bracket 3: 100k-150k at 4%
        if pv_ir_base > b2_max {
            b3_portion := pv_ir_base - b2_max
            if b3_portion > (b3_max - b2_max) { b3_portion = b3_max - b2_max }
            pv_surtaxe_cents = pv_surtaxe_cents + b3_portion * b3_rate / 1000
        }
        // Bracket 4: 150k-200k at 5%
        if pv_ir_base > b3_max {
            b4_portion := pv_ir_base - b3_max
            if b4_portion > (b4_max - b3_max) { b4_portion = b4_max - b3_max }
            pv_surtaxe_cents = pv_surtaxe_cents + b4_portion * b4_rate / 1000
        }
        // Bracket 5: 200k-250k at 6%
        if pv_ir_base > b4_max {
            b5_portion := pv_ir_base - b4_max
            if b5_portion > (b5_max - b4_max) { b5_portion = b5_max - b4_max }
            pv_surtaxe_cents = pv_surtaxe_cents + b5_portion * b5_rate / 1000
        }
        // Bracket 6: > 250k at 6%
        if pv_ir_base > b5_max {
            pv_surtaxe_cents = pv_surtaxe_cents + (pv_ir_base - b5_max) * b6_rate / 1000
        }
    }
    // Taxe forfaitaire sur métaux précieux et objets d'art (art. 150 VI/VK CGI).
    // Cessions or exports outside EU of: métaux précieux (11%), bijoux/objets
    // d'art/collection/antiquité (6%). The radar computes the taxe forfaitaire
    // on the gross cession price (not the plus-value). Record cessions in a
    // 'metaux' or 'objets_art' stream. Source: BOFiP BOI-RPPM-PVMC-30.
    g_metaux := kind_get(kinds, "metaux")
    g_objets_art := kind_get(kinds, "objets_art")
    taux_metaux := rule_int(db, year, "metaux_precieux", "taux_metaux_pct_tenths", 110)
    taux_objets_art := rule_int(db, year, "metaux_precieux", "taux_objets_art_pct_tenths", 60)
    metaux_tax := 0
    if g_metaux > 0 { metaux_tax = g_metaux * taux_metaux / 1000 }
    objets_art_tax := 0
    if g_objets_art > 0 { objets_art_tax = g_objets_art * taux_objets_art / 1000 }
    metaux_total_tax := metaux_tax + objets_art_tax
    // Option article 150 VL CGI — régime des plus-values (art. 150 UA) for
    // métaux précieux and objets d'art. The seller can opt for the PV regime
    // instead of the taxe forfaitaire. PV = prix cession - prix acquisition.
    // Abattement 5% per year beyond year 2, exonération after 22 years. Tax:
    // 19% IR + 17.2% social on the net PV after abattement. The radar computes
    // both and reports the lower. Set: bilan rule set 2026 metaux_precieux
    // option_150vl_eligible 1, option_150vl_acquisition_cents <price>,
    // option_150vl_detention_years <years>. Source: BOFiP BOI-RPPM-PVBMC-20-20.
    mp_150vl_eligible := rule_int(db, year, "metaux_precieux", "option_150vl_eligible", 0)
    mp_150vl_acquisition := rule_int(db, year, "metaux_precieux", "option_150vl_acquisition_cents", 0)
    mp_150vl_detention := rule_int(db, year, "metaux_precieux", "option_150vl_detention_years", 0)
    mp_150vl_abat_per_year := rule_int(db, year, "metaux_precieux", "option_150vl_abattement_per_year_pct_tenths", 50)
    mp_150vl_exoneration_years := rule_int(db, year, "metaux_precieux", "option_150vl_exoneration_years", 22)
    mp_150vl_ir_rate := rule_int(db, year, "metaux_precieux", "option_150vl_ir_rate_pct_tenths", 190)
    mp_150vl_social_rate := rule_int(db, year, "metaux_precieux", "option_150vl_social_rate_pct_tenths", 172)
    mp_cession_total := g_metaux + g_objets_art
    mp_150vl_pv := 0
    mp_150vl_abattement_pct := 0
    mp_150vl_ir := 0
    mp_150vl_social := 0
    mp_150vl_total := 0
    if mp_150vl_eligible == 1 && mp_cession_total > mp_150vl_acquisition {
        mp_150vl_pv = mp_cession_total - mp_150vl_acquisition
        // Abattement 5% per year beyond year 2, capped at 100% (exonération at 22y)
        if mp_150vl_detention > 2 {
            mp_150vl_abattement_pct = (mp_150vl_detention - 2) * mp_150vl_abat_per_year
            if mp_150vl_abattement_pct > 1000 { mp_150vl_abattement_pct = 1000 }
        }
        mp_150vl_base := mp_150vl_pv * (1000 - mp_150vl_abattement_pct) / 1000
        mp_150vl_ir = mp_150vl_base * mp_150vl_ir_rate / 1000
        mp_150vl_social = mp_150vl_base * mp_150vl_social_rate / 1000
        mp_150vl_total = mp_150vl_ir + mp_150vl_social
    }
    // Choose the lower: forfaitaire (metaux_total_tax) vs 150 VL option
    mp_effective_total := metaux_total_tax
    mp_optimal := "forfaitaire"
    if mp_150vl_eligible == 1 && mp_150vl_total < metaux_total_tax {
        mp_effective_total = mp_150vl_total
        mp_optimal = "150_vl"
    }
    // LMNP amortissement — article 39 C CGI. Component-based linear
    // amortissement for LMNP régime réel. Terrain is never amortissable.
    // Plafonnement: the dotation can't exceed the loyer net of other charges
    // (can't create a deficit). Set property_value and mobilier_value via rule
    // set. Source: BOFiP BOI-BIC-AMT-10-40.
    la_property_value := rule_int(db, year, "lmnp_amortissement", "property_value_cents", 0)
    la_terrain_pct := rule_int(db, year, "lmnp_amortissement", "terrain_pct_tenths", 150)
    la_mobilier_value := rule_int(db, year, "lmnp_amortissement", "mobilier_value_cents", 0)
    la_mobilier_duration := rule_int(db, year, "lmnp_amortissement", "mobilier_duration_years", 7)
    la_go_pct := rule_int(db, year, "lmnp_amortissement", "gros_oeuvre_pct_tenths", 550)
    la_go_duration := rule_int(db, year, "lmnp_amortissement", "gros_oeuvre_duration_years", 50)
    la_to_pct := rule_int(db, year, "lmnp_amortissement", "toiture_pct_tenths", 120)
    la_to_duration := rule_int(db, year, "lmnp_amortissement", "toiture_duration_years", 30)
    la_re_pct := rule_int(db, year, "lmnp_amortissement", "reseaux_pct_tenths", 130)
    la_re_duration := rule_int(db, year, "lmnp_amortissement", "reseaux_duration_years", 25)
    la_ag_pct := rule_int(db, year, "lmnp_amortissement", "agencements_pct_tenths", 200)
    la_ag_duration := rule_int(db, year, "lmnp_amortissement", "agencements_duration_years", 12)
    // Building value = property value - terrain portion
    la_building := la_property_value * (1000 - la_terrain_pct) / 1000
    // Component dotations (linear: value / duration)
    la_go_dotation := 0
    if la_go_duration > 0 { la_go_dotation = la_building * la_go_pct / 1000 / la_go_duration }
    la_to_dotation := 0
    if la_to_duration > 0 { la_to_dotation = la_building * la_to_pct / 1000 / la_to_duration }
    la_re_dotation := 0
    if la_re_duration > 0 { la_re_dotation = la_building * la_re_pct / 1000 / la_re_duration }
    la_ag_dotation := 0
    if la_ag_duration > 0 { la_ag_dotation = la_building * la_ag_pct / 1000 / la_ag_duration }
    la_mobilier_dotation := 0
    if la_mobilier_duration > 0 { la_mobilier_dotation = la_mobilier_value / la_mobilier_duration }
    la_dotation_brute := la_go_dotation + la_to_dotation + la_re_dotation + la_ag_dotation + la_mobilier_dotation
    // Plafonnement art. 39 C: dotation can't exceed loyer net of other charges.
    // The loyer net is g_lmnp_reel (signed sum: positive loyer - negative charges).
    // If g_lmnp_reel <= 0, no amortissement can be deducted (can't create deficit).
    la_plafond := 0
    if g_lmnp_reel > 0 { la_plafond = g_lmnp_reel }
    la_dotation := la_dotation_brute
    if la_dotation > la_plafond { la_dotation = la_plafond }
    la_ard_reportable := la_dotation_brute - la_dotation
    // ARD stock from prior years (art. 39 C II.2 — reportable sans limite)
    la_ard_stock := ard_stock(db, year)
    // Current-year ARD consumption: if plafond > dotation_brute, the surplus
    // consumes prior-year ARD stock
    la_ard_consumed := 0
    if la_plafond > la_dotation_brute {
        la_ard_consumed = la_plafond - la_dotation_brute
        if la_ard_consumed > la_ard_stock { la_ard_consumed = la_ard_stock }
    }
    la_ard_stock_after := la_ard_stock - la_ard_consumed + la_ard_reportable
    // IFI — impôt sur la fortune immobilière (art. 977 CGI). Barème progressif
    // on net taxable patrimoine. Seuil déclenchement 1.3M (but taxation starts at
    // 800k). Décote for 1.3M-1.4M: 17500 - 1.25% × P. Record the net taxable
    // patrimoine value as a positive tx in an 'ifi_patrimoine' stream.
    ifi_patrimoine := g_ifi
    if ifi_patrimoine < 0 { ifi_patrimoine = 0 }
    ifi_seuil := rule_int(db, year, "ifi", "seuil_cents", 130000000)
    ifi_b1_thr := rule_int(db, year, "ifi", "bareme1_threshold_cents", 80000000)
    ifi_b1_rate := rule_int(db, year, "ifi", "bareme1_rate_pct_hundredths", 50)
    ifi_b2_thr := rule_int(db, year, "ifi", "bareme2_threshold_cents", 130000000)
    ifi_b2_rate := rule_int(db, year, "ifi", "bareme2_rate_pct_hundredths", 70)
    ifi_b3_thr := rule_int(db, year, "ifi", "bareme3_threshold_cents", 257000000)
    ifi_b3_rate := rule_int(db, year, "ifi", "bareme3_rate_pct_hundredths", 100)
    ifi_b4_thr := rule_int(db, year, "ifi", "bareme4_threshold_cents", 500000000)
    ifi_b4_rate := rule_int(db, year, "ifi", "bareme4_rate_pct_hundredths", 125)
    ifi_b5_thr := rule_int(db, year, "ifi", "bareme5_threshold_cents", 1000000000)
    ifi_b5_rate := rule_int(db, year, "ifi", "bareme5_rate_pct_hundredths", 150)
    ifi_decote_thr := rule_int(db, year, "ifi", "decote_threshold_cents", 140000000)
    ifi_decote_base := rule_int(db, year, "ifi", "decote_base_cents", 1750000)
    ifi_decote_rate := rule_int(db, year, "ifi", "decote_rate_pct_hundredths", 125)
    ifi_cents := 0
    ifi_decote_cents := 0
    if ifi_patrimoine > ifi_seuil {
        // Progressive barème from 800k (not from 1.3M — taxation starts at 800k
        // once the seuil is crossed).
        ifi_cents = ifi_bareme(ifi_patrimoine, ifi_b1_thr, ifi_b1_rate, ifi_b2_thr, ifi_b2_rate, ifi_b3_thr, ifi_b3_rate, ifi_b4_thr, ifi_b4_rate, ifi_b5_thr, ifi_b5_rate)
        // Décote for 1.3M-1.4M: 17500 - 1.25% × P.
        if ifi_patrimoine < ifi_decote_thr {
            ifi_decote_cents = ifi_decote_base - ifi_patrimoine * ifi_decote_rate / 10000
            if ifi_decote_cents < 0 { ifi_decote_cents = 0 }
            ifi_cents = ifi_cents - ifi_decote_cents
            if ifi_cents < 0 { ifi_cents = 0 }
        }
    }
    // CFE — cotisation foncière des entreprises (art. 1647 D CGI). Cotisation
    // minimum based on CA (BNC + BIC gross). Base minimum by CA bracket
    // (midpoint of the legal range). Communal rate (default 20%, overridable).
    // Exonération if CA ≤ 5,000 EUR. CFE = base × rate / 1000.
    cfe_ca := g_bnc + g_bic
    if cfe_ca < 0 { cfe_ca = 0 }
    cfe_rate := rule_int(db, year, "cfe", "rate_pct_tenths", 200)
    cfe_exoneration_ca := rule_int(db, year, "cfe", "exoneration_ca_cents", 500000)
    cfe_b1_ca := rule_int(db, year, "cfe", "bracket1_ca_cents", 1000000)
    cfe_b1_base := rule_int(db, year, "cfe", "bracket1_base_cents", 40100)
    cfe_b2_ca := rule_int(db, year, "cfe", "bracket2_ca_cents", 3260000)
    cfe_b2_base := rule_int(db, year, "cfe", "bracket2_base_cents", 68400)
    cfe_b3_ca := rule_int(db, year, "cfe", "bracket3_ca_cents", 10000000)
    cfe_b3_base := rule_int(db, year, "cfe", "bracket3_base_cents", 135700)
    cfe_b4_ca := rule_int(db, year, "cfe", "bracket4_ca_cents", 25000000)
    cfe_b4_base := rule_int(db, year, "cfe", "bracket4_base_cents", 218300)
    cfe_b5_ca := rule_int(db, year, "cfe", "bracket5_ca_cents", 50000000)
    cfe_b5_base := rule_int(db, year, "cfe", "bracket5_base_cents", 306700)
    cfe_b6_base := rule_int(db, year, "cfe", "bracket6_base_cents", 395300)
    cfe_base := 0
    cfe_bracket := 0
    if cfe_ca > cfe_exoneration_ca {
        cfe_bracket = 1
        cfe_base = cfe_b1_base
        if cfe_ca > cfe_b1_ca { cfe_bracket = 2  cfe_base = cfe_b2_base }
        if cfe_ca > cfe_b2_ca { cfe_bracket = 3  cfe_base = cfe_b3_base }
        if cfe_ca > cfe_b3_ca { cfe_bracket = 4  cfe_base = cfe_b4_base }
        if cfe_ca > cfe_b4_ca { cfe_bracket = 5  cfe_base = cfe_b5_base }
        if cfe_ca > cfe_b5_ca { cfe_bracket = 6  cfe_base = cfe_b6_base }
    }
    cfe_cents := cfe_base * cfe_rate / 1000
    // CVAE — cotisation sur la valeur ajoutée des entreprises (art. 1586 ter
    // CGI). Progressive effective rate based on CA. Assujettie if CA > 152,500
    // EUR but franchise if CA ≤ 500,000 EUR. Rate: 0% < 500k, 0.25% at 3M,
    // 0.7% at 10M, 0.75% > 50M. For 2024, rate reduced by 25% (art. 79 LF 2024).
    // Being phased out (suppression 2027). Source: BOFiP BOI-CVAE-LIQ-10.
    cvae_ca := cfe_ca
    cvae_threshold := rule_int(db, year, "cvae", "threshold_cents", 15250000)
    cvae_franchise := rule_int(db, year, "cvae", "franchise_ca_cents", 50000000)
    cvae_b1_ca := rule_int(db, year, "cvae", "bracket1_ca_cents", 50000000)
    cvae_b1_rate := rule_int(db, year, "cvae", "bracket1_rate_pct_hundredths", 0)
    cvae_b2_ca := rule_int(db, year, "cvae", "bracket2_ca_cents", 300000000)
    cvae_b2_rate := rule_int(db, year, "cvae", "bracket2_rate_pct_hundredths", 25)
    cvae_b3_ca := rule_int(db, year, "cvae", "bracket3_ca_cents", 1000000000)
    cvae_b3_rate := rule_int(db, year, "cvae", "bracket3_rate_pct_hundredths", 70)
    cvae_b4_rate := rule_int(db, year, "cvae", "bracket4_rate_pct_hundredths", 75)
    cvae_reduction := rule_int(db, year, "cvae", "reduction_2024_pct_tenths", 250)
    cvae_assujettie := 0
    cvae_effective_rate_pct_hundredths := 0
    cvae_cents := 0
    if cvae_ca > cvae_threshold {
        cvae_assujettie = 1
        if cvae_ca > cvae_franchise {
            // Progressive effective rate: linear interpolation between brackets
            if cvae_ca <= cvae_b2_ca {
                // 500k-3M: 0.25% × (CA - 500k) / 2.5M
                cvae_effective_rate_pct_hundredths = cvae_b2_rate * (cvae_ca - cvae_b1_ca) / (cvae_b2_ca - cvae_b1_ca)
            } else if cvae_ca <= cvae_b3_ca {
                // 3M-10M: 0.25% + 0.45% × (CA - 3M) / 7M
                cvae_effective_rate_pct_hundredths = cvae_b2_rate + (cvae_b3_rate - cvae_b2_rate) * (cvae_ca - cvae_b2_ca) / (cvae_b3_ca - cvae_b2_ca)
            } else if cvae_ca <= rule_int(db, year, "cvae", "bracket4_ca_cents", 5000000000) {
                // 10M-50M: 0.7% + 0.05% × (CA - 10M) / 40M
                cvae_effective_rate_pct_hundredths = cvae_b3_rate + (cvae_b4_rate - cvae_b3_rate) * (cvae_ca - cvae_b3_ca) / (rule_int(db, year, "cvae", "bracket4_ca_cents", 5000000000) - cvae_b3_ca)
            } else {
                // > 50M: 0.75%
                cvae_effective_rate_pct_hundredths = cvae_b4_rate
            }
            // CVAE = VA × effective_rate / 10000. VA ≈ CA × 0.45 (simplified —
            // VA is typically 45% of CA for service businesses).
            cvae_va := cvae_ca * 45 / 100
            cvae_cents = cvae_va * cvae_effective_rate_pct_hundredths / 10000
            // 2024 reduction: 25% off (art. 79 LF 2024)
            cvae_cents = cvae_cents * (1000 - cvae_reduction) / 1000
        }
    }
    // Prélèvement à la source — taux neutre mensuel (art. 204 H CGI). The radar
    // projects the annual net salary / 12 and applies the taux neutre grid to
    // estimate the monthly prepayment. This is the confidentiality grid (taux neutre),
    // not the personalized rate — it's an estimate for the "provision each month" loop.
    pas_monthly_base := net_salary / 12
    pas_rate := 0
    pi := 15
    for pi >= 2 {
        t := rule_int(db, year, "pas", "bracket_" + str(pi) + "_threshold_cents", 0)
        if pas_monthly_base >= t {
            pas_rate = rule_int(db, year, "pas", "bracket_" + str(pi) + "_rate_tenths", 0)
            pi = 0
        }
        pi = pi - 1
    }
    pas_monthly := pas_monthly_base * pas_rate / 1000
    // PAS taux personnalisé (art. 204 H CGI). The personalized rate = IR (before
    // reductions/crédits) / revenu imposable, expressed in tenths of a percent.
    // This is a v1 simplification of the BOFiP formula (which weights revenus in the
    // PAS champ vs RNI). It gives a taux moyen d'imposition, not a TMI.
    pas_personnalise_tenths := 0
    if ir_base > 0 {
        pas_personnalise_tenths = ir_cents * 1000 / ir_base
    }
    pas_personnalise_monthly := net_salary * pas_personnalise_tenths / 12000
    // PAS taux individualisé — article 204 M CGI (LF 2024, applicable 1er
    // septembre 2025). For couples mariés/PACS soumis à imposition commune, the
    // taux individualisé becomes the default. The conjoint with the lowest
    // revenus personnels gets taux1 = IR1 / (rev_perso1 + ½ rev_communs), where
    // IR1 is computed on rev_perso1 + ½ rev_communs with ½ parts. The other
    // conjoint gets taux2 = (IR_foyer - IR1 - IR_communs) / rev_perso2.
    // Source: BOFiP BOI-IR-PAS-20-20-20.
    pi_c1_rev := rule_int(db, year, "pas_individualise", "conjoint1_revenu_perso_cents", 0)
    pi_c2_rev := rule_int(db, year, "pas_individualise", "conjoint2_revenu_perso_cents", 0)
    pi_communs := rule_int(db, year, "pas_individualise", "revenus_communs_cents", 0)
    pi_parts := rule_int(db, year, "pas_individualise", "parts_foyer", 2)
    // Determine which conjoint has the lowest revenus personnels
    pi_c1_is_low := 1
    if pi_c2_rev < pi_c1_rev { pi_c1_is_low = 0 }
    pi_low_rev := pi_c1_rev
    pi_high_rev := pi_c2_rev
    if pi_c1_is_low == 0 { pi_low_rev = pi_c2_rev  pi_high_rev = pi_c1_rev }
    // IR on low conjoint's base (rev_perso_low + ½ communs) with ½ parts
    pi_low_base := pi_low_rev + pi_communs / 2
    pi_half_parts := pi_parts / 2
    if pi_half_parts < 1 { pi_half_parts = 1 }
    pi_low_quotient := pi_low_base / pi_half_parts
    pi_low_ir := 0
    pi_low_marginal := 0
    if pi_low_base > 0 {
        pi_low_ir, pi_low_marginal = bareme_on_quotient(db, year, pi_low_quotient)
        pi_low_ir = pi_low_ir * pi_half_parts
    }
    // Taux individualisé for low conjoint
    pi_low_taux_tenths := 0
    if pi_low_base > 0 { pi_low_taux_tenths = pi_low_ir * 1000 / pi_low_base }
    // IR on communs (at foyer rate = IR_foyer / foyer_base)
    pi_foyer_base := pi_c1_rev + pi_c2_rev + pi_communs
    pi_foyer_quotient := pi_foyer_base / pi_parts
    pi_foyer_ir := 0
    pi_foyer_marginal := 0
    if pi_foyer_base > 0 {
        pi_foyer_ir, pi_foyer_marginal = bareme_on_quotient(db, year, pi_foyer_quotient)
        pi_foyer_ir = pi_foyer_ir * pi_parts
    }
    pi_communs_ir := 0
    if pi_foyer_base > 0 { pi_communs_ir = pi_foyer_ir * pi_communs / pi_foyer_base }
    // Taux individualisé for high conjoint
    // taux2 = (IR_foyer - IR_low - IR_communs) / rev_perso_high
    pi_high_taux_tenths := 0
    if pi_high_rev > 0 {
        pi_high_ir := pi_foyer_ir - pi_low_ir - pi_communs_ir
        if pi_high_ir < 0 { pi_high_ir = 0 }
        pi_high_taux_tenths = pi_high_ir * 1000 / pi_high_rev
    }
    // Assign back to c1/c2
    pi_c1_taux_tenths := pi_low_taux_tenths
    pi_c2_taux_tenths := pi_high_taux_tenths
    if pi_c1_is_low == 0 { pi_c1_taux_tenths = pi_high_taux_tenths  pi_c2_taux_tenths = pi_low_taux_tenths }
    out = "{\"ok\":true,\"year\":" + year
    out = out + ",\"rates\":{\"pfu_pct\":" + pct_str(rate_pfu) + ",\"micro_bnc_abattement_pct\":" + pct_str(rate_ded_bnc) + ",\"micro_bnc_social_pct\":" + pct_str(rate_soc_bnc) + ",\"micro_bic_abattement_pct\":" + pct_str(rate_ded_bic) + ",\"micro_bic_social_pct\":" + pct_str(rate_soc_bic) + ",\"micro_foncier_abattement_pct\":" + pct_str(rate_ded_fon) + ",\"micro_foncier_social_pct\":" + pct_str(rate_soc_fon) + "}"
    out = out + ",\"regimes\":{"
    out = out + "\"bnc\":{\"gross_cents\":" + str(g_bnc) + ",\"gross_eur\":\"" + fmt_cents(g_bnc) + "\",\"deficit_carried_cents\":" + str(def_bnc) + ",\"adjusted_gross_cents\":" + str(adj_bnc) + ",\"abattement_cents\":" + str(ab_bnc) + ",\"net_ir_cents\":" + str(net_bnc) + ",\"social_cents\":" + str(soc_bnc) + "}"
    out = out + ",\"bic\":{\"gross_cents\":" + str(g_bic) + ",\"gross_eur\":\"" + fmt_cents(g_bic) + "\",\"deficit_carried_cents\":" + str(def_bic) + ",\"adjusted_gross_cents\":" + str(adj_bic) + ",\"abattement_cents\":" + str(ab_bic) + ",\"net_ir_cents\":" + str(net_bic) + ",\"social_cents\":" + str(soc_bic) + "}"
    out = out + ",\"lmnp\":{\"gross_cents\":" + str(g_lmnp) + ",\"gross_eur\":\"" + fmt_cents(g_lmnp) + "\",\"deficit_carried_cents\":" + str(def_lmnp) + ",\"adjusted_gross_cents\":" + str(adj_lmnp) + ",\"abattement_cents\":" + str(ab_lmnp) + ",\"net_ir_cents\":" + str(net_lmnp) + ",\"social_cents\":" + str(soc_lmnp) + ",\"note\":\"micro-BIC meublé (art. 50 CGI) — 50% abattement, threshold 77700 EUR\"}"
    out = out + ",\"lmnp_reel\":{\"gross_cents\":" + str(g_lmnp_reel) + ",\"gross_eur\":\"" + fmt_cents(g_lmnp_reel) + "\",\"net_ir_cents\":" + str(net_lmnp_reel) + ",\"social_cents\":" + str(soc_lmnp_reel) + ",\"note\":\"" + esc(lmnp_reel_note) + "\"}"
    out = out + ",\"foncier\":{\"gross_cents\":" + str(g_rent) + ",\"gross_eur\":\"" + fmt_cents(g_rent) + "\",\"abattement_cents\":" + str(ab_fon) + ",\"net_ir_cents\":" + str(net_fon) + ",\"social_cents\":" + str(soc_fon) + ",\"deficit_global_imputation_cents\":" + str(foncier_global_imputation) + ",\"deficit_carry_10y_cents\":" + str(foncier_carry_excess) + ",\"reel_net_cents\":" + str(foncier_reel_net) + ",\"reel_note\":\"" + esc(foncier_reel_note) + "\"}"
    out = out + ",\"salary\":{\"gross_cents\":" + str(g_salary) + ",\"gross_eur\":\"" + fmt_cents(g_salary) + "\",\"frais_abattement_cents\":" + str(salary_frais) + ",\"net_cents\":" + str(net_salary) + ",\"net_eur\":\"" + fmt_cents(net_salary) + "\",\"note\":\"10% frais per salary stream (per member of the foyer)\"}"
    out = out + "}"
    out = out + ",\"ir\":{\"base_cents\":" + str(ir_base) + ",\"base_eur\":\"" + fmt_cents(ir_base) + "\",\"situation\":\"" + rule_str(db, year, "ir_bareme", "situation", "default") + "\",\"demi_parts\":" + str(ir_demi_parts) + ",\"qf_capped\":" + json(ir_qf_capped == 1) + ",\"ir_before_decote_cents\":" + str(ir_cents+ir_decote) + ",\"decote_cents\":" + str(ir_decote) + ",\"ir_cents\":" + str(ir_cents) + ",\"ir_eur\":\"" + fmt_cents(ir_cents) + "\",\"dons_reduction_cents\":" + str(dons_reduction) + ",\"pinel_reduction_cents\":" + str(pinel_reduction) + ",\"denormandie_reduction_cents\":" + str(denorm_reduction) + ",\"malraux_reduction_cents\":" + str(malraux_reduction) + ",\"censi_bouvard_reduction_cents\":" + str(censi_reduction) + ",\"scolarite_reduction_cents\":" + str(scolarite_reduction) + ",\"ir_pme_reduction_cents\":" + str(ir_pme_reduction) + ",\"fcpi_fip_reduction_cents\":" + str(fcpi_fip_reduction) + ",\"sofica_reduction_cents\":" + str(sofica_reduction) + ",\"forest_reduction_cents\":" + str(forest_reduction) + ",\"pension_alimentaire_deduction_cents\":" + str(pension_deduction) + ",\"per_deduction_cents\":" + str(per_deduction) + ",\"per_regime\":\"" + per_regime + "\",\"per_tns_plafond_cents\":" + str(per_tns_plafond) + ",\"per_163_quatervicies_cap_cents\":" + str(per_cap) + ",\"mh_deduction_cents\":" + str(mh_deduction) + ",\"heures_sup_exemption_cents\":" + str(heures_sup_exemption) + ",\"plafonnement_global_excess_cents\":" + str(pg_excess) + ",\"ir_after_reductions_cents\":" + str(ir_after_reductions) + ",\"emploi_credit_cents\":" + str(emploi_credit) + ",\"frais_garde_credit_cents\":" + str(frais_garde_credit) + ",\"ir_after_credit_cents\":" + str(ir_after_credit) + ",\"marginal_rate_pct\":" + pct_str(ir_marginal) + ",\"note\":\"progressive barème + plafonnement QF (situation-aware) + décote; 10% frais per salary stream; foncier deficit 10700 cap; pension alimentaire art. 156 + PER art. 163 quatervicies (deductions from revenu global); dons art. 200 + pinel/denormandie art. 199 novovicies + malraux art. 199 tervicies + censi-bouvard art. 199 sexvicies + scolarité art. 199 quater F + ir-pme/fcpi-fip art. 199 terdecies + sofica art. 199 quater E + forest art. 199 decies HA (réductions); emploi à domicile art. 199 sexdecies + frais de garde art. 200 quater B (crédits); plafonnement global art. 200-0 A (10k / 18k sofica cap)\"}"
    out = out + ",\"tva\":{\"ca_cents\":" + str(tva_ca) + ",\"ca_eur\":\"" + fmt_cents(tva_ca) + "\",\"franchise_eligible\":" + json(tva_eligible == 1) + ",\"threshold_services_cents\":" + str(tva_franchise_services) + ",\"threshold_services_majore_cents\":" + str(tva_franchise_services_maj) + ",\"threshold_vente_cents\":" + str(tva_franchise_vente) + ",\"threshold_vente_majore_cents\":" + str(tva_franchise_vente_maj) + ",\"rsi_eligible\":" + json(tva_rsi_eligible == 1) + ",\"rsi_threshold_services_cents\":" + str(tva_rsi_services) + ",\"rsi_threshold_services_majore_cents\":" + str(tva_rsi_services_maj) + ",\"rsi_threshold_vente_cents\":" + str(tva_rsi_vente) + ",\"rsi_threshold_vente_majore_cents\":" + str(tva_rsi_vente_maj) + ",\"rsi_tva_due_cap_cents\":" + str(tva_rsi_due_cap) + ",\"rn_eligible\":" + json(tva_rn_eligible == 1) + ",\"rn_threshold_services_cents\":" + str(tva_rn_services) + ",\"rn_threshold_vente_cents\":" + str(tva_rn_vente) + ",\"collectee_cents\":" + str(tva_collectee) + ",\"deductible_cents\":" + str(tva_deductible) + ",\"a_payer_cents\":" + str(tva_a_payer) + ",\"credit_cents\":" + str(tva_credit) + ",\"note\":\"franchise art. 293 B + régime simplifié art. 302 septies A + régime normal art. 287 (CA3 mensuel/trimestriel) + collectée/déductible art. 271 — TVA à payer = collectée - déductible (négatif = crédit)\"}"
    out = out + ",\"pas\":{\"monthly_base_cents\":" + str(pas_monthly_base) + ",\"monthly_base_eur\":\"" + fmt_cents(pas_monthly_base) + "\",\"taux_neutre_pct\":" + pct_str(pas_rate) + ",\"monthly_prepayment_cents\":" + str(pas_monthly) + ",\"monthly_prepayment_eur\":\"" + fmt_cents(pas_monthly) + "\",\"annual_estimate_cents\":" + str(pas_monthly*12) + ",\"taux_personnalise_pct\":" + pct_str(pas_personnalise_tenths) + ",\"monthly_prepayment_personnalise_cents\":" + str(pas_personnalise_monthly) + ",\"note\":\"taux neutre + taux personnalisé (art. 204 H CGI) — estimate for monthly provisioning; v1 simplification of the BOFiP formula\"}"
    out = out + ",\"reductions\":{\"dons\":{\"gross_cents\":" + str(g_dons) + ",\"base_75_cents\":" + str(dons_75_base) + ",\"base_66_cents\":" + str(dons_66_base) + ",\"reduction_cents\":" + str(dons_reduction) + ",\"note\":\"art. 200 CGI — 75% to 1000 EUR, 66% to 20% of revenu imposable\"},\"pinel\":{\"investment_cents\":" + str(g_pinel) + ",\"engagement_years\":" + str(pinel_years) + ",\"rate_pct\":" + pct_str(pinel_rate) + ",\"annual_reduction_cents\":" + str(pinel_reduction) + ",\"note\":\"art. 199 novovicies CGI — 12% 6y / 18% 9y / 21% 12y, cap 300000 EUR, spread over engagement\"},\"denormandie\":{\"investment_cents\":" + str(g_denorm) + ",\"engagement_years\":" + str(denorm_years) + ",\"rate_pct\":" + pct_str(denorm_rate) + ",\"annual_reduction_cents\":" + str(denorm_reduction) + ",\"note\":\"art. 199 novovicies IV bis CGI — ancien with works (≥25%), 12/18/21% by engagement, cap 300000 EUR\"},\"malraux\":{\"depenses_cents\":" + str(g_malraux) + ",\"zone\":\"" + malraux_zone + "\",\"rate_pct\":" + pct_str(malraux_rate) + ",\"reduction_cents\":" + str(malraux_reduction) + ",\"note\":\"art. 199 tervicies CGI — 30% PSMV / 22% PVAP, cap 400000 EUR, hors plafonnement niches\"},\"censi_bouvard\":{\"investment_cents\":" + str(g_censi) + ",\"engagement_years\":" + str(censi_years) + ",\"rate_pct\":" + pct_str(censi_rate) + ",\"annual_reduction_cents\":" + str(censi_reduction) + ",\"note\":\"art. 199 sexvicies CGI — 11% LMNP résidences de services, cap 300000 EUR, spread over 9y\"},\"scolarite\":{\"forfaitaire_cents\":" + str(g_scol_pos) + ",\"reduction_cents\":" + str(scolarite_reduction) + ",\"note\":\"art. 199 quater F CGI — forfait 61 collège / 153 lycée / 183 supérieur per child (half in alterné)\"},\"ir_pme\":{\"versements_cents\":" + str(g_pme_pos) + ",\"rate_pct\":" + pct_str(pme_rate) + ",\"cap_cents\":" + str(pme_cap) + ",\"reduction_cents\":" + str(ir_pme_reduction) + ",\"note\":\"art. 199 terdecies-0 A CGI — 18% PME, cap 50000 single / 100000 couple, plafonnement niches NOT modeled\"},\"frais_garde\":{\"depenses_cents\":" + str(g_fg_pos) + ",\"rate_pct\":" + pct_str(fg_rate) + ",\"cap_per_child_cents\":" + str(fg_cap) + ",\"credit_cents\":" + str(frais_garde_credit) + ",\"note\":\"art. 200 quater B CGI — 50% crédit, cap 3500/child, refundable\"},\"emploi_domicile\":{\"depenses_cents\":" + str(g_emploi) + ",\"base_cents\":" + str(ed_base) + ",\"credit_cents\":" + str(emploi_credit) + ",\"note\":\"art. 199 sexdecies CGI — 50% crédit, cap 12000 EUR (refundable if > IR)\"},\"fcpi_fip\":{\"versements_cents\":" + str(g_ff_pos) + ",\"rate_pct\":" + pct_str(ff_rate) + ",\"cap_cents\":" + str(ff_cap) + ",\"reduction_cents\":" + str(fcpi_fip_reduction) + ",\"note\":\"art. 199 terdecies-0 A VI CGI — 18% FCPI/FIP, cap 12000 single / 24000 couple, plafonnement niches\"},\"sofica\":{\"versements_cents\":" + str(g_so_pos) + ",\"rate_pct\":" + pct_str(so_rate) + ",\"cap_cents\":" + str(so_cap) + ",\"reduction_cents\":" + str(sofica_reduction) + ",\"note\":\"art. 199 quater E CGI — 30% SOFICA, cap 18000 OR 25% revenu net, plafonnement 18k\"},\"forest\":{\"versements_cents\":" + str(g_fo_pos) + ",\"rate_pct\":" + pct_str(fo_rate) + ",\"cap_cents\":" + str(fo_cap) + ",\"reduction_cents\":" + str(forest_reduction) + ",\"note\":\"art. 199 decies HA CGI — 22% forest, cap 5700 single / 6250 couple, plafonnement niches\"},\"plafonnement_global\":{\"cap_cents\":" + str(pg_cap) + ",\"cap_sofica_cents\":" + str(pg_cap_sofica) + ",\"niche_total_cents\":" + str(niche_total) + ",\"cap_effective_cents\":" + str(pg_cap_effective) + ",\"excess_cents\":" + str(pg_excess) + ",\"note\":\"art. 200-0 A CGI — caps total niche advantage at 10k (18k with SOFICA); applies to pinel/denorm/censi/ir_pme/fcpi_fip/forest/sofica/emploi_domicile/frais_garde\"}}"
