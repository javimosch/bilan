// ledger — the domain logic. Each operation has a *_json core returning (out, code, err)
// so BOTH the CLI commands and the HTTP handlers render the exact same JSON; the cmd_*
// wrappers only parse argv and die() on errors. All money is integer cents.

type Idrow struct { id string }
type Kindrow struct { kind string  total int  n int }
type Nrow struct { n int }

// changes_n — rows touched by the last statement on db (INSERT OR IGNORE writes 0
// when the UNIQUE key collides — sqlite_exec's own return value does NOT tell you).
func changes_n(db) (n) {
    n = 0
    rows := sqlite_query(db, "SELECT changes() AS n", []string{})
    parsed := parse(rows, []Nrow{})
    if len(parsed) > 0 { n = parsed[0].n }
}

// stream_ref — resolve a stream by exact name or exact id; "" when unknown (callers die 94).
func stream_ref(db, q) (id) {
    id = ""
    rows := sqlite_query(db, "SELECT id FROM streams WHERE name=?", []string{q})
    if rows != "[]" && rows != "" {
        parsed := parse(rows, []Idrow{})
        if len(parsed) > 0 { id = parsed[0].id  return id }
    }
    rows = sqlite_query(db, "SELECT id FROM streams WHERE id=?", []string{q})
    if rows != "[]" && rows != "" {
        parsed := parse(rows, []Idrow{})
        if len(parsed) > 0 { id = parsed[0].id }
    }
}

// kind_ok — the closed v0 set of stream kinds. The tax compute switches on these, so
// an unknown kind is rejected at the door instead of silently skipped by the radar.
func kind_ok(k) (ok) {
    ok = 0
    if k == "salary" { ok = 1  return ok }
    if k == "bnc" { ok = 1  return ok }
    if k == "bic" { ok = 1  return ok }
    if k == "rent" { ok = 1  return ok }
    if k == "crypto" { ok = 1  return ok }
    if k == "trading" { ok = 1  return ok }
    if k == "dividends" { ok = 1  return ok }
    if k == "dons" { ok = 1  return ok }
    if k == "emploi_domicile" { ok = 1  return ok }
    if k == "pinel" { ok = 1  return ok }
    if k == "denormandie" { ok = 1  return ok }
    if k == "malraux" { ok = 1  return ok }
    if k == "foncier_reel" { ok = 1  return ok }
    if k == "other" { ok = 1  return ok }
}

// ── stream ──────────────────────────────────────────────────────────────────

func stream_add(db, name, kind, cur) (out, code, err) {
    if name == "" || kind == "" { return "", 80, "usage: bilan stream add <name> --kind salary|bnc|bic|rent|crypto|trading|dividends|dons|emploi_domicile|pinel|denormandie|malraux|foncier_reel|other [--currency EUR]" }
    if kind_ok(kind) == 0 { return "", 80, "unknown kind: " + kind + " (salary|bnc|bic|rent|crypto|trading|dividends|dons|emploi_domicile|pinel|denormandie|malraux|foncier_reel|other)" }
    if stream_ref(db, name) != "" { return "", 93, "stream already exists: " + name }
    id := to_hex(rand_bytes(8))
    sqlite_exec(db, "INSERT INTO streams(id,name,kind,currency,created) VALUES(?,?,?,?,?)", []string{id, name, kind, cur, str(now_ms())})
    out = "{\"ok\":true,\"stream\":\"" + esc(name) + "\",\"id\":\"" + id + "\",\"kind\":\"" + esc(kind) + "\",\"currency\":\"" + esc(cur) + "\"}"
    code = 0
    err = ""
}

func stream_list_json(db) (out) {
    rows := sqlite_query(db, "SELECT id, name, kind, currency FROM streams ORDER BY name", []string{})
    out = "{\"ok\":true,\"streams\":" + rows + "}"
}

// ── tx ──────────────────────────────────────────────────────────────────────

// tx_add — one manual transaction. ext_id defaults to a content key of
// (date,cents,label) so re-adding the same line is a no-op, not a dupe.
func tx_add(db, stream_q, date, amount, label, source, ext_in) (out, code, err) {
    sid := stream_ref(db, stream_q)
    if sid == "" { return "", 94, "no such stream: " + stream_q + " (create it: bilan stream add " + stream_q + " --kind ...)" }
    if date_ok(date) == 0 { return "", 80, "bad date \"" + date + "\" — want YYYY-MM-DD" }
    if parse_cents_ok(amount) == 0 { return "", 80, "bad amount \"" + amount + "\" — want a number, e.g. 1234.56 or -12" }
    cents := parse_cents(amount)
    if cents == 0 { return "", 80, "zero-amount tx — a 0.00 line carries no information; skip it in the source export" }
    if date > today_str() { return "", 80, "future-dated tx (" + date + " > today " + today_str() + ") — the ledger records realized events, not plans" }
    if source == "" { source = "manual" }
    ext := ext_in
    if ext == "" { ext = "manual:" + date + ":" + str(cents) + ":" + label }
    id := to_hex(rand_bytes(8))
    sqlite_exec(db, "INSERT OR IGNORE INTO txs(id,stream_id,date,cents,label,source,ext_id,created) VALUES(?,?,?,?,?,?,?,?)", []string{id, sid, date, str(cents), label, source, ext, str(now_ms())})
    if changes_n(db) == 0 { out = "{\"ok\":true,\"duplicate\":true,\"id\":null,\"hint\":\"identical (stream,date,amount,label) already imported — nothing written\"}"  code = 0  err = ""  return out, code, err }
    out = "{\"ok\":true,\"id\":\"" + id + "\",\"stream\":\"" + esc(stream_q) + "\",\"date\":\"" + date + "\",\"cents\":" + str(cents) + "}"
    code = 0
    err = ""
}

func tx_list_json(db, stream_q, year, limit) (out, code, err) {
    where := ""
    params := []string{}
    if stream_q != "" {
        sid := stream_ref(db, stream_q)
        if sid == "" { return "", 94, "no such stream: " + stream_q }
        where = "t.stream_id=?"
        params = append(params, sid)
    }
    if year != "" {
        if parse_cents_ok(year) == 0 { return "", 80, "bad --year: " + year }
        if where != "" { where = where + " AND " }
        where = where + "t.date>=? AND t.date<=?"
        params = append(params, year+"-01-01")
        params = append(params, year+"-12-31")
    }
    if limit == "" { limit = "50" }
    sql := "SELECT t.id, t.date, t.cents, t.label, t.source, s.name AS stream FROM txs t JOIN streams s ON s.id=t.stream_id"
    if where != "" { sql = sql + " WHERE " + where }
    sql = sql + " ORDER BY t.date DESC, t.rowid DESC LIMIT ?"
    params = append(params, limit)
    rows := sqlite_query(db, sql, params)
    out = "{\"ok\":true,\"txs\":" + rows + "}"
    code = 0
    err = ""
}

// ── import ──────────────────────────────────────────────────────────────────

// import_csv — map a broker/bank CSV's header to (date, amount, label) columns and
// insert every parseable row. source: etoro | revolut | generic. Idempotent: the
// (stream, ext_id) UNIQUE key is derived from row content, so re-importing the same
// file inserts nothing new.
func import_csv(db, source, body, stream_q) (out, code, err) {
    sid := stream_ref(db, stream_q)
    if sid == "" { return "", 94, "no such stream: " + stream_q }
    lines := split(body, "\n")
    if len(lines) < 2 { return "", 80, "no data rows (need a header line + at least one row)" }
    // sniff the delimiter from the header: fr Excel exports use ";" (more of them
    // than commas), anglo exports use ",". Wrong delimiter = every row one cell.
    sep := ","
    hline := trim_cr(lines[0])
    sc := 0
    cc := 0
    j := 0
    for j < len(hline) {
        c := substr(hline, j, j+1)
        if c == ";" { sc = sc + 1 }
        if c == "," { cc = cc + 1 }
        j = j + 1
    }
    if sc > cc { sep = ";" }
    head := csv_split(trim_cr(lines[0]), sep)
    lower_head := to_lower(trim_cr(lines[0]))
    datecol := -1
    amtcol := -1
    labcol := -1
    if source == "etoro" || contains(lower_head, "profit") {
        datecol = col_find(head, "close date")
        if datecol < 0 { datecol = col_find(head, "date") }
        amtcol = col_find(head, "profit")
        if amtcol < 0 { amtcol = col_find(head, "amount") }
        labcol = col_find(head, "details")
        if labcol < 0 { labcol = col_find(head, "action") }
    } else if source == "revolut" || contains(lower_head, "completed date") {
        datecol = col_find(head, "completed date")
        if datecol < 0 { datecol = col_find(head, "date") }
        amtcol = col_find(head, "amount")
        labcol = col_find(head, "description")
    } else {
        datecol = col_find(head, "date")
        amtcol = col_find(head, "amount")
        if amtcol < 0 { amtcol = col_find(head, "montant") }
        labcol = col_find(head, "label")
        if labcol < 0 { labcol = col_find(head, "description") }
        if labcol < 0 { labcol = col_find(head, "details") }
    }
    if datecol < 0 || amtcol < 0 { return "", 80, "could not find date/amount columns in the header (source=" + source + ") — rename the columns to date/amount/label, or pick the right source" }
    inserted := 0
    skipped := 0
    i := 1
    for i < len(lines) {
        line := trim_cr(lines[i])
        if trim(line) == "" { i = i + 1  continue }
        cells := csv_split(line, sep)
        d := ""
        if datecol < len(cells) { d = norm_date(cells[datecol]) }
        amtc := ""
        if amtcol < len(cells) { amtc = trim(cells[amtcol]) }
        if d == "" || parse_cents_ok(amtc) == 0 { skipped = skipped + 1  i = i + 1  continue }
        cents := parse_cents(amtc)
        if cents == 0 || d > today_str() { skipped = skipped + 1  i = i + 1  continue }
        label := ""
        if labcol >= 0 && labcol < len(cells) { label = trim(cells[labcol]) }
        ext := source + ":" + d + ":" + str(cents) + ":" + label
        sqlite_exec(db, "INSERT OR IGNORE INTO txs(id,stream_id,date,cents,label,source,ext_id,created) VALUES(?,?,?,?,?,?,?,?)", []string{to_hex(rand_bytes(8)), sid, d, str(cents), label, source, ext, str(now_ms())})
        if changes_n(db) > 0 { inserted = inserted + 1 } else { skipped = skipped + 1 }
        i = i + 1
    }
    sqlite_exec(db, "INSERT INTO imports(id,source,file,rows,skipped,ts) VALUES(?,?,?,?,?,?)", []string{to_hex(rand_bytes(8)), source, "stdin", str(inserted), str(skipped), str(now_ms())})
    out = "{\"ok\":true,\"source\":\"" + esc(source) + "\",\"stream\":\"" + esc(stream_q) + "\",\"inserted\":" + str(inserted) + ",\"skipped\":" + str(skipped) + "}"
    code = 0
    err = ""
}

func trim_cr(s) (o) {
    o = s
    if len(o) > 0 && substr(o, len(o)-1, len(o)) == "\r" { o = substr(o, 0, len(o)-1) }
}

// norm_date — accept "YYYY-MM-DD…" (first 10 chars) or "DD/MM/YYYY…" (fr exports);
// anything else is "" (the row is skipped and counted, never guessed).
func norm_date(s) (d) {
    d = ""
    t := trim(s)
    if len(t) >= 10 && substr(t, 4, 5) == "-" { d = substr(t, 0, 10)  return d }
    if len(t) >= 10 && substr(t, 2, 3) == "/" && substr(t, 5, 6) == "/" {
        d = substr(t, 6, 10) + "-" + substr(t, 3, 5) + "-" + substr(t, 0, 2)
        return d
    }
}

// ── stats + tax radar ───────────────────────────────────────────────────────

// kind_sums — signed per-kind totals for a date range (the one query both stats and
// tax build on). Kinds with no txs are absent from the result.
func kind_sums(db, dfrom, dto) (kinds) {
    rows := sqlite_query(db, "SELECT s.kind AS kind, SUM(t.cents) AS total, COUNT(*) AS n FROM txs t JOIN streams s ON s.id=t.stream_id WHERE t.date>=? AND t.date<=? GROUP BY s.kind ORDER BY s.kind", []string{dfrom, dto})
    kinds = parse(rows, []Kindrow{})
}

// kind_get — the sum for one kind, 0 when absent.
func kind_get(kinds, k) (v) {
    v = 0
    i := 0
    for i < len(kinds) {
        if kinds[i].kind == k { v = kinds[i].total  return v }
        i = i + 1
    }
}

// kind_n — the tx count for one kind, 0 when absent.
func kind_n(kinds, k) (v) {
    v = 0
    i := 0
    for i < len(kinds) {
        if kinds[i].kind == k { v = kinds[i].n  return v }
        i = i + 1
    }
}

type Streamsumrow struct { name string  total int }

// stream_sums_by_kind — per-stream signed totals for one kind in a date range. Used
// to apply the 10% frais abattement per salary stream (each member of the foyer gets
// their own abattement, art. 83 CGI). Returns []Streamsumrow.
func stream_sums_by_kind(db, dfrom, dto, kind) (rows) {
    r := sqlite_query(db, "SELECT s.name AS name, SUM(t.cents) AS total FROM txs t JOIN streams s ON s.id=t.stream_id WHERE t.date>=? AND t.date<=? AND s.kind=? GROUP BY s.id ORDER BY s.name", []string{dfrom, dto, kind})
    rows = parse(r, []Streamsumrow{})
}

// cmd_stats — per-kind signed totals for a year (the human-readable radar input).
func stats_json(db, year) (out, code, err) {
    kinds := kind_sums(db, year+"-01-01", year+"-12-31")
    out = "{\"ok\":true,\"year\":" + year + ",\"by_kind\":{"
    first := 1
    income := 0
    expense := 0
    count := 0
    i := 0
    for i < len(kinds) {
        k := kinds[i]
        if first == 0 { out = out + "," }
        out = out + "\"" + esc(k.kind) + "\":{\"cents\":" + str(k.total) + ",\"eur\":\"" + fmt_cents(k.total) + "\",\"tx\":" + str(k.n) + "}"
        first = 0
        if k.total > 0 { income = income + k.total } else { expense = expense + k.total }
        count = count + k.n
        i = i + 1
    }
    out = out + "},\"income_cents\":" + str(income) + ",\"expense_cents\":" + str(expense) + ",\"net_cents\":" + str(income+expense) + ",\"net_eur\":\"" + fmt_cents(income+expense) + "\",\"tx_count\":" + str(count) + "}"
    code = 0
    err = ""
}

// deficit_carried — the BNC/BIC deficit carried forward into `year`. Scans the prior
// 6 years (the legal carry-forward window for IR-regime deficits), tracks a running
// pool: a negative net adds to the pool, a positive net uses it up (FIFO, oldest
// first). Returns the available deficit in cents (0 if none). Computed, not stored.
// NOTE: micro-BNC/BIC cannot legally generate deficits (forfaitaire abattement) — this
// is a régime-réel feature exposed for agents who track both; the radar applies it to
// the gross before the abattement as a v1 simplification.
func deficit_carried(db, year, kind) (deficit) {
    deficit = 0
    yi := parse_int(year)
    i := 6
    for i > 0 {
        py := yi - i
        pys := str(py)
        sums := kind_sums(db, pys+"-01-01", pys+"-12-31")
        net := kind_get(sums, kind)
        if net < 0 { deficit = deficit + (-net) }
        if net > 0 { deficit = deficit - net  if deficit < 0 { deficit = 0 } }
        i = i - 1
    }
    if deficit < 0 { deficit = 0 }
}

// bareme_on_quotient — the 5-bracket progressive scale applied to one quotient (the
// net imposable divided by parts). Returns the IR for ONE part at that quotient, plus
// the marginal rate tenths. The caller multiplies by parts. Brackets are DATA.
func bareme_on_quotient(db, year, q) (ir, marginal) {
    ir = 0
    marginal = 0
    t2 := rule_int(db, year, "ir_bareme", "bracket_2_threshold_cents", 1149700)
    r2 := rule_int(db, year, "ir_bareme", "bracket_2_rate_tenths", 110)
    t3 := rule_int(db, year, "ir_bareme", "bracket_3_threshold_cents", 2931500)
    r3 := rule_int(db, year, "ir_bareme", "bracket_3_rate_tenths", 300)
    t4 := rule_int(db, year, "ir_bareme", "bracket_4_threshold_cents", 8382300)
    r4 := rule_int(db, year, "ir_bareme", "bracket_4_rate_tenths", 410)
    t5 := rule_int(db, year, "ir_bareme", "bracket_5_threshold_cents", 18029400)
    r5 := rule_int(db, year, "ir_bareme", "bracket_5_rate_tenths", 450)
    hi := t3
    if q < hi { hi = q }
    if hi > t2 { ir = ir + (hi - t2) * r2 / 1000  marginal = r2 }
    hi = t4
    if q < hi { hi = q }
    if hi > t3 { ir = ir + (hi - t3) * r3 / 1000  marginal = r3 }
    hi = t5
    if q < hi { hi = q }
    if hi > t4 { ir = ir + (hi - t4) * r4 / 1000  marginal = r4 }
    if q > t5 { ir = ir + (q - t5) * r5 / 1000  marginal = r5 }
}

// ir_compute — progressive IR barème + plafonnement du quotient familial + décote.
// Quotient familial uses demi-parts (integer): 1 part = 2 demi-parts, couple + 1 child
// = 5 demi-parts. Falls back to `parts`×2 when `demi_parts` is unset (0). Plafonnement
// (art. 197 CGI I.2): the tax advantage from demi-parts beyond the base (1 part
// célibataire / 2 couple) is capped at 1,791 EUR per demi-part (2024 income). Then the
// décote (art. 197 CGI 4°I). Returns (ir_after_decote, marginal, demi_parts, decote, qf_cap_applied).
func ir_compute(db, year, base) (ir, marginal, demi_parts, decote, qf_capped) {
    demi_parts = rule_int(db, year, "ir_bareme", "demi_parts", 0)
    if demi_parts == 0 {
        p := rule_int(db, year, "ir_bareme", "parts", 1)
        if p < 1 { p = 1 }
        demi_parts = p * 2
    }
    if demi_parts < 2 { demi_parts = 2 }
    base_parts := rule_int(db, year, "ir_bareme", "base_parts", 1)
    if base_parts < 1 { base_parts = 1 }
    base_demi := base_parts * 2
    // IR with QF: barème on (base × 2 / demi_parts), multiplied back by demi_parts / 2.
    q := base * 2 / demi_parts
    ir_on_q, m := bareme_on_quotient(db, year, q)
    ir = ir_on_q * demi_parts / 2
    marginal = m
    decote = 0
    qf_capped = 0
    // Plafonnement du quotient familial (art. 197 CGI I.2): compare IR with QF vs IR
    // at the base parts; if the advantage exceeds the cap, recompute IR = IR_base - cap.
    // The cap depends on the 'situation' rule (art. 197 IV/V CGI — special caps for
    // parent isolé, veuf, personne-seule invalide/ancien combattant).
    extra_demi := demi_parts - base_demi
    if extra_demi > 0 {
        q_base := base * 2 / base_demi
        ir_base_on_q, _ := bareme_on_quotient(db, year, q_base)
        ir_base := ir_base_on_q * base_demi / 2
        advantage := ir_base - ir
        situation := rule_str(db, year, "ir_bareme", "situation", "default")
        cap := 0
        if situation == "parent_isole" {
            // art. 197 IV CGI: fixed total cap on the parent-isolé majoration.
            cap = rule_int(db, year, "ir_bareme", "qf_parent_isole_cap_cents", 426200)
        } else if situation == "veuf" {
            // art. 197 V CGI: per-demi-part cap + complementary reduction.
            cap_per := rule_int(db, year, "ir_bareme", "qf_veuf_cap_per_demi_part_cents", 180700)
            complementary := rule_int(db, year, "ir_bareme", "qf_veuf_complementary_cents", 201100)
            cap = extra_demi * cap_per + complementary
        } else if situation == "personne_seule_invalide" {
            // anciens combattants / invalides: single demi-part, 1807 + 1801 = 3608.
            cap = rule_int(db, year, "ir_bareme", "qf_personne_seule_invalide_cap_cents", 360800)
        } else {
            cap_per := rule_int(db, year, "ir_bareme", "qf_cap_per_demi_part_cents", 179100)
            cap = extra_demi * cap_per
        }
        if advantage > cap {
            ir = ir_base - cap
            if ir < 0 { ir = 0 }
            qf_capped = 1
        }
    }
    // décote (art. 197 CGI 4°I): plafond - coeff × IR, when the result is positive.
    plafond := rule_int(db, year, "ir_bareme", "decote_plafond_cents", 88900)
    coeff := rule_int(db, year, "ir_bareme", "decote_coefficient_milliemes", 4525)
    if ir > 0 && coeff > 0 {
        decote = plafond - ir * coeff / 10000
        if decote > 0 {
            ir = ir - decote
            if ir < 0 { ir = 0 }
        } else {
            decote = 0
        }
    }
}

// tax_json — the tax radar: deterministic regime math over the year's sums. Every rate
// comes from tax_rules (rule_int), never from code, so a loi de finances change is an
// UPDATE, not a release. Estimates only — the décote and the 10% frais abattement on
// salary are v1; the progressive IR barème IS computed here (net imposable -> brackets).
func tax_json(db, year) (out, code, err) {
    // a deterministic tool must never answer with the wrong year's rates: if no
    // rate card exists for the requested year, error instead of silently falling
    // back to the seeded defaults (a cold agent would trust the plausible JSON).
    nrows := sqlite_query(db, "SELECT COUNT(*) AS n FROM tax_rules WHERE year=CAST(? AS INTEGER)", []string{year})
    nr := parse(nrows, []Countrow{})
    if len(nr) == 0 || nr[0].n == 0 {
        return "", 94, "no rate card for year " + year + " (seeded: " + str(current_year()) + ") — add one first: bilan rule set " + year + " micro_bnc deduction_pct_tenths 340"
    }
    kinds := kind_sums(db, year+"-01-01", year+"-12-31")
    g_bnc := kind_get(kinds, "bnc")
    g_bic := kind_get(kinds, "bic")
    g_rent := kind_get(kinds, "rent")
    g_rent_reel := kind_get(kinds, "foncier_reel")
    g_crypto := kind_get(kinds, "crypto")
    g_trade := kind_get(kinds, "trading")
    g_div := kind_get(kinds, "dividends")
    g_salary := kind_get(kinds, "salary")
    rate_ded_bnc := rule_int(db, year, "micro_bnc", "deduction_pct_tenths", 340)
    rate_soc_bnc := rule_int(db, year, "micro_bnc", "social_pct_tenths", 246)
    rate_ded_bic := rule_int(db, year, "micro_bic_services", "deduction_pct_tenths", 500)
    rate_soc_bic := rule_int(db, year, "micro_bic_services", "social_pct_tenths", 212)
    rate_ded_fon := rule_int(db, year, "micro_foncier", "deduction_pct_tenths", 300)
    rate_soc_fon := rule_int(db, year, "micro_foncier", "social_pct_tenths", 172)
    rate_pfu := rule_int(db, year, "capital", "pfu_pct_tenths", 314)
    thr := rule_int(db, year, "capital", "crypto_exempt_threshold_cents", 30500)
    // deficits carried forward (BNC/BIC, 6-year window, computed from history)
    def_bnc := deficit_carried(db, year, "bnc")
    def_bic := deficit_carried(db, year, "bic")
    adj_bnc := g_bnc - def_bnc
    if adj_bnc < 0 { adj_bnc = 0 }
    adj_bic := g_bic - def_bic
    if adj_bic < 0 { adj_bic = 0 }
    ab_bnc := adj_bnc * rate_ded_bnc / 1000
    soc_bnc := adj_bnc * rate_soc_bnc / 1000
    net_bnc := adj_bnc - ab_bnc
    ab_bic := adj_bic * rate_ded_bic / 1000
    soc_bic := adj_bic * rate_soc_bic / 1000
    net_bic := adj_bic - ab_bic
    // foncier: micro-foncier abattement when positive; déficit foncier imputation on
    // revenu global (art. 156 CGI I.3°) when negative — up to 10,700 EUR/year reduces
    // the IR base, the excess carries 10y on revenus fonciers. Régime réel feature
    // applied to the micro base as a v1 simplification.
    // RÉGIME RÉEL FONCIER (art. 29-31 CGI): if a 'foncier_reel' stream exists, the
    // radar combines micro + réel: micro-foncier (rent stream) with 30% abattement,
    // PLUS réel (foncier_reel stream) = loyer - charges (intérêts d'emprunt, travaux,
    // etc.) with NO abattement. The net réel can be negative (deficit) — same 10,700
    // imputation + 10y carry. Source: BOFiP BOI-RFPI-BASE-20-80.
    foncier_global_imputation := 0
    foncier_carry_excess := 0
    ab_fon := 0
    net_fon := 0
    soc_fon := 0
    foncier_reel_net := 0
    foncier_reel_note := ""
    if g_rent_reel != 0 {
        // Régime réel: net = signed sum (positive loyer - negative charges). No
        // abattement. Social 17.2% on net if positive.
        foncier_reel_net = g_rent_reel
        rate_soc_fon_reel := rule_int(db, year, "foncier_reel", "social_pct_tenths", 172)
        if foncier_reel_net >= 0 {
            soc_fon = soc_fon + foncier_reel_net * rate_soc_fon_reel / 1000
            net_fon = net_fon + foncier_reel_net
            foncier_reel_note = "régime réel foncier (art. 29-31 CGI): net = loyer - charges, no abattement"
        } else {
            // Déficit foncier réel: same 10,700 imputation + 10y carry as micro.
            deficit_reel := -foncier_reel_net
            foncier_cap := rule_int(db, year, "micro_foncier", "deficit_global_cap_cents", 1070000)
            imputation_reel := deficit_reel
            if imputation_reel > foncier_cap { imputation_reel = foncier_cap }
            foncier_global_imputation = foncier_global_imputation + imputation_reel
            foncier_carry_excess = foncier_carry_excess + (deficit_reel - imputation_reel)
            foncier_reel_note = "régime réel foncier (art. 29-31 CGI): déficit — 10700 on global + 10y carry"
        }
    }
    if g_rent >= 0 {
        ab_fon = g_rent * rate_ded_fon / 1000
        net_fon = net_fon + g_rent - ab_fon
        soc_fon = soc_fon + (g_rent - ab_fon) * rate_soc_fon / 1000
    } else {
        deficit_fon := -g_rent
        foncier_cap := rule_int(db, year, "micro_foncier", "deficit_global_cap_cents", 1070000)
        foncier_global_imputation = foncier_global_imputation + deficit_fon
        if foncier_global_imputation > foncier_cap { foncier_global_imputation = foncier_cap }
        foncier_carry_excess = foncier_carry_excess + (deficit_fon - foncier_cap)
    }
    crypto_exempt := 0
    if g_crypto >= 0 && g_crypto < thr { crypto_exempt = 1 }
    taxable := g_crypto + g_trade
    if taxable < 0 { taxable = 0 }
    cap_tax := taxable * rate_pfu / 1000
    div_tax := 0
    if g_div > 0 { div_tax = g_div * rate_pfu / 1000 }
    // 10% frais abattement on salary (art. 83 CGI), applied PER STREAM (each member
    // of the foyer gets their own abattement: 10% of gross, min 509 / max 14555).
    frais_pct := rule_int(db, year, "salary", "frais_abattement_pct_tenths", 100)
    frais_min := rule_int(db, year, "salary", "frais_abattement_min_cents", 50900)
    frais_max := rule_int(db, year, "salary", "frais_abattement_max_cents", 1455500)
    salary_streams := stream_sums_by_kind(db, year+"-01-01", year+"-12-31", "salary")
    salary_frais := 0
    net_salary := 0
    si := 0
    for si < len(salary_streams) {
        sg := salary_streams[si].total
        sf := sg * frais_pct / 1000
        if sf < frais_min { sf = frais_min }
        if sf > frais_max { sf = frais_max }
        if sf > sg { sf = sg }
        salary_frais = salary_frais + sf
        net_salary = net_salary + sg - sf
        si = si + 1
    }
    // progressive IR barème + plafonnement QF + décote on the net imposable.
    // The foncier global imputation reduces the base (art. 156 CGI I.3°).
    ir_base := net_bnc + net_bic + net_fon + net_salary - foncier_global_imputation
    if ir_base < 0 { ir_base = 0 }
    ir_cents, ir_marginal, ir_demi_parts, ir_decote, ir_qf_capped := ir_compute(db, year, ir_base)
    // Réductions d'impôt — dons (art. 200 CGI). Dons are recorded as negative txs in
    // a "dons" stream; the radar takes the absolute sum. 75% up to 1000 EUR (aide aux
    // personnes en difficulté), then 66% up to 20% of revenu imposable.
    g_dons := -kind_get(kinds, "dons")
    if g_dons < 0 { g_dons = 0 }
    dons_75_rate := rule_int(db, year, "dons", "rate_75_pct_tenths", 750)
    dons_75_cap := rule_int(db, year, "dons", "rate_75_cap_cents", 100000)
    dons_66_rate := rule_int(db, year, "dons", "rate_66_pct_tenths", 660)
    dons_66_cap_pct := rule_int(db, year, "dons", "rate_66_cap_revenu_pct_tenths", 200)
    dons_75_base := g_dons
    if dons_75_base > dons_75_cap { dons_75_base = dons_75_cap }
    dons_66_base := g_dons - dons_75_base
    dons_66_cap := ir_base * dons_66_cap_pct / 1000
    if dons_66_base > dons_66_cap { dons_66_base = dons_66_cap }
    dons_reduction := dons_75_base * dons_75_rate / 1000 + dons_66_base * dons_66_rate / 1000
    // Crédit d'impôt emploi à domicile (art. 199 sexdecies CGI). Dépenses recorded as
    // negative txs in an 'emploi_domicile' stream. 50% of dépenses, capped at 12,000 EUR
    // (+1,500 EUR per personne à charge, max 15,000 EUR). This is a CRÉDIT (refundable
    // if it exceeds IR) — the radar reports it separately from réduction dons.
    g_emploi := -kind_get(kinds, "emploi_domicile")
    if g_emploi < 0 { g_emploi = 0 }
    ed_rate := rule_int(db, year, "emploi_domicile", "rate_pct_tenths", 500)
    ed_cap := rule_int(db, year, "emploi_domicile", "cap_cents", 1200000)
    ed_cap_total := rule_int(db, year, "emploi_domicile", "cap_total_cents", 1500000)
    ed_base := g_emploi
    if ed_base > ed_cap { ed_base = ed_cap }
    if ed_base > ed_cap_total { ed_base = ed_cap_total }
    emploi_credit := ed_base * ed_rate / 1000
    // Réduction d'impôt PINEL (art. 199 novovicies CGI). Investment recorded as a
    // positive tx in a 'pinel' stream. Rate by engagement duration (12% 6y / 18% 9y /
    // 21% 12y), capped at 300,000 EUR. The annual reduction = investment × rate / years.
    g_pinel := kind_get(kinds, "pinel")
    if g_pinel < 0 { g_pinel = 0 }
    pinel_cap := rule_int(db, year, "pinel", "cap_investment_cents", 30000000)
    pinel_years := rule_int(db, year, "pinel", "engagement_years", 9)
    if pinel_years < 1 { pinel_years = 1 }
    pinel_base := g_pinel
    if pinel_base > pinel_cap { pinel_base = pinel_cap }
    pinel_rate := 0
    if pinel_years <= 6 {
        pinel_rate = rule_int(db, year, "pinel", "rate_6y_pct_tenths", 120)
    } else if pinel_years <= 9 {
        pinel_rate = rule_int(db, year, "pinel", "rate_9y_pct_tenths", 180)
    } else {
        pinel_rate = rule_int(db, year, "pinel", "rate_12y_pct_tenths", 210)
    }
    pinel_reduction := pinel_base * pinel_rate / 1000 / pinel_years
    // Réduction d'impôt DENORMANDIE (art. 199 novovicies IV bis CGI). Same structure
    // as PINEL (12/18/21% by engagement, cap 300,000 EUR) but for ancien with works.
    g_denorm := kind_get(kinds, "denormandie")
    if g_denorm < 0 { g_denorm = 0 }
    denorm_cap := rule_int(db, year, "denormandie", "cap_investment_cents", 30000000)
    denorm_years := rule_int(db, year, "denormandie", "engagement_years", 9)
    if denorm_years < 1 { denorm_years = 1 }
    denorm_base := g_denorm
    if denorm_base > denorm_cap { denorm_base = denorm_cap }
    denorm_rate := 0
    if denorm_years <= 6 {
        denorm_rate = rule_int(db, year, "denormandie", "rate_6y_pct_tenths", 120)
    } else if denorm_years <= 9 {
        denorm_rate = rule_int(db, year, "denormandie", "rate_9y_pct_tenths", 180)
    } else {
        denorm_rate = rule_int(db, year, "denormandie", "rate_12y_pct_tenths", 210)
    }
    denorm_reduction := denorm_base * denorm_rate / 1000 / denorm_years
    // Réduction d'impôt MALRAUX (art. 199 tervicies CGI). Restoration of immeubles in
    // sites patrimoniaux remarquables. Rate: 30% (PSMV) or 22% (PVAP), cap 400,000 EUR
    // of dépenses. NOT subject to plafonnement niches fiscales. Record dépenses as
    // positive txs in a 'malraux' stream.
    g_malraux := kind_get(kinds, "malraux")
    if g_malraux < 0 { g_malraux = 0 }
    malraux_cap := rule_int(db, year, "malraux", "cap_depenses_cents", 40000000)
    malraux_zone := rule_str(db, year, "malraux", "zone", "psmv")
    malraux_rate := rule_int(db, year, "malraux", "rate_psmv_pct_tenths", 300)
    if malraux_zone == "pvap" {
        malraux_rate = rule_int(db, year, "malraux", "rate_pvap_pct_tenths", 220)
    }
    malraux_base := g_malraux
    if malraux_base > malraux_cap { malraux_base = malraux_cap }
    malraux_reduction := malraux_base * malraux_rate / 1000
    ir_after_reductions := ir_cents - dons_reduction - pinel_reduction - denorm_reduction - malraux_reduction
    if ir_after_reductions < 0 { ir_after_reductions = 0 }
    // Emploi à domicile is a CRÉDIT (refundable) — it reduces the final tax even below
    // zero. The radar reports it in totals as a negative tax (credit to receive).
    ir_after_credit := ir_after_reductions - emploi_credit
    // TVA franchise en base (art. 293 B CGI). Checks whether the year's BNC+BIC gross
    // falls under the services threshold (36,800 EUR) or the vente threshold (91,900).
    // BNC is always services; BIC can be vente or services — we use the lower (services)
    // threshold as the conservative check. The operator overrides if they sell goods.
    tva_ca := g_bnc + g_bic
    if tva_ca < 0 { tva_ca = 0 }
    tva_franchise_services := rule_int(db, year, "tva", "franchise_services_cents", 3680000)
    tva_franchise_vente := rule_int(db, year, "tva", "franchise_vente_cents", 9190000)
    tva_franchise_services_maj := rule_int(db, year, "tva", "franchise_services_majore_cents", 3910000)
    tva_franchise_vente_maj := rule_int(db, year, "tva", "franchise_vente_majore_cents", 10100000)
    tva_eligible := 0
    tva_threshold := tva_franchise_services
    tva_threshold_maj := tva_franchise_services_maj
    if tva_ca <= tva_franchise_services { tva_eligible = 1 }
    // Prélèvement à la source — taux neutre mensuel (art. 204 H CGI). The radar
    // projects the annual net salary / 12 and applies the taux neutre grid to
    // estimate the monthly prepayment. This is the confidentiality grid (taux neutre),
    // not the personalized rate — it's an estimate for the "provision each month" loop.
    pas_monthly_base := net_salary / 12
    pas_rate := 0
    pi := 15
    for pi >= 2 {
        t := rule_int(db, year, "pas", "bracket_" + str(pi) + "_threshold_cents", 0)
        if pas_monthly_base >= t {
            pas_rate = rule_int(db, year, "pas", "bracket_" + str(pi) + "_rate_tenths", 0)
            pi = 0
        }
        pi = pi - 1
    }
    pas_monthly := pas_monthly_base * pas_rate / 1000
    // PAS taux personnalisé (art. 204 H CGI). The personalized rate = IR (before
    // reductions/crédits) / revenu imposable, expressed in tenths of a percent.
    // This is a v1 simplification of the BOFiP formula (which weights revenus in the
    // PAS champ vs RNI). It gives a taux moyen d'imposition, not a TMI.
    pas_personnalise_tenths := 0
    if ir_base > 0 {
        pas_personnalise_tenths = ir_cents * 1000 / ir_base
    }
    pas_personnalise_monthly := net_salary * pas_personnalise_tenths / 12000
    out = "{\"ok\":true,\"year\":" + year
    out = out + ",\"rates\":{\"pfu_pct\":" + pct_str(rate_pfu) + ",\"micro_bnc_abattement_pct\":" + pct_str(rate_ded_bnc) + ",\"micro_bnc_social_pct\":" + pct_str(rate_soc_bnc) + ",\"micro_bic_abattement_pct\":" + pct_str(rate_ded_bic) + ",\"micro_bic_social_pct\":" + pct_str(rate_soc_bic) + ",\"micro_foncier_abattement_pct\":" + pct_str(rate_ded_fon) + ",\"micro_foncier_social_pct\":" + pct_str(rate_soc_fon) + "}"
    out = out + ",\"regimes\":{"
    out = out + "\"bnc\":{\"gross_cents\":" + str(g_bnc) + ",\"gross_eur\":\"" + fmt_cents(g_bnc) + "\",\"deficit_carried_cents\":" + str(def_bnc) + ",\"adjusted_gross_cents\":" + str(adj_bnc) + ",\"abattement_cents\":" + str(ab_bnc) + ",\"net_ir_cents\":" + str(net_bnc) + ",\"social_cents\":" + str(soc_bnc) + "}"
    out = out + ",\"bic\":{\"gross_cents\":" + str(g_bic) + ",\"gross_eur\":\"" + fmt_cents(g_bic) + "\",\"deficit_carried_cents\":" + str(def_bic) + ",\"adjusted_gross_cents\":" + str(adj_bic) + ",\"abattement_cents\":" + str(ab_bic) + ",\"net_ir_cents\":" + str(net_bic) + ",\"social_cents\":" + str(soc_bic) + "}"
    out = out + ",\"foncier\":{\"gross_cents\":" + str(g_rent) + ",\"gross_eur\":\"" + fmt_cents(g_rent) + "\",\"abattement_cents\":" + str(ab_fon) + ",\"net_ir_cents\":" + str(net_fon) + ",\"social_cents\":" + str(soc_fon) + ",\"deficit_global_imputation_cents\":" + str(foncier_global_imputation) + ",\"deficit_carry_10y_cents\":" + str(foncier_carry_excess) + ",\"reel_net_cents\":" + str(foncier_reel_net) + ",\"reel_note\":\"" + esc(foncier_reel_note) + "\"}"
    out = out + ",\"salary\":{\"gross_cents\":" + str(g_salary) + ",\"gross_eur\":\"" + fmt_cents(g_salary) + "\",\"frais_abattement_cents\":" + str(salary_frais) + ",\"net_cents\":" + str(net_salary) + ",\"net_eur\":\"" + fmt_cents(net_salary) + "\",\"note\":\"10% frais per salary stream (per member of the foyer)\"}"
    out = out + "}"
    out = out + ",\"ir\":{\"base_cents\":" + str(ir_base) + ",\"base_eur\":\"" + fmt_cents(ir_base) + "\",\"situation\":\"" + rule_str(db, year, "ir_bareme", "situation", "default") + "\",\"demi_parts\":" + str(ir_demi_parts) + ",\"qf_capped\":" + json(ir_qf_capped == 1) + ",\"ir_before_decote_cents\":" + str(ir_cents+ir_decote) + ",\"decote_cents\":" + str(ir_decote) + ",\"ir_cents\":" + str(ir_cents) + ",\"ir_eur\":\"" + fmt_cents(ir_cents) + "\",\"dons_reduction_cents\":" + str(dons_reduction) + ",\"pinel_reduction_cents\":" + str(pinel_reduction) + ",\"denormandie_reduction_cents\":" + str(denorm_reduction) + ",\"malraux_reduction_cents\":" + str(malraux_reduction) + ",\"ir_after_reductions_cents\":" + str(ir_after_reductions) + ",\"emploi_credit_cents\":" + str(emploi_credit) + ",\"ir_after_credit_cents\":" + str(ir_after_credit) + ",\"marginal_rate_pct\":" + pct_str(ir_marginal) + ",\"note\":\"progressive barème + plafonnement QF (situation-aware) + décote; 10% frais per salary stream; foncier deficit 10700 cap; dons art. 200 + pinel/denormandie art. 199 novovicies + malraux art. 199 tervicies; emploi à domicile art. 199 sexdecies (crédit)\"}"
    out = out + ",\"tva\":{\"ca_cents\":" + str(tva_ca) + ",\"ca_eur\":\"" + fmt_cents(tva_ca) + "\",\"franchise_eligible\":" + json(tva_eligible == 1) + ",\"threshold_services_cents\":" + str(tva_franchise_services) + ",\"threshold_services_majore_cents\":" + str(tva_franchise_services_maj) + ",\"threshold_vente_cents\":" + str(tva_franchise_vente) + ",\"threshold_vente_majore_cents\":" + str(tva_franchise_vente_maj) + ",\"note\":\"franchise en base art. 293 B CGI — uses services threshold (conservative); override if you sell goods\"}"
    out = out + ",\"pas\":{\"monthly_base_cents\":" + str(pas_monthly_base) + ",\"monthly_base_eur\":\"" + fmt_cents(pas_monthly_base) + "\",\"taux_neutre_pct\":" + pct_str(pas_rate) + ",\"monthly_prepayment_cents\":" + str(pas_monthly) + ",\"monthly_prepayment_eur\":\"" + fmt_cents(pas_monthly) + "\",\"annual_estimate_cents\":" + str(pas_monthly*12) + ",\"taux_personnalise_pct\":" + pct_str(pas_personnalise_tenths) + ",\"monthly_prepayment_personnalise_cents\":" + str(pas_personnalise_monthly) + ",\"note\":\"taux neutre + taux personnalisé (art. 204 H CGI) — estimate for monthly provisioning; v1 simplification of the BOFiP formula\"}"
    out = out + ",\"reductions\":{\"dons\":{\"gross_cents\":" + str(g_dons) + ",\"base_75_cents\":" + str(dons_75_base) + ",\"base_66_cents\":" + str(dons_66_base) + ",\"reduction_cents\":" + str(dons_reduction) + ",\"note\":\"art. 200 CGI — 75% to 1000 EUR, 66% to 20% of revenu imposable\"},\"pinel\":{\"investment_cents\":" + str(g_pinel) + ",\"engagement_years\":" + str(pinel_years) + ",\"rate_pct\":" + pct_str(pinel_rate) + ",\"annual_reduction_cents\":" + str(pinel_reduction) + ",\"note\":\"art. 199 novovicies CGI — 12% 6y / 18% 9y / 21% 12y, cap 300000 EUR, spread over engagement\"},\"denormandie\":{\"investment_cents\":" + str(g_denorm) + ",\"engagement_years\":" + str(denorm_years) + ",\"rate_pct\":" + pct_str(denorm_rate) + ",\"annual_reduction_cents\":" + str(denorm_reduction) + ",\"note\":\"art. 199 novovicies IV bis CGI — ancien with works (≥25%), 12/18/21% by engagement, cap 300000 EUR\"},\"malraux\":{\"depenses_cents\":" + str(g_malraux) + ",\"zone\":\"" + malraux_zone + "\",\"rate_pct\":" + pct_str(malraux_rate) + ",\"reduction_cents\":" + str(malraux_reduction) + ",\"note\":\"art. 199 tervicies CGI — 30% PSMV / 22% PVAP, cap 400000 EUR, hors plafonnement niches\"},\"emploi_domicile\":{\"depenses_cents\":" + str(g_emploi) + ",\"base_cents\":" + str(ed_base) + ",\"credit_cents\":" + str(emploi_credit) + ",\"note\":\"art. 199 sexdecies CGI — 50% crédit, cap 12000 EUR (refundable if > IR)\"}}"
    out = out + ",\"crypto\":{\"net_cents\":" + str(g_crypto) + ",\"net_eur\":\"" + fmt_cents(g_crypto) + "\",\"exempt\":" + json(crypto_exempt == 1) + ",\"threshold_cents\":" + str(thr) + "}"
    out = out + ",\"capital\":{\"taxable_cents\":" + str(taxable) + ",\"taxable_eur\":\"" + fmt_cents(taxable) + "\",\"tax_cents\":" + str(cap_tax) + ",\"tax_eur\":\"" + fmt_cents(cap_tax) + "\"}"
    out = out + ",\"dividends\":{\"gross_cents\":" + str(g_div) + ",\"tax_cents\":" + str(div_tax) + "}"
    out = out + ",\"totals\":{\"ir_cents\":" + str(ir_after_credit) + ",\"ir_eur\":\"" + fmt_cents(ir_after_credit) + "\",\"flat_tax_cents\":" + str(cap_tax+div_tax) + ",\"flat_tax_eur\":\"" + fmt_cents(cap_tax+div_tax) + "\",\"social_cents\":" + str(soc_bnc+soc_bic+soc_fon) + ",\"social_eur\":\"" + fmt_cents(soc_bnc+soc_bic+soc_fon) + "\",\"total_tax_cents\":" + str(ir_after_credit+cap_tax+div_tax+soc_bnc+soc_bic+soc_fon) + ",\"total_tax_eur\":\"" + fmt_cents(ir_after_credit+cap_tax+div_tax+soc_bnc+soc_bic+soc_fon) + "\"}"
    out = out + ",\"notes\":[\"estimates on the seeded rate card (2025 barème on 2024 income) — override with bilan rule set\",\"IR = progressive barème + plafonnement QF (situation-aware: default 1791/demi-part, parent_isole 4262 total, veuf 1807/demi-part+2011, personne_seule_invalide 3608) + décote; 10% frais per salary stream; BNC/BIC deficits 6y; foncier deficit 10700 EUR on global + 10y on foncier (micro + réel)\",\"dons reduction (art. 200 CGI): 75% to 1000 EUR, 66% to 20% of revenu imposable — reduces IR\",\"pinel/denormandie reduction (art. 199 novovicies): 12/18/21% by engagement, cap 300000 EUR, spread over years — reduces IR\",\"malraux reduction (art. 199 tervicies): 30% PSMV / 22% PVAP, cap 400000 EUR, hors plafonnement niches — reduces IR\",\"emploi à domicile (art. 199 sexdecies): 50% crédit, cap 12000 EUR — refundable (crédit, not réduction)\",\"TVA franchise en base (art. 293 B): services 36800 / vente 91900 EUR — informational\",\"PAS taux neutre + personnalisé (art. 204 H): monthly estimate for provisioning — v1 simplification of the BOFiP formula\",\"régime réel foncier (art. 29-31): net = loyer - charges (intérêts d'emprunt, travaux), no abattement — combined with micro-foncier\",\"micro-BNC/BIC/foncier cannot legally generate deficits (forfaitaire) — deficit carry-forward is a régime-réel feature applied to the micro base as a v1 simplification\",\"crypto exemption per form 2086: net gains under the threshold are not declarable\"]}"
    code = 0
    err = ""
}

// rule_list / rule_set — the rate card is data. list [--year Y]; set <year> <regime> <param> <value>.
func rule_list_json(db, year) (out, code, err) {
    where := ""
    params := []string{}
    if year != "" { where = "year=CAST(? AS INTEGER)"  params = append(params, year) }
    sql := "SELECT year, regime, param, value FROM tax_rules"
    if where != "" { sql = sql + " WHERE " + where }
    sql = sql + " ORDER BY year, regime, param"
    rows := sqlite_query(db, sql, params)
    out = "{\"ok\":true,\"rules\":" + rows + "}"
    code = 0
    err = ""
}

func rule_set(db, year, regime, param, value) (out, code, err) {
    if parse_cents_ok(year) == 0 { return "", 80, "bad year: " + year }
    sqlite_exec(db, "INSERT INTO tax_rules(year,regime,param,value) VALUES(?,?,?,?) ON CONFLICT(year,regime,param) DO UPDATE SET value=excluded.value", []string{year, regime, param, value})
    out = "{\"ok\":true,\"year\":" + year + ",\"regime\":\"" + esc(regime) + "\",\"param\":\"" + esc(param) + "\",\"value\":\"" + esc(value) + "\"}"
    code = 0
    err = ""
}
