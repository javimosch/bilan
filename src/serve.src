// serve — the HTTP JSON API over the same domain cores the CLI uses. Binds all
// interfaces (machin's listen() has no bind-address arg), so per cli-daemon-spec
// every /v1/* route and /_shutdown are token-gated; /_health, /guide, /llms.txt
// stay open. The token comes from BILAN_TOKEN or is generated + printed on stderr.

func cmd_serve(a) {
    port := 8791
    p := env("BILAN_PORT")
    if p != "" { port = parse_int(p) }
    pv := flagv(a, "--port", "")
    if pv != "" { port = parse_int(pv) }
    token := env("BILAN_TOKEN")
    if token == "" { token = to_hex(rand_bytes(16)) }
    write(2, "{\"event\":\"serve_token\",\"token\":\"" + token + "\",\"note\":\"set BILAN_TOKEN to pin it\"}\n")
    say("{\"ok\":true,\"serving\":\"bilan\",\"port\":" + str(port) + ",\"open\":[\"GET /_health\",\"GET /guide\",\"GET /llms.txt\"],\"gated\":[\"/v1/*\",\"POST /_shutdown\"]}")
    serve(port, func(req) {
        p := path_only(req.path)
        if p == "/" && req.method == "GET" { return ok_html(landing_html()) }
        if p == "/_health" { return ok_json("{\"ok\":true,\"service\":\"bilan\",\"version\":\"" + version_str() + "\"}") }
        if req.method == "GET" && p == "/guide" { return ok_text(guide_text("")) }
        if req.method == "GET" && p == "/llms.txt" { return ok_text(llms_txt()) }
        if p == "/_shutdown" {
            if auth_ok(req, token) == 0 { return unauthorized() }
            write(2, "{\"event\":\"shutdown\"}\n")
            go shutdown_soon()
            return ok_json("{\"ok\":true,\"shutdown\":true}")
        }
        if p == "/app" && req.method == "GET" {
            if env("BILAN_HOSTED") == "1" {
                val, sok := get_session(req, token, "bilan_s")
                if sok == 0 { return ok_html(login_html()) }
                ws_d := tenant_ws_by_token(val)
                if ws_d == "" { return ok_html(login_html()) }
                return ok_html(dash_html(open_db_at(ws_d), str(current_year())))
            }
            return ok_html(dash_html(opendb(), str(current_year())))
        }
        if p == "/app/login" && req.method == "POST" {
            tok_l := form_field(req.body, "token")
            ws_l := tenant_ws_by_token(tok_l)
            if ws_l == "" { return ok_html(login_html()) }
            return set_session(redirect("/app"), token, "bilan_s", tok_l)
        }
if p == "/app/move" && req.method == "POST" {
            mid := form_field(req.body, "id")
            mst := form_field(req.body, "status")
            if env("BILAN_HOSTED") == "1" {
                val_m, mok := get_session(req, token, "bilan_s")
                if mok == 0 { return unauthorized() }
                ws_m := tenant_ws_by_token(val_m)
                if ws_m == "" { return unauthorized() }
                mdb := open_db_at(ws_m)
                out_m, code_m, err_m := move_close(mdb, mid, mst)
                sqlite_close(mdb)
                if err_m != "" { return err_res(code_m, err_m) }
                return redirect("/app")
            }
            mdb := opendb()
            out_m, code_m, err_m := move_close(mdb, mid, mst)
            sqlite_close(mdb)
            if err_m != "" { return err_res(code_m, err_m) }
            return redirect("/app")
        }
        if has_prefix(p, "/v1/") {
            if env("BILAN_HOSTED") == "1" {
                // hosted: the bearer IS the tenant; gift calls free, then 1 peage cent/call
                return hosted_handle(req)
            }
            if auth_ok(req, token) == 0 { return unauthorized() }
            return api(req, dbpath())
        }
        return not_found()
    })
}

// tenant_ws_by_token — the workspace path for a tenant token, provisioning on first
// sight (same rule as the API: a fresh bearer is a fresh tenant with its gift).
func tenant_ws_by_token(tok) (ws) {
    ws = ""
    if tok == "" { return ws }
    cdb := hosted_control_db()
    ws, _used := tenant_ensure(cdb, tok)
    sqlite_close(cdb)
}

// form_field — the value of name in an application/x-www-form-urlencoded body.
func form_field(body, name) (v) {
    v = ""
    i := 0
    parts := split(body, "&")
    for i < len(parts) {
        eq := index(parts[i], "=")
        if eq > 0 {
            if substr(parts[i], 0, eq) == name { v = url_decode(substr(parts[i], eq+1, len(parts[i]))) }
        }
        i = i + 1
    }
}

// redirect_to — a 303 See Other to url, preserving any headers already set on res
// (set_session adds the cookie on the response it returns).
func redirect_to(res, url) (r) {
    r = with_header(redirect(url), "set-cookie", cookie_lines(res))
}

// path_only — req.path is the full request-URI (machweb keeps the ?query on it);
// routes match on the path part only.
func path_only(p) (o) {
    o = p
    qi := index(p, "?")
    if qi >= 0 { o = substr(p, 0, qi) }
}

// shutdown_soon — give the HTTP response a beat to flush, then exit the process.
func shutdown_soon() {
    sleep(100)
    exit(0)
}

// auth_ok — Bearer token check (constant-enough for v0; the token is high-entropy).
func auth_ok(req, token) (ok) {
    ok = 0
    h := header(req, "authorization")
    want := "Bearer " + token
    if h == want { ok = 1 }
}

func unauthorized() (r) {
    r = response("401 Unauthorized", "application/json", "{\"ok\":false,\"error\":\"unauthorized — pass 'Authorization: Bearer <BILAN_TOKEN>'\"}")
}

func llms_txt() (t) {
    t = "# bilan\n\n" +
        "Agent-first financial ledger + tax radar for professionnels pluri-actifs.\n" +
        "No LLM inside by design: bilan stores and computes; your agent reasons.\n" +
        "\n" +
        "## Cold start (60 seconds)\n" +
        "1. install: curl -fsSL https://raw.githubusercontent.com/javimosch/bilan/master/install.sh | sh\n" +
        "2. learn: bilan guide (the full operator reference, also GET /guide)\n" +
        "3. catalog: bilan help-json (19 commands, exit codes 0/80s/93/94/100/110)\n" +
        "4. per-command: bilan help <cmd> or bilan <cmd> --help (never runs the command)\n" +
        "5. demo data: bilan demo (deterministic salary+bnc+crypto+rent ledger, idempotent)\n" +
        "6. the radar: bilan stats --year 2026 && bilan tax --year 2026\n" +
