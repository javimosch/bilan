// serve — the HTTP JSON API over the same domain cores the CLI uses. Binds all
// interfaces (machin's listen() has no bind-address arg), so per cli-daemon-spec
// every /v1/* route and /_shutdown are token-gated; /_health, /guide, /llms.txt
// stay open. The token comes from BILAN_TOKEN or is generated + printed on stderr.

func cmd_serve(a) {
    port := 8791
    p := env("BILAN_PORT")
    if p != "" { port = parse_int(p) }
    pv := flagv(a, "--port", "")
    if pv != "" { port = parse_int(pv) }
    token := env("BILAN_TOKEN")
    if token == "" { token = to_hex(rand_bytes(16)) }
    write(2, "{\"event\":\"serve_token\",\"token\":\"" + token + "\",\"note\":\"set BILAN_TOKEN to pin it\"}\n")
    say("{\"ok\":true,\"serving\":\"bilan\",\"port\":" + str(port) + ",\"open\":[\"GET /_health\",\"GET /guide\",\"GET /llms.txt\"],\"gated\":[\"/v1/*\",\"POST /_shutdown\"]}")
    serve(port, func(req) {
        p := path_only(req.path)
        if p == "/" && req.method == "GET" { return ok_html(landing_html()) }
        if p == "/_health" { return ok_json("{\"ok\":true,\"service\":\"bilan\",\"version\":\"" + version_str() + "\"}") }
        if req.method == "GET" && p == "/guide" { return ok_text(guide_text("")) }
        if req.method == "GET" && p == "/llms.txt" { return ok_text(llms_txt()) }
        if p == "/_shutdown" {
            if auth_ok(req, token) == 0 { return unauthorized() }
            write(2, "{\"event\":\"shutdown\"}\n")
            go shutdown_soon()
            return ok_json("{\"ok\":true,\"shutdown\":true}")
        }
        if p == "/app" && req.method == "GET" {
            if env("BILAN_HOSTED") == "1" {
                val, sok := get_session(req, token, "bilan_s")
                if sok == 0 { return ok_html(login_html()) }
                ws_d := tenant_ws_by_token(val)
                if ws_d == "" { return ok_html(login_html()) }
                return ok_html(dash_html(open_db_at(ws_d), str(current_year())))
            }
            return ok_html(dash_html(opendb(), str(current_year())))
        }
        if p == "/app/login" && req.method == "POST" {
            tok_l := form_field(req.body, "token")
            ws_l := tenant_ws_by_token(tok_l)
            if ws_l == "" { return ok_html(login_html()) }
            return set_session(redirect("/app"), token, "bilan_s", tok_l)
        }
if p == "/app/move" && req.method == "POST" {
            mid := form_field(req.body, "id")
            mst := form_field(req.body, "status")
            if env("BILAN_HOSTED") == "1" {
                val_m, mok := get_session(req, token, "bilan_s")
                if mok == 0 { return unauthorized() }
                ws_m := tenant_ws_by_token(val_m)
                if ws_m == "" { return unauthorized() }
                mdb := open_db_at(ws_m)
                out_m, code_m, err_m := move_close(mdb, mid, mst)
                sqlite_close(mdb)
                if err_m != "" { return err_res(code_m, err_m) }
                return redirect("/app")
            }
            mdb := opendb()
            out_m, code_m, err_m := move_close(mdb, mid, mst)
            sqlite_close(mdb)
            if err_m != "" { return err_res(code_m, err_m) }
            return redirect("/app")
        }
        if has_prefix(p, "/v1/") {
            if env("BILAN_HOSTED") == "1" {
                // hosted: the bearer IS the tenant; gift calls free, then 1 peage cent/call
                return hosted_handle(req)
            }
            if auth_ok(req, token) == 0 { return unauthorized() }
            return api(req, dbpath())
        }
        return not_found()
    })
}

// tenant_ws_by_token — the workspace path for a tenant token, provisioning on first
// sight (same rule as the API: a fresh bearer is a fresh tenant with its gift).
func tenant_ws_by_token(tok) (ws) {
    ws = ""
    if tok == "" { return ws }
    cdb := hosted_control_db()
    ws, _used := tenant_ensure(cdb, tok)
    sqlite_close(cdb)
}

// form_field — the value of name in an application/x-www-form-urlencoded body.
func form_field(body, name) (v) {
    v = ""
    i := 0
    parts := split(body, "&")
    for i < len(parts) {
        eq := index(parts[i], "=")
        if eq > 0 {
            if substr(parts[i], 0, eq) == name { v = url_decode(substr(parts[i], eq+1, len(parts[i]))) }
        }
        i = i + 1
    }
}

// redirect_to — a 303 See Other to url, preserving any headers already set on res
// (set_session adds the cookie on the response it returns).
func redirect_to(res, url) (r) {
    r = with_header(redirect(url), "set-cookie", cookie_lines(res))
}

// path_only — req.path is the full request-URI (machweb keeps the ?query on it);
// routes match on the path part only.
func path_only(p) (o) {
    o = p
    qi := index(p, "?")
    if qi >= 0 { o = substr(p, 0, qi) }
}

// shutdown_soon — give the HTTP response a beat to flush, then exit the process.
func shutdown_soon() {
    sleep(100)
    exit(0)
}

// auth_ok — Bearer token check (constant-enough for v0; the token is high-entropy).
func auth_ok(req, token) (ok) {
    ok = 0
    h := header(req, "authorization")
    want := "Bearer " + token
    if h == want { ok = 1 }
}

func unauthorized() (r) {
    r = response("401 Unauthorized", "application/json", "{\"ok\":false,\"error\":\"unauthorized — pass 'Authorization: Bearer <BILAN_TOKEN>'\"}")
}

func llms_txt() (t) {
    t = "# bilan\n\n" +
        "Agent-first financial ledger + tax radar for professionnels pluri-actifs.\n" +
        "No LLM inside by design: bilan stores and computes; your agent reasons.\n" +
        "\n" +
        "## Cold start (60 seconds)\n" +
        "1. install: curl -fsSL https://raw.githubusercontent.com/javimosch/bilan/master/install.sh | sh\n" +
        "2. learn: bilan guide (the full operator reference, also GET /guide)\n" +
        "3. catalog: bilan help-json (18 commands, exit codes 0/80s/93/94/100/110)\n" +
        "4. per-command: bilan help <cmd> or bilan <cmd> --help (never runs the command)\n" +
        "5. demo data: bilan demo (deterministic salary+bnc+crypto+rent ledger, idempotent)\n" +
        "6. the radar: bilan stats --year 2026 && bilan tax --year 2026\n" +
        "\n" +
        "## The copilote loop (Brian)\n" +
        "bilan ships a persona: `bilan brian` prints it — install into your harness\n" +
        "(CLAUDE.md / AGENTS.md / system prompt) and you become the financial copilote.\n" +
        "Rules it installs: never invent a number (only bilan output), max 3 moves/day,\n" +
        "each Action + Pourquoi + Impact, French, not an advisor.\n" +
        "  bilan brief  -> the morning digest: tax provision, stream momentum, pending moves\n" +
        "  bilan move add --kind controle|securite|construction|patrimoine --action A --pourquoi P --impact I\n" +
        "  the human approves on GET /app (hosted: paste token once at /app/login)\n" +
        "\n" +
        "- Full operator reference: GET /guide (or run `bilan guide`)\n" +
        "- Command catalog: `bilan help-json`\n" +
        "- Output contract: stdout=JSON data, stderr=errors, exit 0/80s/90s/100s/110s\n" +
        "- Endpoints: /v1/streams, /v1/tx, /v1/import, /v1/stats, /v1/tax, /v1/brief,\n" +
        "  /v1/moves (Bearer token; 50 gift calls per tenant, then 1 peage cent/call)\n"
}

// api — the /v1/* router. GETs render the same JSON the CLI prints; POSTs parse a
// small JSON body. Errors come back as 400/404 with {"ok":false,"error":...}.
// (MFL vars are function-scoped: every branch gets its own names.)
func api(req, db_path) (res) {
    db := open_db_at(db_path)
    p := path_only(req.path)
    if p == "/v1/streams" && req.method == "GET" {
        res = ok_json(stream_list_json(db))
        sqlite_close(db)
        return res
    }
    if p == "/v1/streams" && req.method == "POST" {
        body_s := parse(req.body, StreamIn{})
        out_s, code_s, err_s := stream_add(db, body_s.name, body_s.kind, body_s.currency)
        sqlite_close(db)
        if err_s != "" { return err_res(code_s, err_s) }
        res = created(out_s)
        return res
    }
    if p == "/v1/tx" && req.method == "GET" {
        out_l, code_l, err_l := tx_list_json(db, query(req, "stream"), query(req, "year"), query(req, "limit"))
        sqlite_close(db)
        if err_l != "" { return err_res(code_l, err_l) }
        res = ok_json(out_l)
        return res
    }
    if p == "/v1/tx" && req.method == "POST" {
        body_t := parse(req.body, TxIn{})
        out_t, code_t, err_t := tx_add(db, body_t.stream, body_t.date, body_t.amount, body_t.label, "api", "")
        sqlite_close(db)
        if err_t != "" { return err_res(code_t, err_t) }
        res = created(out_t)
        return res
    }
    if p == "/v1/import" && req.method == "POST" {
        body_i := parse(req.body, ImportIn{})
        out_i, code_i, err_i := import_csv(db, body_i.source, body_i.csv, body_i.stream)
        sqlite_close(db)
        if err_i != "" { return err_res(code_i, err_i) }
        res = ok_json(out_i)
        return res
    }
    if p == "/v1/stats" {
        year_a := query(req, "year")
        if year_a == "" { year_a = str(current_year()) }
        out_a, code_a, err_a := stats_json(db, year_a)
        sqlite_close(db)
        if err_a != "" { return err_res(code_a, err_a) }
        res = ok_json(out_a)
        return res
    }
    if p == "/v1/tax" {
        year_x := query(req, "year")
        if year_x == "" { year_x = str(current_year()) }
        out_x, code_x, err_x := tax_json(db, year_x)
        sqlite_close(db)
        if err_x != "" { return err_res(code_x, err_x) }
        res = ok_json(out_x)
        return res
    }
    if p == "/v1/rules" && req.method == "GET" {
        year := query(req, "year")
        out_r, code_r, err_r := rule_list_json(db, year)
        sqlite_close(db)
        if err_r != "" { return err_res(code_r, err_r) }
        res = ok_json(out_r)
        return res
    }
    if p == "/v1/brief" {
        year_b := query(req, "year")
        if year_b == "" { year_b = str(current_year()) }
        out_b, code_b, err_b := brief_json(db, year_b)
        sqlite_close(db)
        if err_b != "" { return err_res(code_b, err_b) }
        res = ok_json(out_b)
        return res
    }
    if p == "/v1/moves" && req.method == "GET" {
        rows_v := sqlite_query(db, "SELECT id, kind, action, pourquoi, impact, horizon, status FROM moves ORDER BY created DESC LIMIT 50", []string{})
        sqlite_close(db)
        res = ok_json("{\"ok\":true,\"moves\":" + rows_v + "}")
        return res
    }
    if p == "/v1/moves" && req.method == "POST" {
        body_m := parse(req.body, MoveIn{})
        if body_m.close_id != "" {
            out_c, code_c, err_c := move_close(db, body_m.close_id, body_m.close_status)
            sqlite_close(db)
            if err_c != "" { return err_res(code_c, err_c) }
            res = ok_json(out_c)
            return res
        }
        out_a, code_a, err_a := move_add(db, body_m.kind, body_m.action, body_m.pourquoi, body_m.impact, body_m.horizon)
        sqlite_close(db)
        if err_a != "" { return err_res(code_a, err_a) }
        res = created(out_a)
        return res
    }
    if p == "/v1/rules" && req.method == "POST" {
        body_r := parse(req.body, RuleIn{})
        out_s, code_s, err_s := rule_set(db, body_r.year, body_r.regime, body_r.param, body_r.value)
        sqlite_close(db)
        if err_s != "" { return err_res(code_s, err_s) }
        res = ok_json(out_s)
        return res
    }
    sqlite_close(db)
    res = not_found()
}

func err_res(code, msg) (r) {
    status := "400 Bad Request"
    if code == 94 { status = "404 Not Found" }
    if code == 93 { status = "409 Conflict" }
    r = response(status, "application/json", "{\"ok\":false,\"error\":\"" + esc(err_msg_sanitize(msg)) + "\"}")
}

func err_msg_sanitize(msg) (m) { m = msg }

type StreamIn struct { name string  kind string  currency string }
type TxIn struct { stream string  date string  amount string  label string }
type ImportIn struct { source string  csv string  stream string }
type RuleIn struct { year string  regime string  param string  value string }
type MoveIn struct { kind string  action string  pourquoi string  impact string  horizon string  close_id string  close_status string }
